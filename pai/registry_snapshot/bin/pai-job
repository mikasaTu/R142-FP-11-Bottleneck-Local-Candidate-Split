        "EXPECTED_PYTHON_SHA256=903441582909636b4316667ee22beb1e6e2726991584ea9265c765ac8388abd1",
        "EXPECTED_DATASET_SHA256=36b4e1bced49d2f4ff6b2fce6b1596a63978e14199e2513cd0df71e127bf47a6",
        "EXPECTED_BDDL_SHA256=26f22f8ad39a4b2b344b049115c45661a877fa0b4821fb78246725e7e87d8c0b",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        "rev-parse 'stage-d1-formal-source-v3^{commit}'",
        "if env | grep -q '^WANDB_'; then",
        '"candidate_response_rows": 184560',
        '"closed_loop_episodes": 540',
