def validate_r16p18_maniskill_act_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P18 ManiSkill ACT evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R16-P18 ManiSkill ACT submission/fault contract is missing")
    evidence_kind = evidence.get("kind")
    if evidence_kind not in (
        R16P18_MANISKILL_ACT_EVIDENCE_KIND,
        R16P18_MANISKILL_ACT_EVAL_EVIDENCE_KIND,
        R16P18_MANISKILL_ORACLE_EVIDENCE_KIND,
    ):
        raise Refused("R16-P18 ManiSkill ACT evidence kind is not authorized")
    is_evaluation = evidence_kind == R16P18_MANISKILL_ACT_EVAL_EVIDENCE_KIND
    is_oracle = evidence_kind == R16P18_MANISKILL_ORACLE_EVIDENCE_KIND
    expected_source_commit = (
        R16P18_MANISKILL_ACT_SOURCE_COMMIT
        if evidence_kind == R16P18_MANISKILL_ACT_EVIDENCE_KIND
        else R16P18_MANISKILL_EVAL_SOURCE_COMMIT
    )
    expected_source_tree = (
        R16P18_MANISKILL_ACT_SOURCE_TREE
        if evidence_kind == R16P18_MANISKILL_ACT_EVIDENCE_KIND
        else R16P18_MANISKILL_EVAL_SOURCE_TREE
    )
    if resolved.get("resource_alias") != R16P18_MANISKILL_ACT_RESOURCE_ALIAS:
        raise Refused("R16-P18 ManiSkill ACT requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P18 ManiSkill ACT network must remain empty")
