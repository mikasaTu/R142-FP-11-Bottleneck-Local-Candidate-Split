    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-evaluation",
        "task": "r16p14-libero-stage1-oracle-prefix-20260812",
        "model": "state-observation-chunk-bc-mlp-h16",
        "dataset": "libero-goal-three-task-locked",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
