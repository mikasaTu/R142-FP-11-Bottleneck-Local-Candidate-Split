                "41958443011fed98b73ce6ced8124b2c808b4918949fa3779b47aa75b89f7d11"
            ),
            "environment_lock_sha256": (
                "876128f51accafc37f993db4833e8d407e5d5e9a131d9fadbc37fcbed52989aa"
            ),
            "physx_gpu_library_lock_sha256": (
                "b15762342d8edb7066c1186c483a73c043ad1b74e6545747812e46d9e07c23df"
            ),
            "package_lock_sha256": (
                "29965e175cc262e8a4250d1f137d3c85c5c59e8612f530b99703bceef30cef59"
            ),
            "checkpoint_root": str(R16P18_MANISKILL_ACT_CHECKPOINT_ROOT),
            "baseline_gate": str(
                R16P18_MANISKILL_ACT_EVALUATION_ROOT / "baseline_gate.json"
            ),
            "state_bank_root": str(R16P18_MANISKILL_STATE_BANK_ROOT),
            "oracle_root": str(R16P18_MANISKILL_ORACLE_ROOT),
            "cache_run_root": str(cache_run_root),
            "short_horizon_sim_backend": "physx_cpu_serial_exact_restore",
            "rgb_render_backend": "sapien_cuda",
            "policy_inference_device": "cuda",
            "states_per_authorized_task": 64,
            "restore_repeats": 3,
            "action_candidates_per_state": 25,
            "visual_interventions_per_state": 48,
            "joint_combinations_per_state": 20,
            "policy_seeds": [16018, 16019, 16020],
            "candidate_tasks": [
                "PullCubeTool-v1",
                "PushT-v1",
                "StackCube-v1",
                "PushCube-v1",
            ],
            "active_task_rule": (
                "baseline_passing_positive_tasks_plus_PushCube-v1"
            ),
            "max_gpus": 2,
            "wandb_mode": "disabled_json_artifacts",
            "experiment_scope": (
                "stage2_privileged_oracle_necessary_condition_"
                "not_deployable_selector"
            ),
            "expected_first_work_uid": 2254,
            "expected_first_work_gid": 2254,
        }
    if evidence != expected_evidence:
        raise Refused("R16-P18 ManiSkill ACT exact evidence contract drifted")

    if is_oracle:
        expected_write_paths = [
            str(artifact_dir),
            str(R16P18_MANISKILL_STATE_BANK_ROOT),
            str(R16P18_MANISKILL_ORACLE_ROOT),
            str(cache_run_root),
        ]
    elif is_evaluation:
        expected_write_paths = [
            str(artifact_dir),
            str(R16P18_MANISKILL_ACT_CHECKPOINT_ROOT),
            str(R16P18_MANISKILL_ACT_EVALUATION_ROOT),
            str(cache_run_root),
        ]
    else:
        expected_write_paths = [
            str(artifact_dir),
            str(R16P18_MANISKILL_ACT_CHECKPOINT_ROOT),
            str(R16P18_MANISKILL_ACT_DATA_ROOT),
            str(cache_run_root),
        ]
    if write_paths != expected_write_paths:
        raise Refused("R16-P18 ManiSkill ACT write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R16-P18 ManiSkill ACT requires resumable application output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R16-P18 ManiSkill ACT forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R16-P18 ManiSkill ACT fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation" if (is_evaluation or is_oracle) else "formal-training",
        "task": "r16p18-maniskill-act-boundary-screen-v1",
        "model": (
            "official-maniskill3-rgb-act-frozen"
            if is_oracle
            else "official-maniskill3-rgb-act"
        ),
        "dataset": (
            "maniskill3-heldout-state-bank"
            if is_oracle
            else "maniskill3-four-task-300-demo-locked"
        ),
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": (
            "stage2-privileged-oracle-gate"
            if is_oracle
            else (
                "stage2-baseline-evaluation"
                if is_evaluation
                else "stage2-baseline-gate-screen"
            )
        ),
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R16-P18 ManiSkill ACT submission contract drifted")


def validate_r19p10_v3_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R19-P10 v3 evidence is missing")
    contract = R19P10_V3_PROFILE_CONTRACTS.get(str(evidence.get("kind", "")))
    if contract is None:
        raise Refused("R19-P10 v3 evidence kind is not authorized")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R19-P10 v3 submission/fault contract is missing")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R19-P10 v3 requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R19-P10 v3 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R19-P10 v3 worker must equal the verified 2-GPU preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != contract["output_root"]:
        raise Refused("R19-P10 v3 output root drifted")
    if artifact_dir.parent != contract["output_root"]:
        raise Refused("R19-P10 v3 artifact directory escaped the pinned output root")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R19-P10 v3 runtime fields drifted")
    if runtime.get("pod_env") != {} or normalize_secret_env_names(
        runtime.get("secret_env_names")
    ) != []:
        raise Refused("R19-P10 v3 requires an empty public/secret environment")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R19-P10 v3 requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R19-P10 v3 requires uid/gid 2254")

    launcher_path = contract["launcher"]
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R19-P10 v3 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R19-P10 v3 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != contract["launcher_sha256"]:
        raise Refused("R19-P10 v3 launcher hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R19-P10 v3 command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R19-P10 v3 command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R19-P10 v3 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R19-P10 v3 launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_SOURCE_COMMIT={contract['source_commit']}",
        f"EXPECTED_SOURCE_TREE={contract['source_tree']}",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R19-P10 v3 payload binding drifted: {fragment}")

    expected_writes = [str(artifact_dir)] + [
        str(path) for path in contract["write_paths"]
    ]
    if write_paths != expected_writes:
        raise Refused("R19-P10 v3 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R19-P10 v3 requires resumable application output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R19-P10 v3 forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R19-P10 v3 fault-tolerance contract drifted")
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": contract["tags"],
    }:
        raise Refused("R19-P10 v3 submission contract drifted")

    required_evidence = {
        "resource_contract": (
            "dedicated_2gpu_plus_gpu_free_cpu_worker_v1"
            if evidence.get("kind") == "r19p10_v3_phase_c_flowpolicy_dataset"
            else "dedicated_2gpu_v1"
        ),
        "workload_type": contract["workload_type"],
        "task_id": contract["task_id"],
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": contract["source_commit"],
        "source_tree": contract["source_tree"],
        "launcher_sha256": launcher_sha,
        "wandb_mode": "disabled_by_user_contract",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "browser_not_used": "fifo_not_applicable",
    }
    for key, value in required_evidence.items():
        if evidence.get(key) != value:
            raise Refused(f"R19-P10 v3 evidence field drifted: {key}")
    if evidence.get("first_work_evidence_path") != str(artifact_dir / "FIRST_WORK.json"):
        raise Refused("R19-P10 v3 first-work path drifted")
    if evidence.get("completed_evidence_path") != str(
        artifact_dir / contract["complete_name"]
    ):
        raise Refused("R19-P10 v3 completion path drifted")
    if contract["training"]:
        if evidence.get("application_autoresume") != (
            "latest atomically complete full model+optimizer+scheduler+rng state"
        ):
            raise Refused("R19-P10 v3 application autoresume contract drifted")
        if evidence.get("checkpoint_cadence_optimizer_steps") != 2500:
            raise Refused("R19-P10 v3 checkpoint cadence drifted")
        if evidence.get("complete_checkpoint_steps") != [2500, 5000, 7500]:
            raise Refused("R19-P10 v3 checkpoint milestones drifted")
    elif evidence.get("training_performed") is not False:
        raise Refused("R19-P10 v3 non-training profile drifted")
    if "flowpolicy_commit" in contract and evidence.get("flowpolicy_commit") != contract[
        "flowpolicy_commit"
    ]:
        raise Refused("R19-P10 v3 FlowPolicy commit drifted")


def validate_r21p019_libero_stagea_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R21-P019 LIBERO Stage-A evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R21-P019 LIBERO Stage-A submission/fault contract is missing")
    if evidence.get("kind") != R21P019_LIBERO_STAGEA_EVIDENCE_KIND:
        raise Refused("R21-P019 LIBERO Stage-A evidence kind is not authorized")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R21-P019 LIBERO Stage-A requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R21-P019 LIBERO Stage-A network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R21-P019 LIBERO Stage-A worker must equal the verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R21P019_LIBERO_STAGEA_OUTPUT_ROOT:
        raise Refused("R21-P019 LIBERO Stage-A output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R21-P019 LIBERO Stage-A runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R21-P019 LIBERO Stage-A public pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused("R21-P019 LIBERO Stage-A requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R21-P019 LIBERO Stage-A W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R21-P019 LIBERO Stage-A requires base64 payload transport")

    launcher_info = toolchain_config.get("r21p019_libero_stagea_launcher")
    if not isinstance(launcher_info, dict) or set(launcher_info) != {"file", "sha256"}:
        raise Refused("R21-P019 LIBERO Stage-A pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R21-P019 LIBERO Stage-A launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R21-P019 LIBERO Stage-A launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R21-P019 LIBERO Stage-A launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R21-P019 LIBERO Stage-A command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R21-P019 LIBERO Stage-A frozen payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R21-P019 LIBERO Stage-A launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_SOURCE_COMMIT={R21P019_LIBERO_STAGEA_SOURCE_COMMIT}",
        f"EXPECTED_SOURCE_TREE={R21P019_LIBERO_STAGEA_SOURCE_TREE}",
        "EXPECTED_R23_COMMIT=a02f1135dd876458633bb28e7cb987839fe7d744",
        f"CHECKPOINT_ROOT={R21P019_LIBERO_STAGEA_CHECKPOINT_ROOT}",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(
                f"R21-P019 LIBERO Stage-A payload binding drifted: {fragment}"
            )

    expected_evidence = {
        "kind": R21P019_LIBERO_STAGEA_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "training_and_rollout_evaluation",
        "task_id": "r21p019-libero-stagea-oracle-20260813",
        "model_id": "tiny-attention-bc-patch16-h12",
        "success_gate": (
            "persisted_first_step_loss_then_completed_same_state_and_closed_loop_evaluation"
        ),
        "validation_method": (
            "static+cpu_data_cache+local_single_a800_forward_backward_smoke"
        ),
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "TRAINING_FIRST_STEP.json"),
        "first_branch_evidence_path": str(
            artifact_dir / "EVALUATION_FIRST_BRANCH.json"
        ),
        "completed_evidence_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R21P019_LIBERO_STAGEA_SOURCE_COMMIT,
        "source_tree": R21P019_LIBERO_STAGEA_SOURCE_TREE,
        "exact_state_dependency_commit": "a02f1135dd876458633bb28e7cb987839fe7d744",
        "exact_state_dependency_tree": "26329180e13f86138b12e267336fd16d6e3ecbaa",
        "launcher_sha256": launcher_sha,
        "run_formal_sha256": "e584984fe2b27f90e47b86cfef12bf4ff0a8f4a956b33c388a157ce26e62ca61",
        "libero_config_sha256": "07a9e074c666ff1bb621e01f3319da0d30fa92569a86f06decaf68728eccd77a",
        "python_sha256": "903441582909636b4316667ee22beb1e6e2726991584ea9265c765ac8388abd1",
        "dataset_sha256": "36b4e1bced49d2f4ff6b2fce6b1596a63978e14199e2513cd0df71e127bf47a6",
        "dataset_size_bytes": 762855139,
        "bddl_sha256": "26f22f8ad39a4b2b344b049115c45661a877fa0b4821fb78246725e7e87d8c0b",
        "checkpoint_root": str(R21P019_LIBERO_STAGEA_CHECKPOINT_ROOT),
        "checkpoint_cadence_steps": 500,
        "complete_state_resume": True,
        "retention_contract": (
            "all_10000_milestones_plus_latest_3_complete_nonmilestones_fail_closed"
        ),
        "retention_selftest_path": str(
            artifact_dir / "checkpoint_retention_selftest.json"
        ),
        "branch_reset_contract": (
            "reset_mjdata_restore_demo_model_anchor_osc_gripper_zero"
        ),
        "branch_determinism_gate": "utility_and_goal_distance_1e-10",
        "branch_determinism_evidence_path": str(
            artifact_dir / "branch_determinism_check.json"
        ),
        "suite": "libero_goal",
        "task": "push_the_plate_to_the_front_of_the_stove",
        "train_demos": [0, 29],
        "validation_demos": [30, 34],
        "calibration_demos": [35, 39],
        "test_demos": [40, 49],
        "actor_steps": 4000,
        "actor_batch_size": 64,
        "image_size": 128,
        "patch_size": 16,
        "patch_count": 64,
        "action_horizon": 12,
        "physical_effect_horizon": 8,
        "spurious_family": "end_effector_position_top_border_code",
        "train_id_mapping_probability": 0.9,
        "reversed_mapping_probability": 0.1,
        "eta_grid": [0.1, 0.2, 0.3],
        "calibration_snapshot_count": 10,
        "test_snapshot_count": 20,
        "closed_loop_episode_count": 24,
        "oracle_score_is_label": True,
        "seed_count": 1,
        "learned_effect_head": False,
        "full_go_allowed": False,
        "protocol_amendment": "user_authorized_pusht_to_libero_switch",
        "original_step1_libero_prohibition": True,
        "world_model_trained": False,
        "pi05_used": False,
        "accepted": False,
        "html_built": False,
        "wandb_mode": "online_exact_entity_resume_same_lineage",
        "experiment_scope": "oracle_mechanism_screen_only_not_full_stagea_go",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R21-P019 LIBERO Stage-A exact evidence contract drifted")
    if write_paths != [str(artifact_dir), str(R21P019_LIBERO_STAGEA_CHECKPOINT_ROOT)]:
        raise Refused("R21-P019 LIBERO Stage-A write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R21-P019 LIBERO Stage-A requires resumable application output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R21-P019 LIBERO Stage-A forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R21-P019 LIBERO Stage-A fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-evaluation",
