    if resolved.get("network") != {}:
        raise Refused("R10P25 Step7 prospective outcomes network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10P25 Step7 prospective outcomes worker preset drifted")
    output_root = USER_ROOT / "logs" / "r10p25-step7-drcm-v1" / "pai-prospective-outcomes"
    formal_root = USER_ROOT / "logs" / "r10p25-step7-drcm-v1" / "formal-prospective-outcomes-v1"
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(str(storage.get("output_root", ""))) != output_root:
        raise Refused("R10P25 Step7 prospective outcomes output root drifted")
    if artifact_dir != output_root / str(resolved.get("run_id")):
        raise Refused("R10P25 Step7 prospective outcomes artifact directory drifted")
    if write_paths != [str(artifact_dir), str(formal_root)]:
        raise Refused("R10P25 Step7 prospective outcomes write paths drifted")
    if output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("R10P25 Step7 prospective outcomes require fresh output_mode=new")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R10P25 Step7 prospective outcomes forbid recursive ownership repair")
    if runtime.get("pod_env") != {}:
        raise Refused("R10P25 Step7 prospective outcomes pod_env must remain empty")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10P25 Step7 prospective outcomes require base64 payload transport")

    expected_launcher = ROOT / "launchers" / "r10p25_step7_drcm_prospective_outcomes_2xa800.sh"
    try:
        canonical_launcher = expected_launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R10P25 Step7 prospective outcomes launcher is missing: {exc}") from exc
    if (
        canonical_launcher != expected_launcher
        or expected_launcher.is_symlink()
        or not expected_launcher.is_file()
        or not os.access(expected_launcher, os.X_OK)
    ):
        raise Refused("R10P25 Step7 prospective outcomes launcher is not canonical/executable")
    launcher_sha = sha256(expected_launcher)
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("R10P25 Step7 prospective outcomes command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R10P25 Step7 prospective outcomes payload drifted")
    payload_text = payload.decode("utf-8")
    bindings = {
        "source_commit": "d7a10bfaadeb13822cbf3462213f39747f320866",
        "source_tree": "afd8398e755930cfca9efc95b65b9a6e7323dc74",
        "formal_launcher_sha256": "ca3fa03f022302fecae2cf8f7fdb6a94f8794ebd0842de8980788ad5d931c920",
        "registry_launcher_sha256": "3c4e2fa295731d9af490c999587269263a6d3d5b015a56dae2b2d0e4124d1ab9",
        "prospective_freeze_sha256": "7d1c509b39afe4e8bf3ae9f9ecec0056174bdcffe4bac671d4b8e0998ee278cb",
        "candidate_manifest_sha256": "61d38c16374447962207fd359e62d9b75adb25b5ea62d4218d393e75a7bf3c7a",
        "candidate_tensor_file_sha256": "ac79acc0fc6dfc454aefd56bf6e7651765bf95cf2847c9117aef47e94c3b4383",
    }
    for label, fragment in bindings.items():
        payload_bound = label == "registry_launcher_sha256" or fragment in payload_text
        if evidence.get(label) != fragment or not payload_bound:
            raise Refused(f"R10P25 Step7 prospective outcomes {label} binding drifted")
    expected_scalars = {
        "resource_contract": "dedicated_exp_robot_2gpu_v1",
        "outcomes_generated_after_freeze": True,
        "canonical_execution_once_per_frozen_candidate": True,
        "prospective_refit": False,
        "wandb_mode": "disabled_by_experiment_contract",
        "accepted": False,
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    for key, value in expected_scalars.items():
        if evidence.get(key) != value:
            raise Refused(f"R10P25 Step7 prospective outcomes evidence field drifted: {key}")
    if evidence.get("first_work_evidence_path") != str(artifact_dir / "runtime.log"):
        raise Refused("R10P25 Step7 prospective outcomes first-work path drifted")
    if evidence.get("completed_evidence_path") != str(artifact_dir / "RUN_COMPLETE.json"):
        raise Refused("R10P25 Step7 prospective outcomes completion path drifted")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R10P25 Step7 prospective outcomes fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-and-evaluation",
        "task": "r10p25-step7-drcm-prospective-outcomes-v1-20260818",
        "model": "frozen-dinowm-drcm",
        "dataset": "pusht-step7-frozen-top32-bank",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-robot",
        "experiment_role": "step7-prospective-post-freeze-simulator-outcomes",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R10P25 Step7 prospective outcomes submission contract drifted")


def validate_r146_fp15_iwp_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    project_root = (
        CODE_ROOT / "R146-FP-15-Intervention-Witness-Planning"
    )
    template_path = project_root / "pai/stage1-exp-efficiency-2gpu.json"
    launcher_path = (
        CODE_ROOT
        / "worktrees/r146-fp15-stage1-runtime/pai/run_stage1_formal.sh"
    )
    if resolved.get("source_template") != str(template_path):
        raise Refused("R146-FP-15 must use the exact pinned project template")
    if (
        template_path.is_symlink()
        or not template_path.is_file()
        or sha256(template_path) != R146_FP15_IWP_TEMPLATE_SHA256
    ):
        raise Refused("R146-FP-15 template hash drifted")
    if (
        launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
        or sha256(launcher_path) != R146_FP15_IWP_LAUNCHER_SHA256
    ):
        raise Refused("R146-FP-15 launcher hash or mode drifted")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R146-FP-15 requires the verified dedicated 2-GPU alias")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "gpu_type": "A800",
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker or resolved.get("network") != {}:
        raise Refused("R146-FP-15 worker/network contract drifted")
    output_root = USER_ROOT / "logs/R146-FP-15-IWP/stage1"
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != output_root:
        raise Refused("R146-FP-15 output root drifted")
    if artifact_dir != output_root / str(resolved.get("run_id")):
        raise Refused("R146-FP-15 artifact directory drifted")

    expected_runtime_fields = {
        "canary_nonce", "command", "command_file", "command_file_sha256",
        "create_artifact_dir", "gid", "identity_mechanism", "output_mode",
        "payload_base64", "payload_sha256", "payload_transport", "pod_env",
        "recursive_repair", "secret_env_names", "task_paths", "uid",
        "wandb_entity_contract", "wandb_run_contract", "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R146-FP-15 resolved runtime fields drifted")
    expected_pod_env = {
        "PAI_TASK_R146_EXPECTED_PROJECT_COMMIT": R146_FP15_IWP_PROJECT_COMMIT,
        "PAI_TASK_R146_EXPECTED_PROJECT_TREE": R146_FP15_IWP_PROJECT_TREE,
    }
    if runtime.get("pod_env") != expected_pod_env:
        raise Refused("R146-FP-15 project pin environment drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_GZIP_BASE64:
        raise Refused("R146-FP-15 requires gzip_base64 payload transport")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY", "WANDB_ENTITY",
    ]:
        raise Refused("R146-FP-15 requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R146-FP-15 W&B entity contract drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R146-FP-15 command_file is not the pinned launcher")
    if (
        runtime.get("command_file_sha256") != R146_FP15_IWP_LAUNCHER_SHA256
        or runtime.get("payload_sha256") != R146_FP15_IWP_LAUNCHER_SHA256
        or sha256_bytes(payload) != R146_FP15_IWP_LAUNCHER_SHA256
    ):
        raise Refused("R146-FP-15 frozen launcher payload drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R146-FP-15 launcher is not UTF-8") from exc
    for fragment in (
        "PAI_TASK_R146_EXPECTED_PROJECT_COMMIT",
        "PAI_TASK_R146_EXPECTED_PROJECT_TREE",
        "iwp.official_runtime:build_adapter",
        "METAWORLD_FOLLOWUP_REQUIRED.json",
        '"B0", "B1", "B2", "B3", "B4", "B5", "B6", "Oracle", "IWP"',
    ):
        if fragment not in payload_text:
            raise Refused(f"R146-FP-15 launcher binding missing: {fragment}")

    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict) or evidence.get("kind") != R146_FP15_IWP_EVIDENCE_KIND:
        raise Refused("R146-FP-15 evidence kind drifted")
    expected_evidence_fields = {
        "resource_contract": "dedicated_2gpu_v1",
        "resource_id": "quotakzri8a5wqcp",
        "oversold_type": "ForbiddenQuotaOverSold",
        "workload_type": "evaluation",
        "task_id": "r146-fp15-stage1-formal-20260823",
        "model_id": "r146-fp15-jepa-wm-and-dino-wm-fixed-bank",
        "success_gate": "persisted_complete_stage1_evaluation",
        "validation_method": "static_contract_plus_persisted_shard_validator",
        "contract_ready": True,
        "ready_for_submission": True,
        "target_commit": R146_FP15_IWP_PROJECT_COMMIT,
        "target_tree": R146_FP15_IWP_PROJECT_TREE,
        "launcher_sha256": R146_FP15_IWP_LAUNCHER_SHA256,
        "official_commit": "13cf1d9c7e476f53c17714d2e0f1dc239a883ce0",
        "official_tree": "23f381d7a8a934b006d7cdfc5620a8af29fd20a4",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    for key, expected_value in expected_evidence_fields.items():
        if evidence.get(key) != expected_value:
            raise Refused(f"R146-FP-15 evidence.{key} drifted")
    if evidence.get("first_work_evidence_path") != str(
        artifact_dir / "FIRST_WORK.json"
    ) or evidence.get("completed_evidence_path") != str(
        artifact_dir / "EVALUATION_COMPLETE.json"
    ):
        raise Refused("R146-FP-15 evidence paths drifted")
    evaluation = evidence.get("evaluation_contract")
    if not isinstance(evaluation, dict) or (
        evaluation.get("state_count"),
        evaluation.get("candidates_per_state"),
        evaluation.get("model_count"),
        evaluation.get("baseline_labels"),
        evaluation.get("robustness_epsilons"),
    ) != (
        120,
        64,
        2,
        ["B0", "B1", "B2", "B3", "B4", "B5", "B6", "Oracle", "IWP"],
        [0.05, 0.15],
    ):
        raise Refused("R146-FP-15 evaluation contract drifted")
    workload = evidence.get("workload_contract")
    for key, expected_value in {
        "formal_evaluation_only": True,
        "inference_only": True,
        "training": False,
        "checkpoint_writes": False,
        "autoresume": False,
        "resumable_evaluation_shards": True,
        "completion_requires_all_shards_and_outputs": True,
    }.items():
        if not isinstance(workload, dict) or workload.get(key) != expected_value:
            raise Refused(f"R146-FP-15 workload_contract.{key} drifted")
    if write_paths != [str(artifact_dir)]:
        raise Refused("R146-FP-15 write scope drifted")
    if (
        output_mode != "new"
        or runtime.get("create_artifact_dir") is not False
        or runtime.get("recursive_repair") is not False
    ):
        raise Refused("R146-FP-15 requires fresh controller-precreated output")
    if resolved.get("fault_tolerance") != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R146-FP-15 fault-tolerance contract drifted")


def validate_dinowm_pusht_official_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("DINO-WM PushT evaluation evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("DINO-WM PushT submission/fault contract is missing")
    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if resolved.get("controller_version") == CONTROLLER_VERSION:
        expected_runtime_fields.add("payload_transport")
    if set(runtime) != expected_runtime_fields:
        raise Refused("DINO-WM PushT runtime fields drifted")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("DINO-WM PushT evaluation requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("DINO-WM PushT network must be empty and source-derived")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused(
            "DINO-WM PushT worker must exactly equal the verified 2-GPU preset"
        )
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != DINO_WM_PUSHT_OUTPUT_ROOT:
        raise Refused("DINO-WM PushT output_root drifted from the fixed production root")

    tool_specs = {
        "launcher": (
            "dinowm_pusht_official_eval_launcher",
            "launcher_sha256",
        ),
        "cuda_entry_wrapper": (
            "dinowm_pusht_official_cuda_entry_wrapper",
            "cuda_entry_wrapper_sha256",
        ),
        "artifact_validator": (
            "dinowm_pusht_official_artifact_validator",
            "artifact_validator_sha256",
        ),
    }
    observed_tools: Dict[str, Tuple[Path, str]] = {}
    for role, (toolchain_key, evidence_field) in tool_specs.items():
        info = toolchain_config.get(toolchain_key)
        if not isinstance(info, dict) or set(info) != {"file", "sha256"}:
            raise Refused(f"DINO-WM toolchain entry {toolchain_key} drifted")
        relative = Path(str(info.get("file", "")))
        if relative.is_absolute() or ".." in relative.parts:
            raise Refused(f"DINO-WM toolchain path {toolchain_key} is unsafe")
        path = ROOT / relative
        try:
            canonical = path.resolve(strict=True)
        except OSError as exc:
            raise Refused(f"DINO-WM pinned tool is missing: {path}: {exc}") from exc
        if canonical != path or path.is_symlink() or not path.is_file():
            raise Refused(f"DINO-WM pinned tool is not canonical: {path}")
        observed_hash = sha256(path)
        if observed_hash != info.get("sha256"):
            raise Refused(f"DINO-WM pinned tool hash drifted: {role}")
        if evidence.get(evidence_field) != observed_hash:
            raise Refused(f"DINO-WM evidence does not bind the {role} hash")
        observed_tools[role] = (path, observed_hash)

    launcher_path, launcher_sha = observed_tools["launcher"]
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("DINO-WM command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("DINO-WM frozen payload is not the pinned launcher")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("DINO-WM decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("DINO-WM launcher payload must be UTF-8") from exc
    for role, variable in (
        ("cuda_entry_wrapper", "EXPECTED_ENTRY_SHA256"),
        ("artifact_validator", "EXPECTED_VALIDATOR_SHA256"),
    ):
        expected_line = f"{variable}={observed_tools[role][1]}"
        if payload_text.count(expected_line) != 1:
            raise Refused(f"DINO-WM launcher does not bind exact {role} hash")

    expected_task = "dinowm-pusht-official-dual-seed-eval-20260805"
    expected_model = "dinowm-pusht-official-latest-e909f0c"
    expected_evidence = {
        "kind": DINO_WM_PUSHT_OFFICIAL_EVAL_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "evaluation",
        "task_id": expected_task,
        "model_id": expected_model,
        "success_gate": "persisted_completed_evaluation_result",
        "validation_method": "static+dev14_cpu_contract",
        "validation_status": "passed_no_pai_gpu_execution",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            artifact_dir / "replicas" / "seed99" / "result.json"
        ),
        "completed_evidence_path": str(
            artifact_dir / "EVALUATION_COMPLETE.json"
        ),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": "0a9492fa12044b852ae9e001cc74604b79c8bb0c",
        "source_tree": "79f5c852d721ae99bfaec95c069acbf6bf87d51e",
        "frozen_source_tar_sha256": (
            "706fd4c82facb059ec97009a19efe6ab6bc396fb358b07ef9c358dd3464b856a"
        ),
        "frozen_source_manifest_sha256": (
            "238ba4ed559251dccd4791faad25b7ba38ccde9af13987442af26936494b90ac"
        ),
        "frozen_source_file_count": 190,
        "checkpoint_sha256": (
            "e909f0cec958fc0b49a79f2e85730ae6b5f83dee61a224705f91883eb3bb74c5"
        ),
        "checkpoint_hydra_sha256": (
            "e4d7f21b85c778ab8b83c0bb83bc7625fdfb193a6a0619fef25f4a2afd7f8049"
        ),
        "dataset_archive_sha256": (
            "442f5dee246edf670964ed7bdecd248683cd6d00580fa0e4d458abb53f92da08"
        ),
        "dataset_tree_manifest_sha256": (
            "a2ffa946d0a2d2a98da54b43cff5ed9cda3962e029c52017e5a111ac4c519921"
        ),
        "dataset_tree_file_count": 18718,
        "mujoco_tree_manifest_sha256": (
            "136c5687c2ab7b061986f16e1b33d9267df8ab03578bc23dd96bc3426caea4c9"
        ),
        "mujoco_tree_file_count": 52,
        "dinov2_source_commit": (
            "85a24602099d397264d5b30461ad7f3bfd726ca1"
        ),
        "dinov2_source_tree": (
            "d6c719f8fd5c50fd369d381a8710311f6f9082ae"
        ),
        "dinov2_source_tar_sha256": (
            "2f85e336d274855aa93392ff40e6b6b22a21e1ad424c6eadcd983bc4b5d35bc4"
        ),
        "dinov2_source_manifest_sha256": (
            "38af1b644fb6863961298ef09a43e696486c3cf0f093ab346e38773619ab8c27"
        ),
        "dinov2_source_file_count": 162,
        "dinov2_weight_sha256": (
            "b938bf1bc15cd2ec0feacfe3a1bb553fe8ea9ca46a7e1d8d00217f29aef60cd9"
        ),
        "dinov2_weight_size_bytes": 88283115,
        "dinov2_hub_contract": (
            "exact_run_local_cache_guarded_single_load_zero_download"
        ),
        "outputs_archive_sha256": (
            "425b0d8c2a4194d3ec996b553575f69409aa5714176b063d8401789db9179482"
        ),
        "conda_lock_sha256": (
            "a3d0bbfc4836c25c27199364b296f101bb61030346e81be11e47d478f161ffff"
        ),
