    if evidence.get("kind") != R22P10_LIBERO_PHASE2R_BANK_B_RECOVERY_EVIDENCE_KIND:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B recovery kind is not authorized")
    if resolved.get("resource_alias") != R22P10_LIBERO_PHASE1_RESOURCE_ALIAS:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B recovery requires the 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B recovery network must be empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
