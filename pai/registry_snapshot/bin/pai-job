        "repair_root": str(repair_root),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R10P07_STAGE2_R2A_REPAIR_SOURCE_COMMIT,
        "source_tree": R10P07_STAGE2_R2A_REPAIR_SOURCE_TREE,
        "mikasa_source_commit": "509b875f3d207c287497c0a897661062de928bb0",
        "launcher_sha256": launcher_sha,
        "formal_script_sha256": "3e3b0ab537ca394a0a1a0b63a683c260d7d66bca0a7a0b590948caf54f4aa964",
        "allocated_gpu_count": 2,
        "maximum_concurrent_validators": 2,
        "visible_gpu_count_per_validator": 1,
        "user_authorized_gpu_range": [2, 8],
        "noise_candidates": [0.001, 0.0005, 0.0001],
        "trajectory_rewrite_allowed": False,
        "correct_state_batch_dimension": True,
        "state_restore_atol": 1e-7,
        "scientific_gate_does_not_control_job_completion": True,
        "platform_fault_tolerance": False,
        "application_autoresume": False,
        "checkpointing": False,
