def validate_r10p07_stage2_r2a_preflight_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R10-P07 Stage-2-R2A preflight evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R10-P07 Stage-2-R2A submission/fault contract is missing")
    if evidence.get("kind") != R10P07_STAGE2_R2A_PREFLIGHT_EVIDENCE_KIND:
        raise Refused("R10-P07 Stage-2-R2A preflight evidence is unauthorized")
    if resolved.get("resource_alias") != R10P07_STAGE2_R2A_PREFLIGHT_RESOURCE_ALIAS:
        raise Refused("R10-P07 Stage-2-R2A requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R10-P07 Stage-2-R2A preflight network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10-P07 Stage-2-R2A worker drifted from verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R10P07_STAGE2_R2A_PREFLIGHT_OUTPUT_ROOT:
        raise Refused("R10-P07 Stage-2-R2A preflight output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R10-P07 Stage-2-R2A preflight runtime fields drifted")
    if runtime.get("pod_env") != {} or runtime.get("secret_env_names") != []:
        raise Refused("R10-P07 Stage-2-R2A preflight forbids secrets and pod env")
    if "wandb_entity_contract" in runtime:
        raise Refused("R10-P07 Stage-2-R2A preflight must not request W&B")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10-P07 Stage-2-R2A requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R10-P07 Stage-2-R2A identity must be 2254:2254")
    if runtime.get("identity_mechanism") != (
        "controller_inline_bootstrap_then_setpriv"
    ):
        raise Refused("R10-P07 Stage-2-R2A identity mechanism drifted")

    launcher_info = toolchain_config.get(
        "r10p07_stage2_r2a_preflight_launcher"
    )
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("R10-P07 Stage-2-R2A pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(
            f"R10-P07 Stage-2-R2A launcher is missing: {exc}"
        ) from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R10-P07 Stage-2-R2A launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R10-P07 Stage-2-R2A launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R10-P07 Stage-2-R2A command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R10-P07 Stage-2-R2A command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R10-P07 Stage-2-R2A payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R10-P07 Stage-2-R2A decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R10-P07 Stage-2-R2A launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_COMMIT={R10P07_STAGE2_R2A_PREFLIGHT_SOURCE_COMMIT}",
        f"EXPECTED_TREE={R10P07_STAGE2_R2A_PREFLIGHT_SOURCE_TREE}",
        "EXPECTED_SCRIPT_SHA=b80eb93b3f69f94a3a4aaa2daaa6a1367a3dc5fe0533cdb318c50f321389ce5f",
        'exec /usr/bin/env bash "$FORMAL_SCRIPT"',
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(
                f"R10-P07 Stage-2-R2A payload binding drifted: {fragment}"
            )
    for forbidden in (
        "/mnt/cpfs/zbl-cpfs/",
        "/mnt/nas/",
        "WANDB_API_KEY",
        "WANDB_ENTITY",
        "__REPLACE_",
        "TO_BE_FILLED",
    ):
        if forbidden in payload_text:
            raise Refused(
                f"R10-P07 Stage-2-R2A payload has forbidden marker: {forbidden}"
            )

    run_id = str(resolved["run_id"])
    data_root = R10P07_STAGE2_R2A_PREFLIGHT_DATA_ROOT / run_id
    result_root = R10P07_STAGE2_R2A_PREFLIGHT_RESULT_ROOT / run_id
    expected_evidence = {
        "kind": R10P07_STAGE2_R2A_PREFLIGHT_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "collection",
        "task_id": "r10p07-stage2-r2a-preflight-20260814",
        "model_id": "mikasa-upstream-oracle-plus-maniskill-official-pd-ee",
        "success_gate": "persisted_committed_sample_or_shard",
        "validation_method": (
            "static+cpu_protocol_tests+formal_fail_fast_gpu_runtime"
        ),
        "validation_status": "passed_no_pai_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "FIRST_WORK.json"),
        "completed_evidence_path": str(
            artifact_dir / "EVALUATION_COMPLETE.json"
        ),
        "result_root": str(result_root),
        "data_root": str(data_root),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R10P07_STAGE2_R2A_PREFLIGHT_SOURCE_COMMIT,
        "source_tree": R10P07_STAGE2_R2A_PREFLIGHT_SOURCE_TREE,
        "mikasa_source_commit": "509b875f3d207c287497c0a897661062de928bb0",
        "mikasa_source_tree": "af42ebbc56c861740a6b9cd52bf99085c8f0788b",
        "launcher_sha256": launcher_sha,
        "formal_script_sha256": (
            "b80eb93b3f69f94a3a4aaa2daaa6a1367a3dc5fe0533cdb318c50f321389ce5f"
        ),
        "allocated_gpu_count": 2,
        "maximum_concurrent_collectors": 2,
        "visible_gpu_count_per_collector": 1,
        "user_authorized_gpu_range": [2, 8],
        "preflight_seeds": list(range(740000, 740008)),
        "qpos_noise_order_linf_rad": [0.001, 0.0005, 0.0001],
        "waypoint_stride": 2,
        "official_horizon_override": None,
        "canonical_pd_ee_backend": "mani_skill_official",
        "primary_success_semantics_modified": False,
        "max_allowed_cube_displacement_modified": False,
        "scientific_gate_does_not_control_job_completion": True,
        "platform_fault_tolerance": False,
        "application_autoresume": False,
        "checkpointing": False,
        "wandb_mode": "disabled_collection_only",
        "browser_not_used": "fifo_not_applicable",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R10-P07 Stage-2-R2A exact evidence contract drifted")
    if write_paths != [str(artifact_dir), str(data_root), str(result_root)]:
        raise Refused("R10-P07 Stage-2-R2A write paths drifted")
    if output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("R10-P07 Stage-2-R2A preflight requires fresh roots")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R10-P07 Stage-2-R2A forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R10-P07 Stage-2-R2A fault contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-collection",
        "task": "r10p07-stage2-r2a-preflight-20260814",
        "model": "mikasa-oracle-official-pd-ee",
        "dataset": "mikasa-r2a-canonical-preflight",
        "hardware": "2xa800-dedicated-two-collectors",
        "resource_pool": "exp-efficiency",
        "experiment_role": "stage2-r2a-data-pipeline-preflight",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R10-P07 Stage-2-R2A submission contract drifted")


def validate_r16p19_phase3_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P19 Phase-3 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R16-P19 Phase-3 submission/fault contract is missing")
    if evidence.get("kind") != R16P19_PHASE3_EVIDENCE_KIND:
        raise Refused("R16-P19 Phase-3 evidence kind is not authorized")
    if resolved.get("resource_alias") != R16P19_PHASE3_RESOURCE_ALIAS:
        raise Refused("R16-P19 Phase-3 requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P19 Phase-3 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R16-P19 Phase-3 worker drifted from verified 2-GPU preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R16P19_PHASE3_OUTPUT_ROOT:
        raise Refused("R16-P19 Phase-3 output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R16-P19 Phase-3 runtime fields drifted")
    stage = str(evidence.get("stage", ""))
    stage_contracts = {
        "prepare": (
            R16P19_PHASE3_PREPARE_SOURCE_COMMIT,
            R16P19_PHASE3_PREPARE_SOURCE_TREE,
            "0",
        ),
        "formal": (
            R16P19_PHASE3_FORMAL_SOURCE_COMMIT,
            R16P19_PHASE3_FORMAL_SOURCE_TREE,
            "1",
        ),
    }
    if stage not in stage_contracts:
        raise Refused("R16-P19 Phase-3 stage is not yet frozen")
    source_commit, source_tree, include_videos = stage_contracts[stage]
    expected_pod_env = {
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics",
        "R16P19_PHASE3_EXPERIMENT_ROOT": str(
            R16P19_PHASE3_OUTPUT_ROOT.parent / "application"
        ),
        "R16P19_PHASE3_EXPECTED_COMMIT": source_commit,
        "R16P19_PHASE3_INCLUDE_VIDEOS": include_videos,
        "R16P19_PHASE3_STAGE": stage,
    }
    if runtime.get("pod_env") != expected_pod_env:
        raise Refused("R16-P19 Phase-3 pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R16-P19 Phase-3 must be submitted with --no-wandb")
    if "wandb_entity_contract" in runtime:
        raise Refused("R16-P19 Phase-3 must not request W&B credentials")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R16-P19 Phase-3 requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R16-P19 Phase-3 identity must be 2254:2254")
    if runtime.get("identity_mechanism") != (
        "controller_inline_bootstrap_then_setpriv"
    ):
        raise Refused("R16-P19 Phase-3 identity mechanism drifted")
    try:
        canonical_launcher = R16P19_PHASE3_LAUNCHER.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R16-P19 Phase-3 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != R16P19_PHASE3_LAUNCHER
        or R16P19_PHASE3_LAUNCHER.is_symlink()
        or not R16P19_PHASE3_LAUNCHER.is_file()
        or not os.access(R16P19_PHASE3_LAUNCHER, os.X_OK)
    ):
        raise Refused("R16-P19 Phase-3 launcher is not canonical/executable")
    launcher_sha = sha256(R16P19_PHASE3_LAUNCHER)
    if launcher_sha != R16P19_PHASE3_LAUNCHER_SHA256:
        raise Refused("R16-P19 Phase-3 launcher hash drifted")
    if runtime.get("command_file") != str(R16P19_PHASE3_LAUNCHER):
        raise Refused("R16-P19 Phase-3 command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R16-P19 Phase-3 command_file_sha256 drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R16-P19 Phase-3 payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R16-P19 Phase-3 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R16-P19 Phase-3 launcher must be UTF-8") from exc
    for fragment in (
        'test "$EXPECTED_GPUS" = 2',
        "export CUDA_VISIBLE_DEVICES=0",
        "export WANDB_MODE=disabled",
        "one_fsynced_rollout_or_replay_cell",
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R16-P19 Phase-3 launcher binding drifted: {fragment}")

    expected_evidence = {
        "kind": R16P19_PHASE3_EVIDENCE_KIND,
        "stage": stage,
        "resource_contract": "dedicated_2gpu_carrier_single_render_gpu_v1",
        "workload_type": "deterministic_non_neural_rollout_evaluation",
        "task_id": "r16p19-phase3-effect-boundary-replay-20260814",
        "model_id": "frozen_same_demonstration_action_segments_plus_memory_arms",
        "success_gate": "persisted_completed_stage_result",
        "validation_method": "static_plus_35_unit_tests_then_pai_real_simulator",
        "validation_status": "dev_render_unavailable_pai_contract_ready_no_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "FIRST_COMPLETED_CELL.json"),
        "completed_evidence_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": source_commit,
        "source_tree": source_tree,
        "launcher_sha256": launcher_sha,
        "preregistration_commit": "a219eb7411d84846a43b3356b8134d9d9ceca40b",
        "plan_sha256": "6ffac905c7063300124e9f416a9a007cb3dcd9c4264beec7e6f1ae57efadc83a",
        "protected_b6_sha256": "4992462e105306eca9a777619fa5c7418f90c1289e4e9f6fdde1bdc2fbfce4c5",
        "official_libero_commit": "8f1084e3132a39270c3a13ebe37270a43ece2a01",
        "stove_dataset_sha256": "6b30906a52a5741e98ef447d27e7066d6c0be4a5f7acd7ecaf1cb7468aca4aa9",
        "bowl_dataset_sha256": "703950f48a3c49dfde61be489ade91527f16e1449b4f29a85f2e51153cef3638",
        "allocated_gpu_count": 2,
        "scientific_visible_gpu_count": 1,
        "gpu_execution": "physical_gpu0_only_for_egl_gpu1_unexposed",
        "application_resume_unit": "one_fsynced_rollout_or_replay_cell",
        "pai_automatic_fault_tolerance": False,
        "platform_restart_limit": 0,
        "wandb_mode": "disabled_non_neural_evaluation",
        "formal_demo_accessed_by_stage": stage != "prepare",
        "user_override_run_all_experiments_after_failed_gate": True,
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R16-P19 Phase-3 exact evidence contract drifted")
    if write_paths != [
        str(artifact_dir),
        str(R16P19_PHASE3_OUTPUT_ROOT.parent / "application"),
    ]:
        raise Refused("R16-P19 Phase-3 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R16-P19 Phase-3 requires resumable application output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R16-P19 Phase-3 forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R16-P19 Phase-3 fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation",
        "task": "r16p19-phase3-effect-boundary-replay-20260814",
        "model": "frozen-effect-replay-memory-arms",
        "dataset": "libero10-two-task-demo-splits-frozen",
        "hardware": "2xa800-dedicated-single-render-visible",
        "resource_pool": "exp-efficiency",
        "experiment_role": stage,
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R16-P19 Phase-3 submission contract drifted")


def validate_r16p14_stage2c_replay_probe_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Validate the read-only R16-P14 Stage-2C cross-process replay probe."""

    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P14 Stage-2C replay-probe evidence is missing")
    if evidence.get("kind") != R16P14_STAGE2C_REPLAY_PROBE_EVIDENCE_KIND:
        raise Refused("R16-P14 Stage-2C replay-probe evidence kind is not authorized")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R16-P14 Stage-2C replay probe requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P14 Stage-2C replay-probe network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R16-P14 Stage-2C replay-probe worker preset drifted")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R16P14_STAGE2C_OUTPUT_ROOT:
        raise Refused("R16-P14 Stage-2C replay-probe output root drifted")
    if artifact_dir != R16P14_STAGE2C_OUTPUT_ROOT / str(resolved.get("run_id")):
        raise Refused("R16-P14 Stage-2C replay-probe artifact directory drifted")
    if write_paths != [
        str(artifact_dir),
        str(R16P14_STAGE2C_REPLAY_PROBE_CACHE_ROOT),
    ]:
        raise Refused("R16-P14 Stage-2C replay-probe write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R16-P14 Stage-2C replay probe requires resumable output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R16-P14 Stage-2C replay probe forbids recursive ownership repair")
    if runtime.get("pod_env") != {}:
        raise Refused("R16-P14 Stage-2C replay-probe pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R16-P14 Stage-2C replay probe is eval-only and disables secrets")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R16-P14 Stage-2C replay probe requires base64 payload transport")

    expected_launcher = ROOT / "launchers" / "r16p14_stage2c_replay_probe.sh"
    try:
        canonical_launcher = expected_launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R16-P14 Stage-2C replay-probe launcher is missing: {exc}") from exc
    if (
        canonical_launcher != expected_launcher
        or expected_launcher.is_symlink()
        or not expected_launcher.is_file()
        or not os.access(expected_launcher, os.X_OK)
    ):
        raise Refused("R16-P14 Stage-2C replay-probe launcher is not canonical/executable")
    launcher_sha = sha256(expected_launcher)
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("R16-P14 Stage-2C replay-probe command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R16-P14 Stage-2C replay-probe command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R16-P14 Stage-2C replay-probe frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R16-P14 Stage-2C replay-probe decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R16-P14 Stage-2C replay-probe launcher must be UTF-8") from exc
    required_fragments = (
        "ba5ddf68e15fec4db34e38547e8a57721e7fe5ba",
        "4f9761c860b05d4d7642ea0275bfa0f658926fc2",
        "3fd1d6ede6dddbbd381c9aa749339b46aeef701c795b1047e11b7011b286a495",
        "put_the_cream_cheese_in_the_bowl__seed07__init30",
        "for slot in 0 1 2",
        "r16_p14_stage2c.replay_probe",
        "PROBE_COMPLETE.json",
    )
    for fragment in required_fragments:
        if fragment not in payload_text:
            raise Refused(
                f"R16-P14 Stage-2C replay-probe launcher binding drifted: {fragment}"
            )
    for forbidden in (
        "/mnt/cpfs/zbl-cpfs/",
        "/mnt/nas/",
        "WANDB_API_KEY",
        "__REPLACE_",
        "TO_BE_FILLED",
    ):
        if forbidden in payload_text:
            raise Refused(
                f"R16-P14 Stage-2C replay-probe payload contains forbidden marker: {forbidden}"
            )

    probe_root = artifact_dir / "replay_probe"
    expected_evidence = {
        "kind": R16P14_STAGE2C_REPLAY_PROBE_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "read_only_replay_diagnostic",
        "task_id": "r16p14-stage2c-cross-process-replay-20260816",
        "model_id": "frozen-libero-act-seed7-h16",
        "success_gate": "three_independent_process_diagnostics_persisted",
        "validation_method": "static+33_contract_tests+dev14_same_event_exact_replay",
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": True,
        "first_work_evidence_path": str(probe_root / "slot_0.json"),
        "completed_evidence_path": str(probe_root / "PROBE_COMPLETE.json"),
        "report_path": str(probe_root / "summary.json"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": "ba5ddf68e15fec4db34e38547e8a57721e7fe5ba",
        "source_tree": "4f9761c860b05d4d7642ea0275bfa0f658926fc2",
        "launcher_sha256": launcher_sha,
        "python_sha256": "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
        "overlay_manifest_sha256": "64dfffdaf464d1a37be19b038cca919a252dba573eb2d0f8aa442b91a4099459",
        "overlay_file_count": 1688,
        "checkpoint_sha256": "821177a82cc470e108082fd3c0f6913983236a2fdf142de2fe51fc37c44240ca",
        "source_events_sha256": "3fd1d6ede6dddbbd381c9aa749339b46aeef701c795b1047e11b7011b286a495",
        "source_job_id": "dlcrl340ah8k5uya",
        "source_run_id": "r16p14-stage2c-formal-20260816-v6",
        "event_id": "put_the_cream_cheese_in_the_bowl__seed07__init30",
        "independent_processes": 3,
        "application_run_id": "r16p14-stage2c-replay-probe-20260816-v1",
        "cache_root": str(R16P14_STAGE2C_REPLAY_PROBE_CACHE_ROOT),
        "training": False,
        "learned_models": False,
        "wandb_mode": "disabled_eval_only",
        "gpu_execution": "one_pod_gpu0_three_sequential_fresh_processes",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R16-P14 Stage-2C replay-probe exact evidence contract drifted")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R16-P14 Stage-2C replay-probe fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "diagnostic-evaluation",
        "task": "r16p14-stage2c-cross-process-replay-20260816",
        "model": "frozen-libero-act-seed7-h16",
        "dataset": "immutable-v6-stage2c-event",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "stage2c-cross-process-replay-diagnostic",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R16-P14 Stage-2C replay-probe submission contract drifted")


def validate_r16p14_stage2d_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Validate the hash-bound, evaluation-only R16-P14 Stage-2D phases."""

    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P14 Stage-2D evidence is missing")
    if evidence.get("kind") != R16P14_STAGE2D_EVIDENCE_KIND:
        raise Refused("R16-P14 Stage-2D evidence kind is not authorized")
    resource_alias = resolved.get("resource_alias")
    resource_pools = {
        "exp-efficiency-a800-2gpu": "exp-efficiency",
        "exp-robot-r16p14-stage2d-2gpu": "exp-robot",
    }
    if resource_alias not in resource_pools:
        raise Refused("R16-P14 Stage-2D requires a verified dedicated 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P14 Stage-2D network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R16-P14 Stage-2D worker preset drifted")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R16P14_STAGE2D_OUTPUT_ROOT:
        raise Refused("R16-P14 Stage-2D output root drifted")
    if artifact_dir != R16P14_STAGE2D_OUTPUT_ROOT / str(resolved.get("run_id")):
        raise Refused("R16-P14 Stage-2D artifact directory drifted")
    if write_paths != [str(artifact_dir), str(R16P14_STAGE2D_CACHE_ROOT)]:
        raise Refused("R16-P14 Stage-2D write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R16-P14 Stage-2D requires resumable output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R16-P14 Stage-2D forbids recursive ownership repair")
    if runtime.get("pod_env") != {}:
        raise Refused("R16-P14 Stage-2D pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R16-P14 Stage-2D is eval-only and disables secrets")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R16-P14 Stage-2D requires base64 payload transport")

    expected_launcher = ROOT / "launchers" / "r16p14_stage2d.sh"
    try:
        canonical_launcher = expected_launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R16-P14 Stage-2D launcher is missing: {exc}") from exc
    if (
        canonical_launcher != expected_launcher
        or expected_launcher.is_symlink()
        or not expected_launcher.is_file()
        or not os.access(expected_launcher, os.X_OK)
    ):
        raise Refused("R16-P14 Stage-2D launcher is not canonical/executable")
    launcher_sha = sha256(expected_launcher)
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("R16-P14 Stage-2D command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R16-P14 Stage-2D command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R16-P14 Stage-2D frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R16-P14 Stage-2D decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R16-P14 Stage-2D launcher must be UTF-8") from exc

    phase_contracts = {
        "phase1_events_qualification_cohort": ("phase1", "PHASE1_COMPLETE.json"),
        "atlas_calibration": ("atlas", "ATLAS_COMPLETE.json"),
        "phase2_confirmatory_primary": ("phase2", "PHASE2_COMPLETE.json"),
        "phase3_oracle_report": ("phase3", "PHASE3_COMPLETE.json"),
    }
    application_phase = evidence.get("application_phase")
    if application_phase not in phase_contracts:
        raise Refused("R16-P14 Stage-2D application phase is not authorized")
    phase_token, completion_name = phase_contracts[application_phase]
    source_commit = str(evidence.get("source_commit", ""))
    source_tree = str(evidence.get("source_tree", ""))
    if not re.fullmatch(r"[a-f0-9]{40}", source_commit) or not re.fullmatch(
        r"[a-f0-9]{40}", source_tree
    ):
        raise Refused("R16-P14 Stage-2D source commit/tree is invalid")
    required_fragments = (
        source_commit,
        source_tree,
        f"STAGE2D_PHASE={phase_token}",
        "r16_p14_stage2d/pai/launcher.sh",
    )
    for fragment in required_fragments:
        if fragment not in payload_text:
            raise Refused(f"R16-P14 Stage-2D launcher binding drifted: {fragment}")
    for forbidden in (
        "/mnt/cpfs/zbl-cpfs/",
        "/mnt/nas/",
        "WANDB_API_KEY",
        "__REPLACE_",
        "TO_BE_FILLED",
    ):
        if forbidden in payload_text:
            raise Refused(f"R16-P14 Stage-2D payload contains forbidden marker: {forbidden}")

    state_root = artifact_dir / "pai_state"
    required_evidence = {
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "rollout_evaluation",
        "model_id": "frozen-libero-history-conditioned-state-act-three-seed-h16",
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": source_commit,
        "source_tree": source_tree,
        "registry_launcher_sha256": launcher_sha,
        "python_sha256": "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
        "training": False,
        "learned_models": False,
        "wandb_mode": "disabled_eval_only",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    for key, expected in required_evidence.items():
        if evidence.get(key) != expected:
            raise Refused(f"R16-P14 Stage-2D evidence.{key} drifted")
    if evidence.get("first_work_evidence_path") != str(
        state_root / "FIRST_REAL_WORK.json"
    ):
        raise Refused("R16-P14 Stage-2D first-work path drifted")
    if evidence.get("completed_evidence_path") != str(state_root / completion_name):
        raise Refused("R16-P14 Stage-2D completion path drifted")
    if evidence.get("checkpoint_sha256") != {
        "seed_7": "821177a82cc470e108082fd3c0f6913983236a2fdf142de2fe51fc37c44240ca",
        "seed_17": "83ee61e31ffdae6f2ef57203a2c0085df41e284039cd81c6ecf1210694521604",
        "seed_29": "0cf34a3e535525345306a2b322aae3b1bd6ebd6cd71dc653e2a91393e2b79d1a",
    }:
        raise Refused("R16-P14 Stage-2D checkpoint lineage drifted")
    if not re.fullmatch(r"[a-f0-9]{64}", str(evidence.get("source_launcher_sha256", ""))):
        raise Refused("R16-P14 Stage-2D source launcher hash is missing")
    if evidence.get("resume_contract") != (
        "immutable JSON shard boundaries; completed shards never overwritten"
    ):
        raise Refused("R16-P14 Stage-2D resume contract drifted")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R16-P14 Stage-2D fault-tolerance contract drifted")
    if not isinstance(submission, dict):
        raise Refused("R16-P14 Stage-2D submission contract is missing")
    tags = submission.get("tags")
    if submission.get("priority") != 9 or submission.get("disable_ecs_stock_check") is not False:
        raise Refused("R16-P14 Stage-2D submission priority/stock contract drifted")
    if submission.get("job_reserved_policy") != "" or submission.get("job_reserved_minutes") != 0:
        raise Refused("R16-P14 Stage-2D reservation contract drifted")
    if submission.get("job_max_running_time_minutes") != 0:
        raise Refused("R16-P14 Stage-2D max-running-time contract drifted")
    if not isinstance(tags, dict) or any(
        tags.get(key) != value
        for key, value in {
            "managed_by": "pai-job-registry",
            "purpose": "formal-evaluation",
            "model": "frozen-libero-act-three-seed-h16",
            "dataset": "libero-goal-two-task-fresh-init-pool",
            "hardware": "2xa800-dedicated",
            "resource_pool": resource_pools[resource_alias],
        }.items()
    ):
        raise Refused("R16-P14 Stage-2D submission tags drifted")


def validate_r16p14_stage2c_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Validate the frozen R16-P14 Stage-2C two-card evaluation."""

    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P14 Stage-2C evidence is missing")
    if evidence.get("kind") != R16P14_STAGE2C_EVIDENCE_KIND:
        raise Refused("R16-P14 Stage-2C evidence kind is not authorized")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R16-P14 Stage-2C requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P14 Stage-2C network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R16-P14 Stage-2C worker preset drifted")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R16P14_STAGE2C_OUTPUT_ROOT:
        raise Refused("R16-P14 Stage-2C output root drifted")
    if artifact_dir != R16P14_STAGE2C_OUTPUT_ROOT / str(resolved.get("run_id")):
        raise Refused("R16-P14 Stage-2C artifact directory drifted")
    if write_paths != [str(artifact_dir), str(R16P14_STAGE2C_CACHE_ROOT)]:
        raise Refused("R16-P14 Stage-2C write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R16-P14 Stage-2C requires resumable output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R16-P14 Stage-2C forbids recursive ownership repair")
    if runtime.get("pod_env") != {}:
        raise Refused("R16-P14 Stage-2C pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R16-P14 Stage-2C is eval-only and disables secrets")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R16-P14 Stage-2C requires base64 payload transport")

    expected_launcher = ROOT / "launchers" / "r16p14_stage2c_2xa800.sh"
    try:
        canonical_launcher = expected_launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R16-P14 Stage-2C launcher is missing: {exc}") from exc
    if (
        canonical_launcher != expected_launcher
        or expected_launcher.is_symlink()
        or not expected_launcher.is_file()
        or not os.access(expected_launcher, os.X_OK)
    ):
        raise Refused("R16-P14 Stage-2C launcher is not canonical/executable")
    launcher_sha = sha256(expected_launcher)
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("R16-P14 Stage-2C command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R16-P14 Stage-2C command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R16-P14 Stage-2C frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R16-P14 Stage-2C decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R16-P14 Stage-2C launcher must be UTF-8") from exc
    required_fragments = (
        R16P14_STAGE2C_SOURCE_COMMIT,
        R16P14_STAGE2C_SOURCE_TREE,
        "R16_P14_STAGE2C_ARTIFACT_ROOT",
        "first_completed_event.json",
        "--bootstrap-replicates 10000",
        "STAGE2C_COMPLETE.json",
        "run_event_worker 0 0",
        "run_event_worker 1 1",
        "--smoke --device cuda",
        "4fe57054d32c439201b81da0e433c9c0566c3222b21e28f994f584724474697c",
        "hash_verified_reused_completed_actor_event_shards",
    )
    for fragment in required_fragments:
        if fragment not in payload_text:
            raise Refused(
                f"R16-P14 Stage-2C launcher binding drifted: {fragment}"
            )
    for forbidden in (
        "/mnt/cpfs/zbl-cpfs/",
        "/mnt/nas/",
        "WANDB_API_KEY",
        "__REPLACE_",
        "TO_BE_FILLED",
    ):
        if forbidden in payload_text:
            raise Refused(
                f"R16-P14 Stage-2C payload contains forbidden marker: {forbidden}"
            )

    stage_root = artifact_dir / "stage2c_artifacts"
    expected_evidence = {
        "kind": R16P14_STAGE2C_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "rollout_evaluation",
        "task_id": "r16p14-stage2c-recoverability-matched-20260816",
        "model_id": "frozen-libero-act-three-seed-h16",
        "success_gate": "completed_actor_event_then_all_planned_matrices_and_report",
        "validation_method": "static+33_contract_tests+dev14_exact_replay+three_process_PAI_exact_replay_probe",
        "validation_status": "passed_with_three_process_pai_exact_replay_probe",
        "pai_probe_created": True,
        "first_work_evidence_path": str(stage_root / "first_completed_event.json"),
        "completed_evidence_path": str(stage_root / "STAGE2C_COMPLETE.json"),
        "report_path": str(stage_root / "REPORT.md"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R16P14_STAGE2C_SOURCE_COMMIT,
        "source_tree": R16P14_STAGE2C_SOURCE_TREE,
        "launcher_sha256": launcher_sha,
        "python_sha256": "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
        "overlay_manifest_sha256": "64dfffdaf464d1a37be19b038cca919a252dba573eb2d0f8aa442b91a4099459",
        "overlay_file_count": 1688,
        "checkpoint_sha256": {
            "seed_7": "821177a82cc470e108082fd3c0f6913983236a2fdf142de2fe51fc37c44240ca",
            "seed_17": "83ee61e31ffdae6f2ef57203a2c0085df41e284039cd81c6ecf1210694521604",
            "seed_29": "0cf34a3e535525345306a2b322aae3b1bd6ebd6cd71dc653e2a91393e2b79d1a",
        },
        "source_event_job_id": "dlcrl340ah8k5uya",
        "source_event_run_id": "r16p14-stage2c-formal-20260816-v6",
        "source_event_shards_sha256": "4fe57054d32c439201b81da0e433c9c0566c3222b21e28f994f584724474697c",
        "source_event_shard_count": 240,
        "application_run_id": "r16p14-stage2c-formal-20260816-v8",
        "cache_root": str(R16P14_STAGE2C_CACHE_ROOT),
        "actor_seeds": [7, 17, 29],
        "calibration_init_ids": list(range(30, 40)),
        "evaluation_init_ids": list(range(40, 50)),
        "prefix_indices": list(range(2, 17)),
        "bootstrap_replicates": 10000,
        "candidate_tasks": [
            "put_the_cream_cheese_in_the_bowl",
            "put_the_bowl_on_the_stove",
            "push_the_plate_to_the_front_of_the_stove",
            "open_the_top_drawer_and_put_the_bowl_inside",
        ],
        "all_candidate_families_attempted_even_after_gate_failure": True,
        "training": False,
        "learned_models": False,
        "wandb_mode": "disabled_eval_only",
        "gpu_execution": "one_pod_two_isolated_cuda_visible_devices_workers_then_cpu_consolidation",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R16-P14 Stage-2C exact evidence contract drifted")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R16-P14 Stage-2C fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation",
        "task": "r16p14-stage2c-recoverability-matched-20260816",
        "model": "frozen-libero-act-three-seed-h16",
        "dataset": "libero-goal-four-candidate-task-locked",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "stage2c-recoverability-compute-matched-validation",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R16-P14 Stage-2C submission contract drifted")


def validate_r16p14_libero_stage1_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P14 LIBERO Stage-1 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R16-P14 LIBERO Stage-1 submission/fault contract is missing")
    if evidence.get("kind") != R16P14_LIBERO_STAGE1_EVIDENCE_KIND:
        raise Refused("R16-P14 LIBERO Stage-1 evidence kind is not authorized")
    if resolved.get("resource_alias") != R16P14_LIBERO_STAGE1_RESOURCE_ALIAS:
        raise Refused("R16-P14 LIBERO Stage-1 requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P14 LIBERO Stage-1 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R16-P14 LIBERO Stage-1 worker must equal the verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R16P14_LIBERO_STAGE1_OUTPUT_ROOT:
        raise Refused("R16-P14 LIBERO Stage-1 output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R16-P14 LIBERO Stage-1 runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R16-P14 LIBERO Stage-1 public pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused("R16-P14 LIBERO Stage-1 requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R16-P14 LIBERO Stage-1 W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R16-P14 LIBERO Stage-1 requires base64 payload transport")

    launcher_info = toolchain_config.get("r16p14_libero_stage1_launcher")
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("R16-P14 LIBERO Stage-1 pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R16-P14 LIBERO Stage-1 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R16-P14 LIBERO Stage-1 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R16-P14 LIBERO Stage-1 launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R16-P14 LIBERO Stage-1 command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R16-P14 LIBERO Stage-1 frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R16-P14 LIBERO Stage-1 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R16-P14 LIBERO Stage-1 launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_SOURCE_COMMIT={R16P14_LIBERO_STAGE1_SOURCE_COMMIT}",
        f"EXPECTED_SOURCE_TREE={R16P14_LIBERO_STAGE1_SOURCE_TREE}",
        f"APPLICATION_RUN_ID={R16P14_LIBERO_STAGE1_APPLICATION_RUN_ID}",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R16-P14 LIBERO Stage-1 payload binding drifted: {fragment}")

    expected_evidence = {
        "kind": R16P14_LIBERO_STAGE1_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "training_and_rollout_evaluation",
        "task_id": "r16p14-libero-stage1-oracle-prefix-20260812",
        "model_id": "state-observation-chunk-bc-mlp-h16",
        "success_gate": "persisted_step_loss_then_completed_rollout_and_report",
        "validation_method": (
            "static+dev14_cpu_replay+single_gpu_train_resume_oracle_smoke"
        ),
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            artifact_dir
            / "training"
            / R16P14_LIBERO_STAGE1_APPLICATION_RUN_ID
            / "first_real_work.json"
        ),
        "first_rollout_evidence_path": str(
            artifact_dir
            / "shards/open_the_middle_drawer_of_the_cabinet"
            / R16P14_LIBERO_STAGE1_APPLICATION_RUN_ID
            / "baseline_eval/first_completed_rollout.json"
        ),
        "training_completed_evidence_path": str(
            artifact_dir / "TRAINING_COMPLETE.json"
        ),
        "completed_evidence_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
        "report_path": str(artifact_dir / "report/report.md"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R16P14_LIBERO_STAGE1_SOURCE_COMMIT,
        "source_tree": R16P14_LIBERO_STAGE1_SOURCE_TREE,
        "launcher_sha256": launcher_sha,
        "libero_config_sha256": (
            "528990e0cdd466a063def065fddb835fe2f37609cfef305d1910a1bf91a353ce"
        ),
        "demo_sha256": {
            "open_the_middle_drawer_of_the_cabinet": (
                "20252c7cf98cd7437061f7f200ae7b6cb6219fabbd53b4536dfaa8abda6ab737"
            ),
            "put_the_bowl_on_the_plate": (
                "e69528b0cf10dfc59b20698e12ec2affc03f3887309034d3eb74cac3ec929406"
            ),
            "put_the_wine_bottle_on_the_rack": (
                "f9092aa70734fc4083e97fc58c3ba25f87c614d18326182ddc7a455f0ab4da2e"
            ),
        },
        "demo_size_bytes": {
            "open_the_middle_drawer_of_the_cabinet": 702223367,
            "put_the_bowl_on_the_plate": 468246288,
            "put_the_wine_bottle_on_the_rack": 878958730,
        },
        "application_run_id": R16P14_LIBERO_STAGE1_APPLICATION_RUN_ID,
        "checkpoint_lineage": str(R16P14_LIBERO_STAGE1_CHECKPOINT_LINEAGE),
        "cache_root": str(R16P14_LIBERO_STAGE1_CACHE_ROOT),
        "checkpoint_cadence_steps": 2000,
        "full_state_resume": True,
        "train_steps_per_task_seed": 8000,
        "batch_size_per_process": 256,
        "policy_seeds": [7, 17, 29],
        "chunk_length": 16,
        "execution_horizons": [1, 4, 8, 16],
        "clean_episodes_per_seed_per_horizon": 10,
        "oracle_policy_seed": 7,
        "oracle_candidates_per_task": 30,
        "oracle_insertion_prefixes": [2, 6, 10],
        "oracle_prefix_stride": 2,
        "oracle_branch_budget": 96,
        "tasks": [
            "open_the_middle_drawer_of_the_cabinet",
            "put_the_bowl_on_the_plate",
            "put_the_wine_bottle_on_the_rack",
        ],
        "gpu_execution": (
            "gpu0_drawer_plus_gpu1_bowl_then_gpu0_wine_for_train_and_eval"
        ),
        "wandb_mode": "online_training_exact_entity_resume_same_lineage",
        "experiment_scope": (
            "preliminary_stage1_oracle_pilot_not_final_algorithm_claim"
        ),
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R16-P14 LIBERO Stage-1 exact evidence contract drifted")

    if write_paths != [
        str(artifact_dir),
        str(R16P14_LIBERO_STAGE1_CHECKPOINT_LINEAGE),
        str(R16P14_LIBERO_STAGE1_CACHE_ROOT),
    ]:
        raise Refused("R16-P14 LIBERO Stage-1 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R16-P14 LIBERO Stage-1 requires resumable application output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R16-P14 LIBERO Stage-1 forbids recursive ownership repair")
