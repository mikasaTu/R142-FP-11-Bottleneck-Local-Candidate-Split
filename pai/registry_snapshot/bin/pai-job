    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Validate frozen prospective scoring/orbit extraction on two A800s."""

    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R10P25 Step7 prospective evidence is missing")
