def validate_r22p10_libero_phase1_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R22-P10 LIBERO Phase-1 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R22-P10 LIBERO Phase-1 submission/fault contract is missing")
    evidence_kind = str(evidence.get("kind", ""))
    if evidence_kind == R22P10_PHASE4A_STEP6_EVIDENCE_KIND:
        validate_r22p10_phase4a_step6_profile(
            resolved=resolved,
            toolchain_config=toolchain_config,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    if evidence_kind == R22P10_PHASE3A_STEP5_EVIDENCE_KIND:
        validate_r22p10_phase3a_step5_profile(
            resolved=resolved,
            toolchain_config=toolchain_config,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    if evidence_kind == R22P10_LIBERO_PHASE2R_BANK_B_FINALIZE_EVIDENCE_KIND:
        validate_r22p10_libero_phase2r_bank_b_finalize_profile(
            resolved=resolved,
            toolchain_config=toolchain_config,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    if evidence_kind == R22P10_LIBERO_PHASE2R_BANK_B_RECOVERY_EVIDENCE_KIND:
        validate_r22p10_libero_phase2r_bank_b_recovery_profile(
            resolved=resolved,
            toolchain_config=toolchain_config,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    if evidence_kind == R22P10_LIBERO_PHASE2R_EVIDENCE_KIND:
        validate_r22p10_libero_phase2r_profile(
            resolved=resolved,
            toolchain_config=toolchain_config,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    if evidence_kind == R22P10_LIBERO_PHASE2_GATE_EVIDENCE_KIND:
        validate_r22p10_libero_phase2_profile(
            resolved=resolved,
            toolchain_config=toolchain_config,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    if evidence_kind not in {
        R22P10_LIBERO_PHASE1_TRAIN_EVIDENCE_KIND,
        R22P10_LIBERO_PHASE1_EVAL_EVIDENCE_KIND,
        R22P10_LIBERO_PHASE1B_EVAL_EVIDENCE_KIND,
    }:
        raise Refused("R22-P10 LIBERO Phase-1 evidence kind is not authorized")
    is_training = evidence_kind == R22P10_LIBERO_PHASE1_TRAIN_EVIDENCE_KIND
    is_phase1b = evidence_kind == R22P10_LIBERO_PHASE1B_EVAL_EVIDENCE_KIND
    source_commit = (
        R22P10_LIBERO_PHASE1_TRAIN_SOURCE_COMMIT
        if is_training
        else R22P10_LIBERO_PHASE1B_EVAL_SOURCE_COMMIT
        if is_phase1b
        else R22P10_LIBERO_PHASE1_EVAL_SOURCE_COMMIT
    )
    source_tree = (
        R22P10_LIBERO_PHASE1_TRAIN_SOURCE_TREE
        if is_training
        else R22P10_LIBERO_PHASE1B_EVAL_SOURCE_TREE
        if is_phase1b
        else R22P10_LIBERO_PHASE1_EVAL_SOURCE_TREE
    )

    if resolved.get("resource_alias") != R22P10_LIBERO_PHASE1_RESOURCE_ALIAS:
        raise Refused("R22-P10 LIBERO Phase-1 requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P10 LIBERO Phase-1 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
