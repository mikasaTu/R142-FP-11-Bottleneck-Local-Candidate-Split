    )
    resource_source_job_id = (
        "dlc1k4y4965q71yw"
        if resource_alias == R22P21_V3_ROBOT_RESOURCE_ALIAS
        else "dlc1j2p8ui63ulps"
    )
    if resolved.get("network") != {}:
        raise Refused("R22-P21 v3 continuation network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R22-P21 v3 continuation worker drifted")
    if Path(str(storage.get("output_root", ""))) != Path(phase["output_root"]):
        raise Refused("R22-P21 v3 continuation output root drifted")

    expected_runtime_fields = {
        "canary_nonce", "command", "command_file", "command_file_sha256",
        "create_artifact_dir", "gid", "identity_mechanism", "output_mode",
        "payload_base64", "payload_sha256", "payload_transport", "pod_env",
        "recursive_repair", "secret_env_names", "uid", "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R22-P21 v3 continuation runtime fields drifted")
    if runtime.get("pod_env") != {
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics"
    }:
        raise Refused("R22-P21 v3 continuation pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY", "WANDB_ENTITY"
    ]:
        raise Refused("R22-P21 v3 continuation requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R22-P21 v3 continuation W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P21 v3 continuation requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R22-P21 v3 continuation identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R22-P21 v3 continuation identity mechanism drifted")

    launcher = Path(str(phase.get("launcher_root", launcher_root))) / str(
        phase["launcher"]
    )
    try:
        canonical_launcher = launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P21 v3 continuation launcher is missing: {exc}") from exc
    launcher_sha = str(phase["launcher_sha"])
    if (
        canonical_launcher != launcher
        or launcher.is_symlink()
        or not launcher.is_file()
        or not os.access(launcher, os.X_OK)
        or sha256(launcher) != launcher_sha
    ):
        raise Refused("R22-P21 v3 continuation launcher contract drifted")
    if runtime.get("command_file") != str(launcher):
        raise Refused("R22-P21 v3 continuation command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R22-P21 v3 continuation command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R22-P21 v3 continuation payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P21 v3 continuation launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_SOURCE_COMMIT={phase['source_commit']}",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        str(phase["complete_marker"]),
        "CUDA_VISIBLE_DEVICES=",
    ):
        if payload_text.count(fragment) < 1:
            raise Refused(
                f"R22-P21 v3 continuation payload binding drifted: {fragment}"
            )

    expected_write_paths = [str(artifact_dir), *phase["write_paths"]]
    if write_paths != expected_write_paths:
        raise Refused("R22-P21 v3 continuation write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R22-P21 v3 continuation requires resumable outputs")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P21 v3 continuation forbids recursive repair")
    expected_fault = {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }
    if fault != expected_fault:
        raise Refused("R22-P21 v3 continuation fault-tolerance contract drifted")

    expected_evidence = {
        "kind": kind,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": phase["workload"],
        "task_id": f"r22p21-v3-{phase['slug']}-20260818",
        "success_gate": phase["success_gate"],
        "validation_method": phase.get(
            "validation_method", "static_unit_and_local_gpu_smoke_no_pai_probe"
        ),
        "validation_status": "passed_no_pai_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": phase["first_work"],
        "completed_evidence_path": phase["complete"],
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": phase["source_commit"],
        "source_tree": phase["source_tree"],
        "launcher_commit": phase.get(
            "launcher_commit", "1fe8d3a5490529d18746bfebd33c4bf317521068"
        ),
        "launcher_sha256": launcher_sha,
        "preregistration_commit": "4a887a5",
        "preregistration_sha256": "b29e38088574359ccb12756a90e610c9d037fa9bc2ab75fcfb37a21b472febc4",
        "resolved_config_sha256": "32a2f768bdb096dc6eba58df1061b85e7723e7118f9549523ddc6c5834386958",
        "maximum_concurrent_gpus": 2,
        "gpus_per_process": 1,
        "complete_all_phases_despite_gate_failure": True,
        "scientific_gate_short_circuit": False,
        "application_resume_scope": "phase_specific_complete_artifacts_and_progress",
        "wandb_entity": "chen_jian-cj-workspace",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "cleanup_required": phase.get("cleanup_required", False),
    }
    if phase.get("fallback_after_two_smolvla_runtime_repairs") is True:
        expected_evidence["fallback_after_two_smolvla_runtime_repairs"] = True
    if evidence != expected_evidence:
        raise Refused("R22-P21 v3 continuation evidence contract drifted")
    expected_submission = {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": {
            "managed_by": "pai-job-registry",
            "purpose": phase.get("purpose", "formal-training-evaluation"),
            "task": f"r22p21-v3-{phase['slug']}-20260818",
            "model": phase.get("model", "smolvla"),
            "dataset": phase.get("dataset", "r22p21-libero-lerobot-12000"),
            "hardware": "2xa800-dedicated",
            "resource_pool": resource_pool,
            "experiment_role": f"v3-target-identifiability-{phase['slug']}",
        },
    }
    if submission != expected_submission:
        raise Refused("R22-P21 v3 continuation submission contract drifted")
    if provenance != {
        "contract_source_job_id": "dlcfp1szuc2cgqfp",
        "resource_source_job_id": resource_source_job_id,
        "submission_method": "cli_create",
        "pai_clone_performed": False,
        "source_role": "readback_reference",
    }:
        raise Refused("R22-P21 v3 continuation provenance drifted")


def validate_r22p21_selector_v2_smol_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    provenance = resolved.get("provenance")
    if not all(isinstance(value, dict) for value in (evidence, submission, fault, provenance)):
        raise Refused("R22-P21 selector-v2 SmolVLA contract sections are missing")
    kind = evidence.get("kind")
    if kind not in (
        R22P21_SELECTOR_V2_SMOL_TRAIN_EVIDENCE_KIND,
        R22P21_SELECTOR_V2_SMOL_EVAL_EVIDENCE_KIND,
    ):
        raise Refused("R22-P21 selector-v2 SmolVLA evidence kind is not authorized")
    if resolved.get("resource_alias") != R22P21_SELECTOR_V2_TINY_RESOURCE_ALIAS:
        raise Refused("R22-P21 selector-v2 SmolVLA requires the verified dedicated alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P21 selector-v2 SmolVLA network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R22-P21 selector-v2 SmolVLA worker drifted")
    is_train = kind == R22P21_SELECTOR_V2_SMOL_TRAIN_EVIDENCE_KIND
    launcher = (
        R22P21_SELECTOR_V2_SMOL_TRAIN_LAUNCHER
        if is_train else R22P21_SELECTOR_V2_SMOL_EVAL_LAUNCHER
    )
    launcher_sha = (
        R22P21_SELECTOR_V2_SMOL_TRAIN_LAUNCHER_SHA256
        if is_train else R22P21_SELECTOR_V2_SMOL_EVAL_LAUNCHER_SHA256
    )
    output_root = (
        R22P21_SELECTOR_V2_SMOL_TRAIN_OUTPUT_ROOT
        if is_train else R22P21_SELECTOR_V2_SMOL_EVAL_OUTPUT_ROOT
    )
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(str(storage.get("output_root", ""))) != output_root:
        raise Refused("R22-P21 selector-v2 SmolVLA registry output root drifted")
    expected_runtime_fields = {
        "canary_nonce", "command", "command_file", "command_file_sha256",
        "create_artifact_dir", "gid", "identity_mechanism", "output_mode",
        "payload_base64", "payload_sha256", "payload_transport", "pod_env",
        "recursive_repair", "secret_env_names", "uid", "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R22-P21 selector-v2 SmolVLA runtime fields drifted")
    if runtime.get("pod_env") != {"NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics"}:
        raise Refused("R22-P21 selector-v2 SmolVLA pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY", "WANDB_ENTITY"
    ]:
        raise Refused("R22-P21 selector-v2 SmolVLA requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R22-P21 selector-v2 SmolVLA W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P21 selector-v2 SmolVLA requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R22-P21 selector-v2 SmolVLA identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R22-P21 selector-v2 SmolVLA identity mechanism drifted")
    try:
        canonical_launcher = launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P21 selector-v2 SmolVLA launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher
        or launcher.is_symlink()
        or not launcher.is_file()
        or not os.access(launcher, os.X_OK)
        or sha256(launcher) != launcher_sha
    ):
        raise Refused("R22-P21 selector-v2 SmolVLA launcher contract drifted")
    if runtime.get("command_file") != str(launcher):
        raise Refused("R22-P21 selector-v2 SmolVLA command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R22-P21 selector-v2 SmolVLA command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R22-P21 selector-v2 SmolVLA payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P21 selector-v2 SmolVLA launcher must be UTF-8") from exc
    common_fragments = (
        "PREREGISTRATION_COMMIT=f2e0b59",
        (
            'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2'
            if is_train
            else 'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 1'
        ),
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
        "BASE_VLM_REVISION=7b375e1b73b11138ff12fe22c8f2822d8fe03467",
        "HF_HUB_OFFLINE=1",
        "41001", "41002", "41003",
    )
    specific_fragments = (
        (
            "BASE_MODEL_REVISION=c83c3163b8ca9b7e67c509fffd9121e66cb96205",
            '--policy.path="$BASE_MODEL_SNAPSHOT"',
            "train_one 41001", "train_one 41002", "train_one 41003",
            "SMOLVLA_TRAIN_PHASE_COMPLETE.json",
        )
        if is_train
        else ("r22p21.selector_v2_smol_pipeline", "records.jsonl.progress.jsonl", "SMOLVLA_EVAL_PHASE_COMPLETE.json")
    )
    for fragment in (*common_fragments, *specific_fragments):
        if payload_text.count(fragment) < 1:
            raise Refused(f"R22-P21 selector-v2 SmolVLA payload binding drifted: {fragment}")
    common_evidence = {
        "kind": kind,
        "resource_contract": "dedicated_2gpu_v1",
        "pai_probe_created": False,
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R22P21_SELECTOR_V2_SMOL_SOURCE_COMMIT,
        "source_tree": R22P21_SELECTOR_V2_SMOL_SOURCE_TREE,
        "launcher_sha256": launcher_sha,
        "preregistration_commit": "f2e0b59",
        "preregistration_sha256": "ff5398b418db4600e15dc1ce3144360234f51538a859707f03ceb662ae703b48",
        "resolved_config_sha256": "111675725234ad3ec436c385a4acc15298d36e6f968719a617fa43caa72962d7",
        "lerobot_commit": "6adf51511b7625090eade8d82d9f61a1846ebe56",
        "base_checkpoint_revision": "c83c3163b8ca9b7e67c509fffd9121e66cb96205",
        "base_checkpoint_model_sha256": "7cd549ac2351fb069c0ddb3c34ad2d09cfc92b56a15dccdfc2e41467aaca01eb",
        "base_vlm_revision": "7b375e1b73b11138ff12fe22c8f2822d8fe03467",
        "base_vlm_model_sha256": "b9bfd456c9472c0acd5719d6e514c4b859891af205ee1a736552fd3497b8b0c3",
        "huggingface_runtime_mode": "offline_cached_exact_snapshots",
        "model_seeds": [41001, 41002, 41003],
        "maximum_concurrent_gpus": 2,
        "gpus_per_process": 1,
        "complete_all_phases_despite_gate_failure": True,
        "scientific_gate_short_circuit": False,
        "wandb_entity": "chen_jian-cj-workspace",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "cleanup_required": False,
    }
    if is_train:
        expected_evidence = {
            **common_evidence,
            "workload_type": "smolvla_smoke_contract_then_three_seed_finetune",
            "task_id": "r22p21-selector-v2-smolvla-train-20260814",
            "model_id": "lerobot-smolvla-base-three-finetuned-seeds",
            "success_gate": "smoke_data_action_camera_contract_then_three_complete_checkpoints",
            "validation_method": "static+unit+local_gpu_server_smoke_no_pai_probe",
            "validation_status": "passed_no_pai_probe",
            "first_work_evidence_path": str(artifact_dir / "FIRST_REAL_WORK.json"),
            "completed_evidence_path": str(artifact_dir / "SMOLVLA_TRAIN_PHASE_COMPLETE.json"),
            "formal_torch": "2.11.0+cu128",
            "application_resume_scope": "complete_LeRobot_checkpoints_and_optimizer_train_config",
            "wandb_mode": "online_exact_entity_one_run_per_model_seed_resume_same_lineage",
            "wandb_project": "r22p21-selector-v2-smolvla",
        }
        expected_write_paths = [
            str(artifact_dir),
            "/mnt/cpfs/zbl-cpfs-new/CKPT/leon/torch/r22p21_selector_v2/smolvla-formal-v1",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/logs/r22p21_selector_v2/smolvla-train-v1",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/cache/r22p21_selector_v2/smolvla-train-v1",
        ]
        expected_tags = {
            "managed_by": "pai-job-registry",
            "purpose": "formal-training-evaluation",
            "task": "r22p21-selector-v2-smolvla-train-20260814",
            "model": "smolvla",
            "dataset": "r22p21-libero-lerobot-12000",
            "hardware": "2xa800-dedicated",
            "resource_pool": "exp-efficiency",
            "experiment_role": "selector-v2-competent-host-training",
        }
    else:
        expected_evidence = {
            **common_evidence,
            "workload_type": "smolvla_teacher_selector_operator_closed_loop",
            "task_id": "r22p21-selector-v2-smolvla-eval-20260814",
            "model_id": "three-finetuned-smolvla-seeds-three-selector-seeds",
            "success_gate": "all_stages_and_exact_5760_closed_loop_episodes_complete",
            "validation_method": "static+unit+instrumented_server_smoke_no_pai_probe",
            "validation_status": "passed_no_pai_probe",
            "first_work_evidence_path": str(artifact_dir / "FIRST_REAL_WORK.json"),
            "completed_evidence_path": str(artifact_dir / "SMOLVLA_EVAL_PHASE_COMPLETE.json"),
            "formal_controller_torch": "2.5.1+cu124",
            "formal_server_torch": "2.11.0+cu128",
            "selector_seeds": [31001, 31002, 31003],
            "closed_loop_episode_count": 5760,
            "application_resume_scope": "stage_markers_selector_epoch10_archive_rows_closed_loop_episode_sets",
            "wandb_mode": "credentials_present_no_training_run_created_by_eval_payload",
        }
        expected_write_paths = [
            str(artifact_dir),
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/logs/r22p21_selector_v2/formal-smolvla-v1",
            "/mnt/cpfs/zbl-cpfs-new/dataset/leon/r22p21_selector_v2/host-archives-v2",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/logs/r22p21_selector_v2/smolvla-eval-v1",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/cache/r22p21_selector_v2/smolvla-eval-v1",
        ]
        expected_tags = {
            "managed_by": "pai-job-registry",
            "purpose": "formal-training-evaluation",
            "task": "r22p21-selector-v2-smolvla-eval-20260814",
            "model": "smolvla-state-conditioned-mediator-selector",
            "dataset": "r22p21-libero-lerobot-12000",
            "hardware": "2xa800-dedicated",
            "resource_pool": "exp-efficiency",
            "experiment_role": "selector-v2-operator-closed-loop-validation",
        }
    if evidence != expected_evidence:
        differing = sorted(
            key for key in set(evidence) | set(expected_evidence)
            if evidence.get(key) != expected_evidence.get(key)
        )
        raise Refused(f"R22-P21 selector-v2 SmolVLA evidence drifted: {differing}")
    if write_paths != expected_write_paths:
        raise Refused("R22-P21 selector-v2 SmolVLA write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R22-P21 selector-v2 SmolVLA requires application resume")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P21 selector-v2 SmolVLA forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "", "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0, "launcher_attempts": 1,
        "retry_sleep_seconds": 30, "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R22-P21 selector-v2 SmolVLA fault-tolerance contract drifted")
