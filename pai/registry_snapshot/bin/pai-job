    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R13-P05 Stage 2.5 worker drifted from verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R13P05_STAGE25_OUTPUT_ROOT:
        raise Refused("R13-P05 Stage 2.5 output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R13-P05 Stage 2.5 runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R13-P05 Stage 2.5 pod environment must remain empty")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R13-P05 Stage 2.5 must be submitted with --no-wandb")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R13-P05 Stage 2.5 requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R13-P05 Stage 2.5 identity must be 2254:2254")
    if runtime.get("identity_mechanism") != (
        "controller_inline_bootstrap_then_setpriv"
    ):
        raise Refused("R13-P05 Stage 2.5 identity mechanism drifted")
    try:
        launcher_path = R13P05_STAGE25_LAUNCHER.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R13-P05 Stage 2.5 launcher is missing: {exc}") from exc
    if (
        launcher_path != R13P05_STAGE25_LAUNCHER
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R13-P05 Stage 2.5 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != R13P05_STAGE25_LAUNCHER_SHA256:
        raise Refused("R13-P05 Stage 2.5 launcher hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R13-P05 Stage 2.5 command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R13-P05 Stage 2.5 command_file_sha256 drifted")
