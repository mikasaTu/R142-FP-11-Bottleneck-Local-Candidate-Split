def validate_r10p07_stage2_r2a_repair_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict) or not isinstance(submission, dict):
        raise Refused("R10-P07 Stage-2-R2A repair contract is missing")
    if evidence.get("kind") != R10P07_STAGE2_R2A_REPAIR_EVIDENCE_KIND:
        raise Refused("R10-P07 Stage-2-R2A repair evidence is unauthorized")
    if not isinstance(fault, dict):
        raise Refused("R10-P07 Stage-2-R2A repair fault contract is missing")
    if resolved.get("resource_alias") != R10P07_STAGE2_R2A_PREFLIGHT_RESOURCE_ALIAS:
        raise Refused("R10-P07 Stage-2-R2A repair requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R10-P07 Stage-2-R2A repair network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10-P07 Stage-2-R2A repair worker drifted")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R10P07_STAGE2_R2A_REPAIR_OUTPUT_ROOT:
        raise Refused("R10-P07 Stage-2-R2A repair output root drifted")
    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R10-P07 Stage-2-R2A repair runtime fields drifted")
    if runtime.get("pod_env") != {} or runtime.get("secret_env_names") != []:
        raise Refused("R10-P07 Stage-2-R2A repair forbids secrets and pod env")
    if "wandb_entity_contract" in runtime:
        raise Refused("R10-P07 Stage-2-R2A repair must not request W&B")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10-P07 Stage-2-R2A repair requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R10-P07 Stage-2-R2A repair identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R10-P07 Stage-2-R2A repair identity mechanism drifted")

    launcher_info = toolchain_config.get(
        "r10p07_stage2_r2a_preflight_repair_launcher"
    )
    if not isinstance(launcher_info, dict) or set(launcher_info) != {"file", "sha256"}:
        raise Refused("R10-P07 Stage-2-R2A repair launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R10-P07 Stage-2-R2A repair launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R10-P07 Stage-2-R2A repair launcher is not canonical")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R10-P07 Stage-2-R2A repair launcher hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R10-P07 Stage-2-R2A repair command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R10-P07 Stage-2-R2A repair command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R10-P07 Stage-2-R2A repair payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R10-P07 Stage-2-R2A repair launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_COMMIT={R10P07_STAGE2_R2A_REPAIR_SOURCE_COMMIT}",
        f"EXPECTED_TREE={R10P07_STAGE2_R2A_REPAIR_SOURCE_TREE}",
        "EXPECTED_SCRIPT_SHA=3e3b0ab537ca394a0a1a0b63a683c260d7d66bca0a7a0b590948caf54f4aa964",
        'FORMAL_SCRIPT="$PROJECT_ROOT/pai/stage2_r2a/r10p07_stage2_r2a_preflight_repair.sh"',
        'exec /usr/bin/env bash "$FORMAL_SCRIPT"',
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R10-P07 Stage-2-R2A repair binding drifted: {fragment}")
    run_id = str(resolved["run_id"])
    repair_root = R10P07_STAGE2_R2A_REPAIR_ROOT / run_id
    report_root = R10P07_STAGE2_R2A_REPAIR_REPORT_ROOT / run_id
    expected_evidence = {
        "kind": R10P07_STAGE2_R2A_REPAIR_EVIDENCE_KIND,
