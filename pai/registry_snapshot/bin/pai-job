        "validation_status": "passed_no_pai_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "FIRST_REAL_WORK.json"),
        "completed_evidence_path": str(artifact_dir / "PHASE3A_COMPLETE.json"),
        "contract_ready": True,
        "libero_source_commit": "2319dbd914673f6ef34a00584536212b10e10395",
        "libero_source_tree": "521638a78b1fe3a0a33066ef8e0e9d9f5b247e71",
        "formal_python_sha256": "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
        "formal_torch": "2.5.1+cu124",
        "model_seeds": [20260831, 20260901, 20260902],
        "pilot_trajectories": 15,
        "full_oof_trajectories": 90,
        "final_model_trajectories": 9,
        "pilot_epochs": 20,
        "full_oof_epochs": 40,
        "checkpoint_cadence": "complete_best_and_last_per_epoch_not_1000_optimizer_steps",
        "complete_state_resume": True,
        "application_resume_scope": (
            "model_optimizer_scheduler_rng_global_step plus atomic anchor and stage markers"
        ),
        "maximum_concurrent_gpus": 2,
        "scientific_gate_short_circuit": False,
        "final_reserve_outcomes": False,
        "wandb_mode": "online_exact_entity_one_run_per_trajectory_resume_same_lineage",
        "wandb_project": "r22-p10-phase3a-step5",
        "wandb_entity": "chen_jian-cj-workspace",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        differing = sorted(
            key for key in set(evidence) | set(expected_evidence)
            if evidence.get(key) != expected_evidence.get(key)
        )
        raise Refused(f"R22-P10 Phase-3A Step5 evidence drifted: {differing}")
    if write_paths != [
        str(artifact_dir),
        str(R22P10_PHASE3A_STEP5_WORK_ROOT),
        str(R22P10_PHASE3A_STEP5_LOG_ROOT),
        str(R22P10_PHASE3A_STEP5_CACHE_ROOT),
    ]:
        raise Refused("R22-P10 Phase-3A Step5 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R22-P10 Phase-3A Step5 requires application resume")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P10 Phase-3A Step5 forbids recursive ownership repair")
    if fault != {
