    output_mode: Any,
) -> None:
    """Validate the frozen Step6 paired true-replanning closed-loop job."""

    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R10P25 Step6 BCOR closed-loop evidence is missing")
    if evidence.get("kind") != R10P25_STEP6_BCOR_CLOSED_LOOP_EVIDENCE_KIND:
        raise Refused("R10P25 Step6 BCOR closed-loop evidence kind is not authorized")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R10P25 Step6 BCOR closed-loop requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R10P25 Step6 BCOR closed-loop network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10P25 Step6 BCOR closed-loop worker preset drifted")
    output_root = USER_ROOT / "logs" / "r10p25-step6-bcor-v1" / "pai-closed-loop"
    formal_root = USER_ROOT / "logs" / "r10p25-step6-bcor-v1" / "formal-closed-loop-v1"
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(str(storage.get("output_root", ""))) != output_root:
        raise Refused("R10P25 Step6 BCOR closed-loop output root drifted")
    if artifact_dir != output_root / str(resolved.get("run_id")):
        raise Refused("R10P25 Step6 BCOR closed-loop artifact directory drifted")
    if write_paths != [str(artifact_dir), str(formal_root)]:
        raise Refused("R10P25 Step6 BCOR closed-loop write paths drifted")
    if output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("R10P25 Step6 BCOR closed-loop requires fresh output_mode=new")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R10P25 Step6 BCOR closed-loop forbids recursive ownership repair")
    if runtime.get("pod_env") != {} or normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R10P25 Step6 BCOR closed-loop disables service secrets")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10P25 Step6 BCOR closed-loop requires base64 payload transport")

    expected_launcher = ROOT / "launchers" / "r10p25_step6_bcor_closed_loop_2xa800.sh"
    try:
        canonical_launcher = expected_launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R10P25 Step6 BCOR closed-loop launcher is missing: {exc}") from exc
    if (
        canonical_launcher != expected_launcher
        or expected_launcher.is_symlink()
        or not expected_launcher.is_file()
        or not os.access(expected_launcher, os.X_OK)
    ):
        raise Refused("R10P25 Step6 BCOR closed-loop launcher is not canonical/executable")
    launcher_sha = sha256(expected_launcher)
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("R10P25 Step6 BCOR closed-loop command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R10P25 Step6 BCOR closed-loop launcher payload drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R10P25 Step6 BCOR closed-loop launcher must be UTF-8") from exc
    bindings = {
        "source_commit": "520cbe62eacd96b5ec3a03445648c86eafffec94",
        "source_tree": "df4e86da3026599530d0c22e58cef87a480badc7",
        "formal_launcher_sha256": "a64c377d2563b62599b409c6ce7c9f0d189ddbcb40e590663c9d9c11e723fb5b",
        "registry_launcher_sha256": "149f3945a36f052cc1f4e3ed0b7408203f86bc903e9d90e69fc101b348f40c08",
        "closed_loop_prereg_sha256": "773e34dc6af5b5d508afb1197d6e35c823d16fe4dfdee60a201f311ed5c85098",
        "prospective_statistics_sha256": "ed04c65a0fd8c0d4b87f4c9c520bfdf579072455ebf8ca9e553039cc2c47fc2c",
    }
    for label, fragment in bindings.items():
        payload_bound = label == "registry_launcher_sha256" or fragment in payload_text
        if evidence.get(label) != fragment or not payload_bound:
            raise Refused(f"R10P25 Step6 BCOR closed-loop {label} binding drifted")
    expected_scalars = {
        "resource_contract": "dedicated_2gpu_v1",
        "pilot_rows": 540,
        "expansion_rows": 1500,
        "arms": 6,
        "true_rgb_proprio_replan_required": True,
        "offline_endpoint_reuse_allowed": False,
        "offline_gate_status": "STOP_R10P25_FAMILY",
        "interpretation_role": "NONCONFIRMATORY_OVERRIDE_AFTER_FAILED_OFFLINE_GATE",
        "failed_offline_gate_cannot_be_upgraded": True,
        "run_all_experiments_override": True,
        "application_resume_boundary": "fsync_after_each_episode_arm_jsonl",
        "spot_autoresume_pattern_applied": True,
        "platform_spot_enabled": False,
        "wandb_mode": "disabled_by_experiment_contract",
        "accepted": False,
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    for key, value in expected_scalars.items():
        if evidence.get(key) != value:
            raise Refused(f"R10P25 Step6 BCOR closed-loop evidence field drifted: {key}")
    if evidence.get("pilot_planner_seeds") != [101, 202, 303]:
        raise Refused("R10P25 Step6 BCOR closed-loop pilot seeds drifted")
    if evidence.get("expansion_planner_seeds") != [101, 202, 303, 404, 505]:
        raise Refused("R10P25 Step6 BCOR closed-loop expansion seeds drifted")
    if evidence.get("first_work_evidence_path") != str(
        formal_root / "closed_loop_pilot.rank_000.jsonl"
    ):
        raise Refused("R10P25 Step6 BCOR closed-loop first-work path drifted")
    if evidence.get("completed_evidence_path") != str(artifact_dir / "RUN_COMPLETE.json"):
        raise Refused("R10P25 Step6 BCOR closed-loop completion path drifted")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R10P25 Step6 BCOR closed-loop fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-and-evaluation",
        "task": "r10p25-step6-bcor-closed-loop-v1-20260816",
        "model": "frozen-dinowm-bcor-true-replan",
        "dataset": "pusht-step6-disjoint-closed-loop",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "step6-nonconfirmatory-true-replan",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R10P25 Step6 BCOR closed-loop submission contract drifted")


def validate_r10p25_step7_drcm_historical_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Validate the frozen Step7 label-blind historical-feature job."""

    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R10P25 Step7 DRCM evidence is missing")
    if evidence.get("kind") != R10P25_STEP7_DRCM_HISTORICAL_EVIDENCE_KIND:
        raise Refused("R10P25 Step7 DRCM evidence kind is not authorized")
    resource_alias = resolved.get("resource_alias")
    allowed_resources = {
        "exp-efficiency-a800-2gpu": ("dedicated_2gpu_v1", "exp-efficiency"),
        "exp-robot-r21p019-native5-2gpu": (
            "dedicated_exp_robot_2gpu_v1",
            "exp-robot",
        ),
    }
    if resource_alias not in allowed_resources:
        raise Refused("R10P25 Step7 DRCM requires a verified dedicated 2-GPU alias")
    expected_resource_contract, expected_resource_pool = allowed_resources[
        resource_alias
    ]
    if resolved.get("network") != {}:
        raise Refused("R10P25 Step7 DRCM network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10P25 Step7 DRCM worker preset drifted")
    output_root = USER_ROOT / "logs" / "r10p25-step7-drcm-v1" / "pai-historical-features"
    formal_root = USER_ROOT / "logs" / "r10p25-step7-drcm-v1" / "formal-historical-features-v1"
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(str(storage.get("output_root", ""))) != output_root:
        raise Refused("R10P25 Step7 DRCM output root drifted")
    if artifact_dir != output_root / str(resolved.get("run_id")):
        raise Refused("R10P25 Step7 DRCM artifact directory drifted")
    if write_paths != [str(artifact_dir), str(formal_root)]:
        raise Refused("R10P25 Step7 DRCM write paths drifted")
    if output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("R10P25 Step7 DRCM requires fresh output_mode=new")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R10P25 Step7 DRCM forbids recursive ownership repair")
    expected_secret_names = (
        []
        if resource_alias == "exp-efficiency-a800-2gpu"
        else ["WANDB_API_KEY", "WANDB_ENTITY"]
    )
    if runtime.get("pod_env") != {} or normalize_secret_env_names(
        runtime.get("secret_env_names")
    ) != expected_secret_names:
        raise Refused("R10P25 Step7 DRCM service-secret contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10P25 Step7 DRCM requires base64 payload transport")

    expected_launcher = ROOT / "launchers" / "r10p25_step7_drcm_historical_features_2xa800.sh"
    try:
        canonical_launcher = expected_launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R10P25 Step7 DRCM launcher is missing: {exc}") from exc
    if (
        canonical_launcher != expected_launcher
        or expected_launcher.is_symlink()
        or not expected_launcher.is_file()
        or not os.access(expected_launcher, os.X_OK)
    ):
        raise Refused("R10P25 Step7 DRCM launcher is not canonical/executable")
    launcher_sha = sha256(expected_launcher)
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("R10P25 Step7 DRCM command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R10P25 Step7 DRCM launcher payload drifted")
    payload_text = payload.decode("utf-8")
    bindings = {
        "source_commit": "3f196fcd02076a47aa9101303982a0e6ac88fba3",
        "source_tree": "3fdfb36eb06221d575e5af5a6d0a6b49a8887770",
        "formal_launcher_sha256": "91957a885e82208d9ed287e2c36b763913f8d20c8a42f5827f349a5bfbc39f20",
        "registry_launcher_sha256": "66bc141a9aacbed14220c2cec477bb6030b88f935844d28a9f197d7687e4e3e0",
        "prereg_sha256": "61369e771eb94e4a64d14776b2cda38d23f775aa9c8271bc386b181e8b06cd4b",
    }
    for label, fragment in bindings.items():
        payload_bound = label == "registry_launcher_sha256" or fragment in payload_text
        if evidence.get(label) != fragment or not payload_bound:
            raise Refused(f"R10P25 Step7 DRCM {label} binding drifted")
    expected_scalars = {
        "resource_contract": expected_resource_contract,
        "labels_or_outcomes_read_by_orbit_stage": False,
        "step5_and_step6_role": "historical_transfer_only",
        "wandb_mode": "disabled_by_experiment_contract",
        "accepted": False,
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    for key, value in expected_scalars.items():
        if evidence.get(key) != value:
            raise Refused(f"R10P25 Step7 DRCM evidence field drifted: {key}")
    if evidence.get("first_work_evidence_path") != str(
        formal_root / "development_boundary_features.rank_000.parquet"
    ):
        raise Refused("R10P25 Step7 DRCM first-work path drifted")
    if evidence.get("completed_evidence_path") != str(artifact_dir / "RUN_COMPLETE.json"):
        raise Refused("R10P25 Step7 DRCM completion path drifted")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R10P25 Step7 DRCM fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-and-evaluation",
        "task": "r10p25-step7-drcm-historical-features-v1-20260818",
        "model": "frozen-dinowm-drcm",
        "dataset": "pusht-steps4-6-frozen-banks",
        "hardware": "2xa800-dedicated",
        "resource_pool": expected_resource_pool,
        "experiment_role": "step7-historical-label-blind-features",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R10P25 Step7 DRCM submission contract drifted")


