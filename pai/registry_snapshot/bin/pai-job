        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10P25 Step7 prospective worker preset drifted")
    output_root = USER_ROOT / "logs" / "r10p25-step7-drcm-v1" / "pai-prospective-features"
