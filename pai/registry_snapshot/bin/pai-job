def validate_r22p10_libero_phase2r_bank_b_finalize_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    provenance = resolved.get("provenance")
    if not all(isinstance(value, dict) for value in (evidence, submission, fault, provenance)):
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize sections are missing")
    if evidence.get("kind") != R22P10_LIBERO_PHASE2R_BANK_B_FINALIZE_EVIDENCE_KIND:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize kind is not authorized")
    if resolved.get("resource_alias") != R22P10_LIBERO_PHASE1_RESOURCE_ALIAS:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize requires the 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize network must be empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize worker drifted")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(str(storage.get("output_root", ""))) != R22P10_LIBERO_PHASE2R_OUTPUT_ROOT:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize output root drifted")

    expected_runtime_fields = {
        "canary_nonce", "command", "command_file", "command_file_sha256",
        "create_artifact_dir", "gid", "identity_mechanism", "output_mode",
        "payload_base64", "payload_sha256", "payload_transport", "pod_env",
        "recursive_repair", "secret_env_names", "uid", "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize public env drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != ["WANDB_API_KEY", "WANDB_ENTITY"]:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize requires W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize W&B contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize requires base64 payload")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize identity mechanism drifted")

    launcher_info = toolchain_config.get("r22p10_libero_phase2r_bank_b_finalize_launcher")
    if not isinstance(launcher_info, dict) or set(launcher_info) != {"file", "sha256"}:
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B finalize launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P10 LIBERO Phase-2R Bank-B finalize launcher missing: {exc}") from exc
    if canonical_launcher != launcher_path or launcher_path.is_symlink() or not launcher_path.is_file() or not os.access(launcher_path, os.X_OK):
