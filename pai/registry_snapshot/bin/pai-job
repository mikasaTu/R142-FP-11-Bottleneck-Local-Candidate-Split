        "run_formal_sha256": "73664fac487772ca6264173ac2e4e5c8da97c531f6f5f0d68b700b17c82b0c9a",
        "stage_d1_protocol_sha256": "1698467c632bc853b3d7c2a443e006871b64ece68b2042c51933bf806baea38c",
