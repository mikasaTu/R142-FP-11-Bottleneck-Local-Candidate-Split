    if evidence.get("kind") != R10P25_STEP5_OCAC_DEVELOPMENT_EVIDENCE_KIND:
        raise Refused("R10P25 Step5 OCAC evidence kind is not authorized")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
