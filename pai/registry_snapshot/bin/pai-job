def validate_r21p019_libero_staged2_profile(
    *, resolved: Dict[str, Any], toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any], payload: bytes, write_paths: List[str],
    artifact_dir: Path, output_mode: Any,
) -> None:
    evidence=resolved.get("evidence", {})
    if evidence.get("kind") != R21P019_LIBERO_STAGED2_EVIDENCE_KIND:
        raise Refused("R21-P019 Stage-D2 evidence kind drifted")
    if resolved.get("resource_alias") != "exp-robot-r21p019-native5-2gpu" or resolved.get("network") != {}:
        raise Refused("R21-P019 Stage-D2 resource/network drifted")
    expected_worker={"count":1,"image":"dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-py311-cu121-ubuntu22.04","gpu":2,"cpu":12,"memory":"200Gi","shared_memory":"200Gi"}
    if resolved.get("worker") != expected_worker: raise Refused("R21-P019 Stage-D2 worker drifted")
    storage=resolved.get("storage", {})
    if Path(str(storage.get("output_root", ""))) != R21P019_LIBERO_STAGED2_OUTPUT_ROOT:
        raise Refused("R21-P019 Stage-D2 output root drifted")
    if artifact_dir.name != "r21p019-staged2-20260818-v17": raise Refused("R21-P019 Stage-D2 run id drifted")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254 or runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R21-P019 Stage-D2 identity drifted")
    if runtime.get("pod_env") != {} or runtime.get("secret_env_names") != ["WANDB_API_KEY", "WANDB_ENTITY"]:
        raise Refused("R21-P019 Stage-D2 W&B secret contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64 or write_paths != [str(artifact_dir)]:
        raise Refused("R21-P019 Stage-D2 payload/write contract drifted")
    info=toolchain_config.get("r21p019_libero_staged2_launcher")
    if not isinstance(info, dict) or set(info) != {"file","sha256"}: raise Refused("R21-P019 Stage-D2 launcher pin missing")
    launcher=ROOT/str(info["file"])
    if not launcher.is_file() or launcher.is_symlink() or not os.access(launcher, os.X_OK): raise Refused("R21-P019 Stage-D2 launcher invalid")
    launcher_sha=sha256(launcher)
    if launcher_sha != info["sha256"] or runtime.get("command_file") != str(launcher) or runtime.get("command_file_sha256") != launcher_sha or runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R21-P019 Stage-D2 launcher/payload hash drifted")
    text=payload.decode("utf-8")
    for fragment in (
        "PROJECT_ROOT=/mnt/cpfs/zbl-cpfs-new/USERS/leon/code/r21-p019-stage-d2-20260818",
        "EXPECTED_RUN_ID=r21p019-staged2-20260818-v17",
        f"EXPECTED_SOURCE_COMMIT={R21P019_LIBERO_STAGED2_SOURCE_COMMIT}",
        f"EXPECTED_SOURCE_TREE={R21P019_LIBERO_STAGED2_SOURCE_TREE}",
        "rev-parse 'stage-d2-formal-source-v10^{commit}'",
        "export WANDB_PROJECT=r21p019-stage-d2 WANDB_MODE=online",
        'if [[ -f "$ARTIFACT_DIR/STAGE_D2_COMPLETE.json" ]]',
    ):
        if text.count(fragment) != 1: raise Refused("R21-P019 Stage-D2 launcher binding drifted: "+fragment)
    required={"source_commit":R21P019_LIBERO_STAGED2_SOURCE_COMMIT,"source_tree":R21P019_LIBERO_STAGED2_SOURCE_TREE,
              "stage_d2_protocol_sha256":"9dc153a1c171be6b00aa1f5421e9038506a6837829533121c2a4367b43193b96",
              "run_formal_sha256":"83f7d01a4f158a128fc73b1f2894ec6b70ae56cc7c6af43d1a65e7945fb73a80",
              "maximum_a800_gpus":2,"retrospective_closed_loop_episodes":750,"heldout_closed_loop_episodes":600,
              "bootstrap_replicates":10000,"all_matrices_continue_if_gate_fails":True,"pai_probe_created":False,
              "wandb_entity":"chen_jian-cj-workspace","wandb_project":"r21p019-stage-d2","contract_ready":True}
    for key,value in required.items():
        if evidence.get(key) != value: raise Refused("R21-P019 Stage-D2 evidence drifted: "+key)
    submission=resolved.get("submission", {});fault=resolved.get("fault_tolerance", {})
    if submission.get("priority") != 9 or submission.get("job_max_running_time_minutes") != 0:
        raise Refused("R21-P019 Stage-D2 submission drifted")
    if fault.get("pai_automatic_fault_tolerance") is not False or fault.get("maximum_platform_restarts") != 0 or fault.get("launcher_attempts") != 1:
        raise Refused("R21-P019 Stage-D2 fault tolerance drifted")


