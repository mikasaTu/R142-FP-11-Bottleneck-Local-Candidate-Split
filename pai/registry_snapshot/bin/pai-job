    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R10-P07 Stage-2-R2A formal-data runtime fields drifted")
    if runtime.get("pod_env") != {} or runtime.get("secret_env_names") != []:
        raise Refused("R10-P07 Stage-2-R2A formal data forbids secrets and pod env")
    if "wandb_entity_contract" in runtime:
        raise Refused("R10-P07 Stage-2-R2A formal data must not request W&B")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10-P07 Stage-2-R2A formal data requires base64 payload")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R10-P07 Stage-2-R2A formal-data identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R10-P07 Stage-2-R2A formal-data identity mechanism drifted")

    launcher_info = toolchain_config.get("r10p07_stage2_r2a_formal_data_launcher")
    if not isinstance(launcher_info, dict) or set(launcher_info) != {"file", "sha256"}:
        raise Refused("R10-P07 Stage-2-R2A formal-data launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R10-P07 Stage-2-R2A formal-data launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R10-P07 Stage-2-R2A formal-data launcher is not canonical")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R10-P07 Stage-2-R2A formal-data launcher hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R10-P07 Stage-2-R2A formal-data command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R10-P07 Stage-2-R2A formal-data command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R10-P07 Stage-2-R2A formal-data payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R10-P07 Stage-2-R2A formal-data launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_COMMIT={R10P07_STAGE2_R2A_EXECUTION_SOURCE_COMMIT}",
        f"EXPECTED_TREE={R10P07_STAGE2_R2A_EXECUTION_SOURCE_TREE}",
        "EXPECTED_SCRIPT_SHA=896ffc6a7cbece7620260ff79d454b64658841b9dd1d343420af7e36319cba36",
        "EXPECTED_PREFLIGHT_SHA=c54dcb22f666c48c79eeeaffd22f2090f98829f52771ca76b024a9a5b5038e96",
        'FORMAL_SCRIPT="$PROJECT_ROOT/pai/stage2_r2a/r10p07_stage2_r2a_formal_data.sh"',
        'export R10P07_PREFLIGHT_REPORT="$PREFLIGHT_REPORT"',
        'exec /usr/bin/env bash "$FORMAL_SCRIPT"',
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R10-P07 Stage-2-R2A formal-data binding drifted: {fragment}")

    expected_evidence = {
        "kind": R10P07_STAGE2_R2A_FORMAL_DATA_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "certification_collection_and_data_build",
        "task_id": "r10p07-stage2-r2a-formal-data-20260814",
        "model_id": "mikasa-canonical-pd-ee-plus-frozen-dinov2",
        "success_gate": "persisted_first_formal_row_then_complete_attempted_candidate_and_episode_matrix",
        "validation_method": "frozen_preregistration+exact_source_pin+application_resume",
        "validation_status": "exploratory_upstream_preflight_failed_user_override",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "FIRST_WORK.json"),
        "completed_evidence_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
        "collection_root": str(R10P07_STAGE2_R2A_FORMAL_COLLECTION_ROOT),
        "result_root": str(R10P07_STAGE2_R2A_FORMAL_RESULT_ROOT),
        "certification_root": str(R10P07_STAGE2_R2A_CERTIFICATION_ROOT),
        "data_root": str(R10P07_STAGE2_R2A_DATA_ROOT),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R10P07_STAGE2_R2A_EXECUTION_SOURCE_COMMIT,
        "source_tree": R10P07_STAGE2_R2A_EXECUTION_SOURCE_TREE,
        "launcher_sha256": launcher_sha,
        "formal_script_sha256": "896ffc6a7cbece7620260ff79d454b64658841b9dd1d343420af7e36319cba36",
        "preflight_report_sha256": "c54dcb22f666c48c79eeeaffd22f2090f98829f52771ca76b024a9a5b5038e96",
        "preregistration_sha256": "45f9cbaf6816ead6b005437ad3a6a0520b23c607fb052036de596046c869b424",
        "allocated_gpu_count": 2,
        "maximum_concurrent_collectors": 2,
        "visible_gpu_count_per_collector": 1,
        "user_authorized_gpu_range": [2, 8],
        "certification_episode_target": 216,
        "formal_episode_target": 474,
        "formal_support_target": 156,
        "formal_query_target": 318,
        "frozen_fallback_noise_linf_rad": 0.0001,
        "scientific_validity": "exploratory_upstream_preflight_failed",
        "scientific_gate_does_not_control_job_completion": True,
        "platform_fault_tolerance": False,
        "application_autoresume": True,
        "checkpointing": "episode_row_atomic_commit",
        "wandb_mode": "disabled_collection_only",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R10-P07 Stage-2-R2A formal-data exact evidence drifted")
    if write_paths != [
        str(artifact_dir),
        str(R10P07_STAGE2_R2A_FORMAL_COLLECTION_ROOT),
        str(R10P07_STAGE2_R2A_FORMAL_RESULT_ROOT),
        str(R10P07_STAGE2_R2A_CERTIFICATION_ROOT),
        str(R10P07_STAGE2_R2A_DATA_ROOT),
    ]:
        raise Refused("R10-P07 Stage-2-R2A formal-data write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R10-P07 Stage-2-R2A formal data requires resumable output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R10-P07 Stage-2-R2A formal data forbids recursive repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R10-P07 Stage-2-R2A formal-data fault contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-exploratory-data-generation",
        "task": "r10p07-stage2-r2a-formal-data-20260814",
        "model": "mikasa-pd-ee-dinov2-data-pipeline",
        "dataset": "mikasa-r2a-canonical-episodic-resume",
        "hardware": "2xa800-dedicated-two-collectors",
        "resource_pool": "exp-efficiency",
        "experiment_role": "stage2-r2a-full-matrix-after-failed-preflight",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R10-P07 Stage-2-R2A formal-data submission drifted")


def validate_r10p07_stage2_r2a_train_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict) or not isinstance(submission, dict):
        raise Refused("R10-P07 Stage-2-R2A train/eval contract is missing")
    evidence_kind = evidence.get("kind")
    if evidence_kind not in {
        R10P07_STAGE2_R2A_SMOKE_EVIDENCE_KIND,
        R10P07_STAGE2_R2A_PILOT_EVIDENCE_KIND,
    }:
        raise Refused("R10-P07 Stage-2-R2A train/eval evidence is unauthorized")
    phase = (
        "smoke"
        if evidence_kind == R10P07_STAGE2_R2A_SMOKE_EVIDENCE_KIND
        else "pilot"
    )
    if not isinstance(fault, dict):
        raise Refused("R10-P07 Stage-2-R2A train/eval fault contract is missing")
    if resolved.get("resource_alias") != R10P07_STAGE2_R2A_PREFLIGHT_RESOURCE_ALIAS:
        raise Refused("R10-P07 Stage-2-R2A train/eval requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R10-P07 Stage-2-R2A train/eval network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10-P07 Stage-2-R2A train/eval worker drifted")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R10P07_STAGE2_R2A_TRAIN_OUTPUT_ROOT:
        raise Refused("R10-P07 Stage-2-R2A train/eval output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R10-P07 Stage-2-R2A train/eval runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R10-P07 Stage-2-R2A train/eval public pod env drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused("R10-P07 Stage-2-R2A train/eval requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R10-P07 Stage-2-R2A train/eval W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10-P07 Stage-2-R2A train/eval requires base64 payload")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R10-P07 Stage-2-R2A train/eval identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R10-P07 Stage-2-R2A train/eval identity mechanism drifted")

    launcher_key = f"r10p07_stage2_r2a_{phase}_launcher"
    launcher_info = toolchain_config.get(launcher_key)
    if not isinstance(launcher_info, dict) or set(launcher_info) != {"file", "sha256"}:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused(f"R10-P07 Stage-2-R2A {phase} launcher is not canonical")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused(f"R10-P07 Stage-2-R2A {phase} launcher hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused(f"R10-P07 Stage-2-R2A {phase} command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_COMMIT={R10P07_STAGE2_R2A_EXECUTION_SOURCE_COMMIT}",
        f"EXPECTED_TREE={R10P07_STAGE2_R2A_EXECUTION_SOURCE_TREE}",
        "EXPECTED_SCRIPT_SHA=c4c4d8dd6fcbc1844ee4da0e9f66e17b5f1b20324d14a496c02c5ff155b64949",
        'FORMAL_SCRIPT="$PROJECT_ROOT/pai/stage2_r2a/r10p07_stage2_r2a_train_eval.sh"',
        f"export R10P07_R2A_PHASE={phase}",
        'exec /usr/bin/env bash "$FORMAL_SCRIPT"',
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R10-P07 Stage-2-R2A {phase} binding drifted: {fragment}")

    result_root = R10P07_STAGE2_R2A_RESULT_BASE / phase
    checkpoint_root = R10P07_STAGE2_R2A_CHECKPOINT_BASE / phase
    common_evidence = {
        "kind": evidence_kind,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "training_and_closed_loop_control_evaluation",
        "task_id": f"r10p07-stage2-r2a-{phase}-20260814",
        "model_id": "parameter-matched-lerobot-act-obs-graph-memory",
        "first_work_evidence_path": str(artifact_dir / "FIRST_WORK.json"),
        "completed_evidence_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
        "data_root": str(R10P07_STAGE2_R2A_DATA_ROOT),
        "result_root": str(result_root),
        "checkpoint_root": str(checkpoint_root),
        "source_commit": R10P07_STAGE2_R2A_EXECUTION_SOURCE_COMMIT,
        "source_tree": R10P07_STAGE2_R2A_EXECUTION_SOURCE_TREE,
        "launcher_sha256": launcher_sha,
        "formal_script_sha256": "c4c4d8dd6fcbc1844ee4da0e9f66e17b5f1b20324d14a496c02c5ff155b64949",
        "preregistration_sha256": "45f9cbaf6816ead6b005437ad3a6a0520b23c607fb052036de596046c869b424",
        "allocated_gpu_count": 2,
        "maximum_concurrent_trainers": 2,
        "visible_gpu_count_per_trainer": 1,
        "user_authorized_gpu_range": [2, 8],
        "training_seed": 2026081407,
        "checkpoint_cadence_steps": 1000,
        "retrievers": [f"R{index}" for index in range(10)],
        "controls": [f"C{index}" for index in range(12)],
        "scientific_gate_does_not_control_job_completion": True,
        "platform_fault_tolerance": False,
        "application_autoresume": True,
        "retention_contract": "all_10000_milestones_plus_latest_3_complete_nonmilestones",
        "wandb_mode": "online_exact_entity_resume_same_lineage",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if phase == "smoke":
        common_evidence.update(
            {
                "success_gate": "all_frozen_smoke_gates_reported_without_skipping",
                "validation_method": "frozen_preregistration+runtime_smoke+paired_exact_snapshot_evaluator",
                "validation_status": "exploratory_upstream_preflight_failed_user_override",
                "config_sha256": "f637b1cbcde2e015c1eb5bf13c8497f8beb53d3d56cc993b98d8b927480ac826",
                "training_steps_per_model": 5000,
                "scientific_validity": "exploratory_upstream_preflight_failed",
                "pilot_runs_regardless_of_smoke_gate": True,
            }
        )
    else:
        common_evidence.update(
            {
                "success_gate": "all_frozen_pilot_metrics_retrievers_and_controls_reported_without_skipping",
                "validation_method": "frozen_preregistration+paired_exact_snapshot_evaluator+paired_bootstrap",
                "validation_status": "exploratory_upstream_gates_do_not_stop_user_required_matrix",
                "config_sha256": "e1e12a3467cbad7e6500353b0a1edfe3efbb6a34157ee02b8fbd2b9f72aaf12b",
                "training_steps_per_model": 50000,
                "scientific_validity": "exploratory_upstream_preflight_and_smoke_gates_do_not_stop_execution",
                "submitted_regardless_of_smoke_gate": True,
            }
        )
    if evidence != common_evidence:
        differing = sorted(
            key
            for key in set(evidence) | set(common_evidence)
            if evidence.get(key) != common_evidence.get(key)
        )
        raise Refused(f"R10-P07 Stage-2-R2A {phase} evidence drifted: {differing}")
    if write_paths != [str(artifact_dir), str(checkpoint_root), str(result_root)]:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} requires resumable output")
    if runtime.get("recursive_repair") is not False:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} forbids recursive repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} fault contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": f"formal-exploratory-{phase}",
        "task": f"r10p07-stage2-r2a-{phase}-20260814",
        "model": "lerobot-act-obs-graph-memory",
        "dataset": "mikasa-r2a-canonical-episodic-resume",
        "hardware": "2xa800-dedicated-two-independent-trainers",
        "resource_pool": "exp-efficiency",
        "experiment_role": (
            "stage2-r2a-full-matrix-after-failed-preflight"
            if phase == "smoke"
            else "stage2-r2a-full-matrix-after-failed-gates"
        ),
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused(f"R10-P07 Stage-2-R2A {phase} submission drifted")


def validate_r10p07_stage2_r3a_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict) or not isinstance(submission, dict):
        raise Refused("R10-P07 Stage-2-R3A contract is missing")
    if not isinstance(fault, dict):
        raise Refused("R10-P07 Stage-2-R3A fault contract is missing")
    if evidence.get("kind") != R10P07_STAGE2_R3A_EVIDENCE_KIND:
        raise Refused("R10-P07 Stage-2-R3A evidence kind is unauthorized")
    if resolved.get("resource_alias") != R10P07_STAGE2_R3A_RESOURCE_ALIAS:
        raise Refused("R10-P07 Stage-2-R3A requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R10-P07 Stage-2-R3A network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10-P07 Stage-2-R3A worker drifted")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R10P07_STAGE2_R3A_OUTPUT_ROOT:
        raise Refused("R10-P07 Stage-2-R3A output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R10-P07 Stage-2-R3A runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R10-P07 Stage-2-R3A public pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused("R10-P07 Stage-2-R3A requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R10-P07 Stage-2-R3A W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10-P07 Stage-2-R3A requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R10-P07 Stage-2-R3A identity must be 2254:2254")
    if runtime.get("identity_mechanism") != (
        "controller_inline_bootstrap_then_setpriv"
    ):
        raise Refused("R10-P07 Stage-2-R3A identity mechanism drifted")

