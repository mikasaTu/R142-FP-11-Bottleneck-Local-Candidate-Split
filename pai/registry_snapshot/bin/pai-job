        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R22-P10 LIBERO Phase-1 worker must equal the verified preset")

    output_root = (
        R22P10_LIBERO_PHASE1_TRAIN_OUTPUT_ROOT
        if is_training
        else R22P10_LIBERO_PHASE1B_EVAL_OUTPUT_ROOT
        if is_phase1b
        else R22P10_LIBERO_PHASE1_EVAL_OUTPUT_ROOT
    )
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != output_root:
        raise Refused("R22-P10 LIBERO Phase-1 output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R22-P10 LIBERO Phase-1 runtime fields drifted")
    if runtime.get("pod_env") != {} or runtime.get("secret_env_names") != []:
        raise Refused("R22-P10 LIBERO Phase-1 explicitly disables W&B/job env")
    if "wandb_entity_contract" in runtime:
        raise Refused("R22-P10 LIBERO Phase-1 must not request W&B credentials")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P10 LIBERO Phase-1 requires base64 payload transport")

    toolchain_key = (
        "r22p10_libero_phase1_train_launcher"
        if is_training
        else "r22p10_libero_phase1b_eval_launcher"
        if is_phase1b
        else "r22p10_libero_phase1_eval_launcher"
    )
    launcher_info = toolchain_config.get(toolchain_key)
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("R22-P10 LIBERO Phase-1 pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P10 LIBERO Phase-1 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R22-P10 LIBERO Phase-1 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R22-P10 LIBERO Phase-1 launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R22-P10 LIBERO Phase-1 command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R22-P10 LIBERO Phase-1 frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R22-P10 LIBERO Phase-1 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P10 LIBERO Phase-1 launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_SOURCE_COMMIT={source_commit}",
        f"EXPECTED_SOURCE_TREE={source_tree}",
        "EXPECTED_LIBERO_COMMIT=2319dbd914673f6ef34a00584536212b10e10395",
        "test \"${PAI_CANARY_EXPECTED_GPUS:-}\" = 2",
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R22-P10 LIBERO Phase-1 payload binding drifted: {fragment}")

    common_evidence = {
        "kind": evidence_kind,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "training" if is_training else "evaluation",
        "task_id": (
            "r22p10-libero-phase1-small-bc-20260812"
            if is_training
            else "r22p10-libero-phase1-token-causality-20260812"
        ),
        "model_id": (
            "state-chunk-bc-w256-d4-c10-e5"
            if is_training
            else "state-chunk-bc-checkpoint-grid"
        ),
        "success_gate": (
            "persisted_step_and_loss"
            if is_training
            else "persisted_completed_evaluation_result"
        ),
        "validation_method": (
            "static+dev14_cpu_contract+single_batch_gpu_smoke"
            if is_training
            else "static+dev14_cpu_deterministic_replay_contract"
        ),
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": (
            str(
                R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT
                / "push_the_plate_to_the_front_of_the_stove"
                / "FIRST_WORK.json"
            )
            if is_training
            else str(
                artifact_dir
                / "evaluation"
                / "push_the_plate_to_the_front_of_the_stove"
                / "FIRST_COMPLETED_ROLLOUT.json"
            )
        ),
        "completed_evidence_path": str(
            artifact_dir
            / ("TRAINING_COMPLETE.json" if is_training else "EVALUATION_COMPLETE.json")
        ),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": source_commit,
        "source_tree": source_tree,
        "libero_source_commit": "2319dbd914673f6ef34a00584536212b10e10395",
        "libero_source_tree": "521638a78b1fe3a0a33066ef8e0e9d9f5b247e71",
        "launcher_sha256": launcher_sha,
        "formal_python_sha256": (
            "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a"
        ),
        "formal_torch": "2.5.1+cu124",
        "overlay_manifest_sha256": (
            "64dfffdaf464d1a37be19b038cca919a252dba573eb2d0f8aa442b91a4099459"
        ),
        "overlay_file_count": 1688,
        "checkpoint_root": str(R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT),
        "chunk_size": 10,
        "execution_prefix": 5,
        "gpu_execution": "gpu0_push_plus_gpu1_drawer_then_gpu0_wine",
        "wandb_mode": "disabled_task_local_jsonl_v1",
        "experiment_scope": (
            "preliminary_small_bc_only"
            if is_training
            else "preliminary_not_formal_go"
        ),
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if is_phase1b:
        common_evidence = {
            "kind": evidence_kind,
            "resource_contract": "dedicated_2gpu_v1",
            "workload_type": "evaluation",
            "task_id": "r22p10-libero-phase1b-temporal-segment-20260813",
            "model_id": "frozen-state-chunk-bc-three-task",
            "success_gate": "persisted_completed_evaluation_result",
            "validation_method": "static+dev14_real_libero_cpu_smoke",
            "validation_status": "passed_no_pai_probe",
            "pai_probe_created": False,
            "first_work_evidence_path": str(artifact_dir / "FIRST_RESUMED_COMPLETED_CELL.json"),
            "completed_evidence_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
            "contract_ready": True,
            "mount_contract": "exact_five_new_root_sources_from_live_readback",
            "source_commit": source_commit,
            "source_tree": source_tree,
            "launcher_sha256": launcher_sha,
            "libero_source_commit": "2319dbd914673f6ef34a00584536212b10e10395",
            "libero_source_tree": "521638a78b1fe3a0a33066ef8e0e9d9f5b247e71",
            "formal_python_sha256": "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
            "formal_torch": "2.5.1+cu124",
            "overlay_manifest_sha256": "64dfffdaf464d1a37be19b038cca919a252dba573eb2d0f8aa442b91a4099459",
            "overlay_file_count": 1688,
            "checkpoint_root": str(R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT),
            "calibration_failures": 30,
            "formal_failures": 150,
            "clean_controls": 30,
            "proposals_per_family": 60,
            "families": 6,
            "formal_parallel_shards_per_task": 4,
            "durability_contract": "native_per_anchor_per_family_atomic_jsonl_and_done_markers",
            "wandb_mode": "disabled_task_local_artifacts_v1",
            "expected_first_work_uid": 2254,
            "expected_first_work_gid": 2254,
        }
    if is_training:
        common_evidence.update(
            {
                "demo_sha256": {
                    "push": "36b4e1bced49d2f4ff6b2fce6b1596a63978e14199e2513cd0df71e127bf47a6",
                    "drawer": "1b50d99a053a7e4547c9ae9ccd2e3cd762543d27be78f240f13440d7ae487ae8",
                    "wine": "f9092aa70734fc4083e97fc58c3ba25f87c614d18326182ddc7a455f0ab4da2e",
                },
                "checkpoint_cadence_steps": 2000,
                "full_state_resume": True,
                "max_steps_per_task": 12000,
                "batch_size_per_process": 256,
                "tasks": [
                    "push_the_plate_to_the_front_of_the_stove",
                    "open_the_top_drawer_and_put_the_bowl_inside",
                    "put_the_wine_bottle_on_the_rack",
                ],
            }
        )
    elif not is_phase1b:
        common_evidence.update(
            {
                "checkpoint_steps": [2000, 4000, 6000, 8000, 10000, 12000],
                "baseline_fixed_seeds_per_checkpoint": 20,
                "baseline_selection_band": [0.45, 0.9],
                "controlled_episodes_per_task": 5,
                "natural_failures_per_task_max": 5,
                "natural_directions_per_token": 8,
                "environment_seed_rule": (
                    "base_seed_plus_seed_index_before_every_reset"
                ),
                "phase_contract": (
                    "robot_goal_contact_or_ee_distance_not_support_contact"
                ),
                "successful_point_contract": (
                    "exclude_final_chunk_require_full_execution_prefix"
                ),
                "snapshot_contract": (
                    "mujoco_mjSTATE_INTEGRATION_plus_controller_"
                    "interpolator_gripper_plus_model_fixture_pose"
                ),
            }
        )
    if evidence != common_evidence:
        raise Refused("R22-P10 LIBERO Phase-1 exact evidence contract drifted")

    expected_write_paths = [str(artifact_dir)]
    if is_training:
        expected_write_paths.append(str(R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT))
    elif is_phase1b:
        expected_write_paths.append(
            str(
                R22P10_LIBERO_PHASE1B_EVAL_OUTPUT_ROOT
                / "r22p10-libero-p1b-eval-20260813-b"
            )
        )
    if write_paths != expected_write_paths:
        raise Refused("R22-P10 LIBERO Phase-1 write paths drifted")
    if is_training or is_phase1b:
        if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
            raise Refused("R22-P10 resumable workload requires application output resume")
    elif output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("R22-P10 evaluation requires a fresh artifact directory")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P10 LIBERO Phase-1 forbids recursive ownership repair")

    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R22-P10 LIBERO Phase-1 fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training" if is_training else "formal-evaluation",
        "task": (
            "r22p10-libero-phase1-small-bc-20260812"
            if is_training
            else "r22p10-libero-phase1-token-causality-20260812"
        ),
        "model": (
            "state-chunk-bc-w256-d4-c10-e5"
            if is_training
            else "state-chunk-bc-checkpoint-grid"
        ),
        "dataset": "libero-goal-three-task-locked",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "preliminary-token-causality-qualification",
    }
    if is_phase1b:
        expected_tags = {
            "managed_by": "pai-job-registry",
            "purpose": "formal-evaluation",
            "task": "r22p10-libero-phase1b-temporal-segment-20260813",
            "model": "frozen-state-chunk-bc-three-task",
            "dataset": "libero-goal-three-task-locked",
            "hardware": "2xa800-dedicated",
            "resource_pool": "exp-efficiency",
            "experiment_role": "natural-failure-temporal-segment-qualification",
        }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R22-P10 LIBERO Phase-1 submission contract drifted")


def validate_r13p05_stage25_full_profile(
    *,
    resolved: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    try:
        template_path = R13P05_STAGE25_FULL_TEMPLATE.resolve(strict=True)
        launcher_path = R13P05_STAGE25_FULL_LAUNCHER.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R13-P05 Stage 2.5 full contract file is missing: {exc}") from exc
    if (
        template_path != R13P05_STAGE25_FULL_TEMPLATE
        or template_path.is_symlink()
        or sha256(template_path) != R13P05_STAGE25_FULL_TEMPLATE_SHA256
    ):
        raise Refused("R13-P05 Stage 2.5 full template hash drifted")
    if (
        launcher_path != R13P05_STAGE25_FULL_LAUNCHER
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
        or sha256(launcher_path) != R13P05_STAGE25_FULL_LAUNCHER_SHA256
    ):
        raise Refused("R13-P05 Stage 2.5 full launcher hash/executable drifted")
    template = json.loads(template_path.read_text(encoding="utf-8"))
    evidence = resolved.get("evidence")
    expected_evidence = dict(template["evidence"])
    expected_evidence["completed_evidence_path"] = str(
        artifact_dir / "EVALUATION_COMPLETE.json"
    )
    if evidence != expected_evidence:
        raise Refused("R13-P05 Stage 2.5 full evidence contract drifted")
    if resolved.get("resource_alias") != R13P05_STAGE25_RESOURCE_ALIAS:
        raise Refused("R13-P05 Stage 2.5 full run requires the verified 2-GPU alias")
    for field in ("network", "worker", "fault_tolerance", "submission"):
        if resolved.get(field) != template[field]:
            raise Refused(f"R13-P05 Stage 2.5 full {field} contract drifted")
    if resolved.get("storage") != template["storage"]:
        raise Refused("R13-P05 Stage 2.5 full storage contract drifted")
    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R13-P05 Stage 2.5 full runtime fields drifted")
    if runtime.get("pod_env") != {} or normalize_secret_env_names(
        runtime.get("secret_env_names")
    ) != []:
        raise Refused("R13-P05 Stage 2.5 full run requires --no-wandb and no pod secrets")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R13-P05 Stage 2.5 full identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R13-P05 Stage 2.5 full identity mechanism drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R13-P05 Stage 2.5 full payload transport drifted")
    launcher_sha = sha256(launcher_path)
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R13-P05 Stage 2.5 full command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R13-P05 Stage 2.5 full command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R13-P05 Stage 2.5 full decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R13-P05 Stage 2.5 full launcher must be UTF-8") from exc
    for fragment in (
        "EXPECTED_BASE_COMMIT=d5d2a48a3384d66d028686a753576f5538707717",
        "SCIENCE=/mnt/cpfs/zbl-cpfs-new/dataset/leon/artifacts/r13p05/stage25/kinetix-full-v1",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        "CUDA_VISIBLE_DEVICES=0 JAX_PLATFORMS=cuda",
        "CUDA_VISIBLE_DEVICES=1 JAX_PLATFORMS=cuda",
        "export WANDB_MODE=disabled",
    ):
        if payload_text.count(fragment) < 1:
            raise Refused(f"R13-P05 Stage 2.5 full payload binding drifted: {fragment}")
    expected_write_paths = [str(artifact_dir), str(R13P05_STAGE25_FULL_SCIENCE_ROOT)]
    if write_paths != expected_write_paths:
        raise Refused("R13-P05 Stage 2.5 full write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R13-P05 Stage 2.5 full run requires atomic resume output mode")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R13-P05 Stage 2.5 full run forbids recursive ownership repair")


def validate_r13p05_stage3b_phase1_profile(
    *,
    resolved: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    resource_alias = resolved.get("resource_alias")
    if resource_alias == R13P05_STAGE3A_RESOURCE_ALIAS:
        registered_template = R13P05_STAGE3B_PHASE1_TEMPLATE
        registered_template_sha256 = R13P05_STAGE3B_PHASE1_TEMPLATE_SHA256
    elif resource_alias == R13P05_STAGE3B_PHASE1_ROBOT_RESOURCE_ALIAS:
        registered_template = R13P05_STAGE3B_PHASE1_ROBOT_TEMPLATE
        registered_template_sha256 = R13P05_STAGE3B_PHASE1_ROBOT_TEMPLATE_SHA256
    else:
        raise Refused("R13-P05 Stage 3B Phase 1 requires a verified 2-GPU carrier")
    try:
        template_path = registered_template.resolve(strict=True)
        launcher_path = R13P05_STAGE3B_PHASE1_LAUNCHER.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R13-P05 Stage 3B Phase 1 contract file is missing: {exc}") from exc
    if (
        template_path != registered_template
        or template_path.is_symlink()
        or sha256(template_path) != registered_template_sha256
    ):
        raise Refused("R13-P05 Stage 3B Phase 1 template hash drifted")
    if (
        launcher_path != R13P05_STAGE3B_PHASE1_LAUNCHER
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
        or sha256(launcher_path) != R13P05_STAGE3B_PHASE1_LAUNCHER_SHA256
    ):
        raise Refused("R13-P05 Stage 3B Phase 1 launcher hash/executable drifted")
    template = json.loads(template_path.read_text(encoding="utf-8"))
    evidence = resolved.get("evidence")
    expected_evidence = dict(template["evidence"])
    expected_evidence["first_work_evidence_path"] = str(
        artifact_dir / "FIRST_COMPLETED_REAL_ROLLOUT.json"
    )
    expected_evidence["completed_evidence_path"] = str(
        artifact_dir / "EVALUATION_COMPLETE.json"
    )
    if evidence != expected_evidence:
        raise Refused("R13-P05 Stage 3B Phase 1 evidence contract drifted")
    if evidence.get("kind") != R13P05_STAGE3B_PHASE1_EVIDENCE_KIND:
        raise Refused("R13-P05 Stage 3B Phase 1 evidence kind is not authorized")
    for field in ("network", "worker", "fault_tolerance", "submission", "storage"):
        if resolved.get(field) != template[field]:
            raise Refused(f"R13-P05 Stage 3B Phase 1 {field} contract drifted")
    expected_runtime_fields = {
        "canary_nonce", "command", "command_file", "command_file_sha256",
        "create_artifact_dir", "gid", "identity_mechanism", "output_mode",
        "payload_base64", "payload_sha256", "payload_transport", "pod_env",
        "recursive_repair", "secret_env_names", "uid", "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R13-P05 Stage 3B Phase 1 runtime fields drifted")
    if runtime.get("pod_env") != {} or normalize_secret_env_names(
        runtime.get("secret_env_names")
    ) != []:
        raise Refused("R13-P05 Stage 3B Phase 1 requires --no-wandb and no secrets")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R13-P05 Stage 3B Phase 1 identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R13-P05 Stage 3B Phase 1 identity mechanism drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R13-P05 Stage 3B Phase 1 payload transport drifted")
    launcher_sha = sha256(launcher_path)
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R13-P05 Stage 3B Phase 1 command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R13-P05 Stage 3B Phase 1 command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R13-P05 Stage 3B Phase 1 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R13-P05 Stage 3B Phase 1 launcher must be UTF-8") from exc
    for fragment in (
        "SOURCE=/mnt/cpfs/zbl-cpfs-new/USERS/leon/code/R13-P05-stage3b-20260818",
        "EXPECTED_SOURCE_COMMIT=2e88791c6d1ee551391d4e256ca8a88c25308793",
        "SCIENCE=/mnt/cpfs/zbl-cpfs-new/dataset/leon/artifacts/r13p05/stage3b/temporal-advantage-v1",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        "CUDA_VISIBLE_DEVICES=0 JAX_PLATFORMS=cuda",
        "CUDA_VISIBLE_DEVICES=1 JAX_PLATFORMS=cuda",
        "export WANDB_MODE=disabled",
        "continuations=442368",
    ):
        if payload_text.count(fragment) < 1:
            raise Refused(f"R13-P05 Stage 3B Phase 1 payload binding drifted: {fragment}")
    expected_write_paths = [str(artifact_dir), str(R13P05_STAGE3B_SCIENCE_ROOT)]
    if write_paths != expected_write_paths:
        raise Refused("R13-P05 Stage 3B Phase 1 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R13-P05 Stage 3B Phase 1 requires condition-level resume mode")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R13-P05 Stage 3B Phase 1 forbids recursive ownership repair")


def validate_r13p05_stage3b_phase2_profile(
    *,
    resolved: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    resource_alias = resolved.get("resource_alias")
    if resource_alias == R13P05_STAGE3A_RESOURCE_ALIAS:
        registered_template = R13P05_STAGE3B_PHASE2_TEMPLATE
        registered_template_sha256 = R13P05_STAGE3B_PHASE2_TEMPLATE_SHA256
    elif resource_alias == R13P05_STAGE3B_PHASE1_ROBOT_RESOURCE_ALIAS:
        registered_template = R13P05_STAGE3B_PHASE2_ROBOT_TEMPLATE
        registered_template_sha256 = R13P05_STAGE3B_PHASE2_ROBOT_TEMPLATE_SHA256
    else:
        raise Refused("R13-P05 Stage 3B Phase 2 requires a verified 2-GPU carrier")
    try:
        template_path = registered_template.resolve(strict=True)
        launcher_path = R13P05_STAGE3B_PHASE2_LAUNCHER.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R13-P05 Stage 3B Phase 2 contract file is missing: {exc}") from exc
    if (
        template_path != registered_template
        or template_path.is_symlink()
        or sha256(template_path) != registered_template_sha256
    ):
        raise Refused("R13-P05 Stage 3B Phase 2 template hash drifted")
    if (
        launcher_path != R13P05_STAGE3B_PHASE2_LAUNCHER
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
        or sha256(launcher_path) != R13P05_STAGE3B_PHASE2_LAUNCHER_SHA256
    ):
        raise Refused("R13-P05 Stage 3B Phase 2 launcher hash/executable drifted")
    template = json.loads(template_path.read_text(encoding="utf-8"))
    evidence = resolved.get("evidence")
    expected_evidence = dict(template["evidence"])
    expected_evidence["first_work_evidence_path"] = str(
        artifact_dir / "FIRST_COMPLETED_REAL_OFFLINE_CONDITION.json"
    )
    expected_evidence["completed_evidence_path"] = str(
        artifact_dir / "EVALUATION_COMPLETE.json"
    )
    if evidence != expected_evidence:
        raise Refused("R13-P05 Stage 3B Phase 2 evidence contract drifted")
    if evidence.get("kind") != R13P05_STAGE3B_PHASE2_EVIDENCE_KIND:
        raise Refused("R13-P05 Stage 3B Phase 2 evidence kind is not authorized")
    for field in ("network", "worker", "fault_tolerance", "submission", "storage"):
        if resolved.get(field) != template[field]:
            raise Refused(f"R13-P05 Stage 3B Phase 2 {field} contract drifted")
    expected_runtime_fields = {
        "canary_nonce", "command", "command_file", "command_file_sha256",
        "create_artifact_dir", "gid", "identity_mechanism", "output_mode",
        "payload_base64", "payload_sha256", "payload_transport", "pod_env",
        "recursive_repair", "secret_env_names", "uid", "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R13-P05 Stage 3B Phase 2 runtime fields drifted")
    if runtime.get("pod_env") != {} or normalize_secret_env_names(
        runtime.get("secret_env_names")
    ) != []:
        raise Refused("R13-P05 Stage 3B Phase 2 requires --no-wandb and no secrets")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R13-P05 Stage 3B Phase 2 identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R13-P05 Stage 3B Phase 2 identity mechanism drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R13-P05 Stage 3B Phase 2 payload transport drifted")
    launcher_sha = sha256(launcher_path)
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R13-P05 Stage 3B Phase 2 command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R13-P05 Stage 3B Phase 2 command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R13-P05 Stage 3B Phase 2 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R13-P05 Stage 3B Phase 2 launcher must be UTF-8") from exc
    for fragment in (
        "SOURCE=/mnt/cpfs/zbl-cpfs-new/USERS/leon/code/R13-P05-stage3b-20260818",
        "EXPECTED_SOURCE_COMMIT=c29194afe19f9edf9b884c5fb06552c674fff248",
        "SCIENCE=/mnt/cpfs/zbl-cpfs-new/dataset/leon/artifacts/r13p05/stage3b/temporal-advantage-v1",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        "run_stage3b_phase2_offline.sh",
        "FIRST_COMPLETED_REAL_OFFLINE_CONDITION.json",
        "export WANDB_MODE=disabled",
        'assert complete["continuations"] == 442368',
    ):
        if payload_text.count(fragment) < 1:
            raise Refused(f"R13-P05 Stage 3B Phase 2 payload binding drifted: {fragment}")
    expected_write_paths = [str(artifact_dir), str(R13P05_STAGE3B_SCIENCE_ROOT)]
    if write_paths != expected_write_paths:
        raise Refused("R13-P05 Stage 3B Phase 2 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R13-P05 Stage 3B Phase 2 requires condition-level resume mode")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R13-P05 Stage 3B Phase 2 forbids recursive ownership repair")


def validate_r13p05_stage3a_profile(
    *,
    resolved: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    try:
        template_path = R13P05_STAGE3A_TEMPLATE.resolve(strict=True)
        launcher_path = R13P05_STAGE3A_LAUNCHER.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R13-P05 Stage 3A contract file is missing: {exc}") from exc
    if (
        template_path != R13P05_STAGE3A_TEMPLATE
        or template_path.is_symlink()
        or sha256(template_path) != R13P05_STAGE3A_TEMPLATE_SHA256
    ):
        raise Refused("R13-P05 Stage 3A template hash drifted")
    if (
        launcher_path != R13P05_STAGE3A_LAUNCHER
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
        or sha256(launcher_path) != R13P05_STAGE3A_LAUNCHER_SHA256
    ):
        raise Refused("R13-P05 Stage 3A launcher hash/executable drifted")
    template = json.loads(template_path.read_text(encoding="utf-8"))
    evidence = resolved.get("evidence")
    expected_evidence = dict(template["evidence"])
    expected_evidence["first_work_evidence_path"] = str(
        artifact_dir / "FIRST_COMPLETED_REAL_ROLLOUT.json"
    )
    expected_evidence["completed_evidence_path"] = str(
        artifact_dir / "EVALUATION_COMPLETE.json"
    )
    if evidence != expected_evidence:
        raise Refused("R13-P05 Stage 3A evidence contract drifted")
    if evidence.get("kind") != R13P05_STAGE3A_EVIDENCE_KIND:
        raise Refused("R13-P05 Stage 3A evidence kind is not authorized")
    if resolved.get("resource_alias") != R13P05_STAGE3A_RESOURCE_ALIAS:
        raise Refused("R13-P05 Stage 3A requires its verified 2-GPU alias")
    for field in ("network", "worker", "fault_tolerance", "submission"):
        if resolved.get(field) != template[field]:
            raise Refused(f"R13-P05 Stage 3A {field} contract drifted")
    if resolved.get("storage") != template["storage"]:
        raise Refused("R13-P05 Stage 3A storage contract drifted")
    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R13-P05 Stage 3A runtime fields drifted")
    if runtime.get("pod_env") != {} or normalize_secret_env_names(
        runtime.get("secret_env_names")
    ) != []:
        raise Refused("R13-P05 Stage 3A requires --no-wandb and no pod secrets")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R13-P05 Stage 3A identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R13-P05 Stage 3A identity mechanism drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R13-P05 Stage 3A payload transport drifted")
    launcher_sha = sha256(launcher_path)
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R13-P05 Stage 3A command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R13-P05 Stage 3A command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R13-P05 Stage 3A decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R13-P05 Stage 3A launcher must be UTF-8") from exc
    for fragment in (
        "SOURCE=/mnt/cpfs/zbl-cpfs-new/USERS/leon/code/R13-P05-CACOR-stage3a-20260815",
        "SCIENCE=/mnt/cpfs/zbl-cpfs-new/dataset/leon/artifacts/r13p05/stage3a/cacor-v1",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        "CUDA_VISIBLE_DEVICES=0 JAX_PLATFORMS=cuda",
        "CUDA_VISIBLE_DEVICES=1 JAX_PLATFORMS=cuda",
        "export WANDB_MODE=disabled",
        "--root \"$PUBLISH\"",
    ):
        if payload_text.count(fragment) < 1:
