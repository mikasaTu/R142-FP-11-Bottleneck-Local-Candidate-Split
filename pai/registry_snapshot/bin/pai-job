    ]:
        raise Refused("R22-P10 LIBERO Phase-2 requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R22-P10 LIBERO Phase-2 W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P10 LIBERO Phase-2 requires base64 payload transport")

    launcher_info = toolchain_config.get("r22p10_libero_phase2_gate_launcher")
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("R22-P10 LIBERO Phase-2 pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P10 LIBERO Phase-2 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R22-P10 LIBERO Phase-2 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R22-P10 LIBERO Phase-2 launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R22-P10 LIBERO Phase-2 command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R22-P10 LIBERO Phase-2 frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R22-P10 LIBERO Phase-2 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P10 LIBERO Phase-2 launcher must be UTF-8") from exc
    for fragment in (
        "EXPECTED_SOURCE_COMMIT=4503a5058453c6aea2cf0d44d99b370bac1b648e",
        "EXPECTED_SOURCE_TREE=8c6f0ce4714c3e1591912bba1aad7dc0a9e5e38f",
        "PREREGISTRATION_COMMIT=02fd266",
        "EXPECTED_LIBERO_COMMIT=2319dbd914673f6ef34a00584536212b10e10395",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
