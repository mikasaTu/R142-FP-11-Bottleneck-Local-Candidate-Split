def validate_r10p07_libero_obligation_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R10-P07 LIBERO obligation evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R10-P07 LIBERO obligation submission/fault contract is missing")
    if evidence.get("kind") != R10P07_LIBERO_OBLIGATION_EVIDENCE_KIND:
        raise Refused("R10-P07 LIBERO obligation evidence kind is not authorized")
    if resolved.get("resource_alias") != R10P07_LIBERO_OBLIGATION_RESOURCE_ALIAS:
        raise Refused("R10-P07 LIBERO obligation requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R10-P07 LIBERO obligation network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10-P07 LIBERO obligation worker drifted from verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R10P07_LIBERO_OBLIGATION_OUTPUT_ROOT:
        raise Refused("R10-P07 LIBERO obligation output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R10-P07 LIBERO obligation runtime fields drifted")
    expected_pod_env: Dict[str, str] = {}
    if runtime.get("pod_env") != expected_pod_env:
        raise Refused("R10-P07 LIBERO obligation EGL pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R10-P07 LIBERO obligation must be submitted with --no-wandb")
    if "wandb_entity_contract" in runtime:
        raise Refused("R10-P07 LIBERO obligation must not request W&B credentials")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10-P07 LIBERO obligation requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R10-P07 LIBERO obligation identity must be 2254:2254")
    if runtime.get("identity_mechanism") != (
        "controller_inline_bootstrap_then_setpriv"
    ):
        raise Refused("R10-P07 LIBERO obligation identity mechanism drifted")

    launcher_info = toolchain_config.get(
        "r10p07_libero_obligation_step1_launcher"
    )
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("R10-P07 LIBERO obligation pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R10-P07 LIBERO obligation launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R10-P07 LIBERO obligation launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R10-P07 LIBERO obligation launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R10-P07 LIBERO obligation command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R10-P07 LIBERO obligation command_file_sha256 drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R10-P07 LIBERO obligation payload is not the pinned launcher")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R10-P07 LIBERO obligation decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R10-P07 LIBERO obligation launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_PROJECT_COMMIT={R10P07_LIBERO_OBLIGATION_SOURCE_COMMIT}",
        f"EXPECTED_PROJECT_TREE={R10P07_LIBERO_OBLIGATION_SOURCE_TREE}",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        "export MUJOCO_GL=egl",
        "EXPECTED_SMOKE_VIDEO_MANIFEST_SHA=",
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(
                f"R10-P07 LIBERO obligation payload binding drifted: {fragment}"
            )

    run_id = artifact_dir.name
    data_root = R10P07_LIBERO_OBLIGATION_DATA_ROOT / run_id
    result_root = R10P07_LIBERO_OBLIGATION_RESULT_ROOT / run_id
    expected_evidence = {
        "kind": R10P07_LIBERO_OBLIGATION_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "evaluation",
        "task_id": "r10p07-libero-obligation-step1-20260813",
        "model_id": "oracle-obligation-graph-plus-frozen-dinov2",
        "success_gate": "persisted_completed_evaluation_result",
        "validation_method": (
            "static+official_cpu_state_replay+single_gpu_dinov2_smoke"
        ),
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            result_root / "artifacts/repo_identity.json"
        ),
        "completed_evidence_path": str(
            artifact_dir / "EVALUATION_COMPLETE.json"
        ),
        "result_root": str(result_root),
        "data_run_root": str(data_root),
        "report_path": str(result_root / "STEP1_REPORT.md"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R10P07_LIBERO_OBLIGATION_SOURCE_COMMIT,
        "source_tree": R10P07_LIBERO_OBLIGATION_SOURCE_TREE,
        "libero_source_commit": "8f1084e3132a39270c3a13ebe37270a43ece2a01",
        "libero_source_tree": "99f4ada3f1d62e026fc9ff2390eb4ff8a1760e60",
        "dinov2_source_commit": "7764ea0f912e53c92e82eb78a2a1631e92725fc8",
        "dinov2_source_tree": "2a27257b79b0633b027a21014bc9360e3c1b3f43",
        "launcher_sha256": launcher_sha,
        "formal_script_sha256": (
            "1bf2b8fdc87feb0758f5d0df765f18f385333797257f8a14da8f6dce58bbf872"
        ),
        "libero_runtime_config_sha256": (
            "b8b2a51c2f8d3c447f1a3d1a981b9ab65ed43e83a20b61cc5dbcc36ed4e79808"
        ),
        "task_config_sha256": (
            "033ecbf015689a162f892d2b950477321b1008764d557a5d495fea4a17754926"
        ),
        "formal_config_sha256": (
            "fa7f303b816b17fbf87983715d90a5cf7f36262adb643b713587ce96aa3542f6"
        ),
        "preregistration_sha256": (
            "f779500ba68d66021f927c47a94229ea276d32de90dbb3bb22d75a7f262e0ef5"
        ),
        "dinov2_weight_sha256": (
            "b938bf1bc15cd2ec0feacfe3a1bb553fe8ea9ca46a7e1d8d00217f29aef60cd9"
        ),
        "cpu_smoke_sha256": (
            "a375fc9edd4cfbfb74a8077a2f5f845a6558a0d9c3e2d612cb6c213aed3a2b56"
        ),
        "cpu_smoke_video_manifest_sha256": (
            "c088315192635c727a8d05944ac1fbfb6fb80087e8ed6d00cb2d6d5430b263e6"
        ),
        "task_count": 18,
        "core_task_count": 4,
        "donor_task_count": 14,
        "core_train_val_test_split": [30, 10, 10],
        "donor_train_episode_count_per_task": 10,
        "query_phases": ["early", "middle", "late"],
        "top_k": 5,
        "bootstrap_draws": 10000,
        "bootstrap_seed": 1007,
        "retrieval_only": True,
        "policy_training": False,
        "policy_execution": False,
        "wandb_mode": "disabled_no_training_or_service_run",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R10-P07 LIBERO obligation exact evidence contract drifted")

    expected_write_paths = [str(artifact_dir), str(data_root), str(result_root)]
    if write_paths != expected_write_paths:
        raise Refused("R10-P07 LIBERO obligation write paths drifted")
    if output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("R10-P07 LIBERO obligation requires fresh run roots")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R10-P07 LIBERO obligation forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R10-P07 LIBERO obligation fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation",
        "task": "r10p07-libero-obligation-step1-20260813",
        "model": "oracle-obligation-graph-frozen-dinov2",
        "dataset": "libero-long-four-plus-natural-donors",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "step1-retrieval-falsifier",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R10-P07 LIBERO obligation submission contract drifted")


