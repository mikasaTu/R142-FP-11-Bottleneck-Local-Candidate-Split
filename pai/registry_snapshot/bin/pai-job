            "resource_pool": "exp-efficiency",
        },
    }:
        raise Refused("WRC open-loop L1 submission contract drifted")


def validate_r23p02_stage1b_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R23-P02 Stage-1B evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R23-P02 Stage-1B submission/fault contract is missing")
    if evidence.get("kind") != R23P02_STAGE1B_EVIDENCE_KIND:
        raise Refused("R23-P02 Stage-1B evidence kind is not authorized")
    if resolved.get("resource_alias") != R23P02_STAGE1B_RESOURCE_ALIAS:
        raise Refused("R23-P02 Stage-1B requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R23-P02 Stage-1B network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
