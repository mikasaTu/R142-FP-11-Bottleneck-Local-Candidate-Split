        "source_commit": "a4dc6fafb409d3a5f5d6599829338feb002696c4",
        "source_tree": "4209297dd347ed341ed669527a3327f86294825f",
        "formal_launcher_sha256": "20a67b7fb96df40e0076f7f414b85dc7ffd3bb7358d02a95b1b5d7e09c7c14d0",
        "registry_launcher_sha256": "20de380b726c2b9b4fa0de200d04753fa5783ed3bba83a84f402d06adb71cbd8",
        "prereg_sha256": "61369e771eb94e4a64d14776b2cda38d23f775aa9c8271bc386b181e8b06cd4b",
        "frozen_model_sha256": "c83da482b08ca785a0a3ddde1ebaba0a8a6e695b22f364f0da338a318deb3d6e",
        "raw_candidate_file_sha256": "ae3333b4a4159be375be47bb7d4f1b447c247e42215b96d0e2cb7700423eb7ad",
