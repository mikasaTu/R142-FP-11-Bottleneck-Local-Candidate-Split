        "validation_status": "passed_no_pai_probe",
        "eval_code_commit": "6e03737c52c7085969406eb57c08749af2bd4214",
        "entry_commit": "8150815218562820336d745bc11b4e1f05824e64",
        "entry_payload_sha256": entry_sha,
        "training_code_commit": "0cac8c349cd59b3aa31201edaebf76bd6881c425",
        "training_run_count": 12,
        "strict_training_completion_count": 12,
        "dataset_sha256": "07dc1c96eea8c961d8f6bd3606a930344da0b83887cfc3602cc47877f5305af2",
        "matrix_sha256": pinned_files[0][1],
        "observation_bank_sha256": pinned_files[1][1],
        "episode_count": 10,
        "episode_selection": "score_blind_group_round_robin_sha256_v1",
        "episode_selection_sha256": "4f709c6c8bf864d46ebe215bba2c8bfb5bc3e8c55c601140c4730598da352592",
        "candidates_per_observation": 5,
        "candidate_policy": "frozen_wallx_flow_sampling",
        "critic_count": 12,
        "primary_metric": "openloop_action_error.l1_full32.best_of_5",
        "lower_is_better": True,
        "target_boundary": "logged-human-action-distance-only",
        "success_gate": "openloop_best_of_5_l1_complete_json",
        "completed_evidence_path": str(expected_output / "OPENLOOP_BEST_OF_5_L1_COMPLETE.json"),
    }
    for key, expected in expected_evidence.items():
        if evidence.get(key) != expected:
            raise Refused(f"WRC open-loop L1 evidence.{key} drifted")
    if evidence.get("metrics") != [
        "l1_full32",
        "rmse_full32",
        "l1_prefix8",
        "l1_prefix16",
        "episode_bootstrap_delta_95_ci",
    ]:
        raise Refused("WRC open-loop L1 metric contract drifted")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "complete_state_save_interval_steps": 0,
        "application_auto_resume": False,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("WRC open-loop L1 fault-tolerance contract drifted")
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": {
            "managed_by": "pai-job-registry",
            "purpose": "formal-openloop-bestof5-l1-evaluation",
            "task": "arrange-3-flowers-wrc-stage-success-q-norm2gpu",
            "model": "twelve-stage-success-critics-v-q8-q16-q32",
            "dataset": "wrc-stage-data-20260817-v1-episode10",
