    if write_paths != [str(artifact_dir), str(repair_root), str(report_root)]:
        raise Refused("R10-P07 Stage-2-R2A repair write paths drifted")
    if output_mode != "new" or runtime.get("create_artifact_dir") is not False:
        raise Refused("R10-P07 Stage-2-R2A repair requires fresh output roots")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R10-P07 Stage-2-R2A repair forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
