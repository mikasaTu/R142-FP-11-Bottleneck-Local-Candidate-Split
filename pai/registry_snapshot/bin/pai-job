    if "train-fold-shard" in recovery_text or "train-final-shard" in recovery_text:
        raise Refused("R22-P10 LIBERO Phase-2R recovery must not retrain frozen models")
    ordered = (
        "run_section natural_A", "confirmation-a-gate", "run_section natural_B",
        "run_section clean", "run_section controlled", "aggregate-bank-b",
    )
    if [recovery_text.index(value) for value in ordered] != sorted(
        recovery_text.index(value) for value in ordered
    ):
        raise Refused("R22-P10 LIBERO Phase-2R Bank-B recovery order drifted")

    expected_evidence = {
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "independent_rollout_confirmation_recovery",
        "task_id": "r22p10-libero-phase2r-20260814",
        "model_id": "frozen-seven-verifier-controls-three-seed",
        "success_gate": "persisted_complete_scientific_result_without_gate_short_circuit",
        "validation_method": "static+38_repository_tests+5490_candidate_roundtrip_no_pai_probe",
        "validation_status": "passed_no_pai_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "FIRST_BANK_B_ROLLOUT.json"),
        "completed_evidence_path": str(artifact_dir / "PHASE2R_COMPLETE.json"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": "7fb47bd66c91116f8ad4f4ef86582162f734e310",
        "source_tree": "b29c5802639d1eb56b4565612f548ff4ce6fb48b",
        "launcher_sha256": launcher_sha,
        "source_recovery_launcher_sha256": recovery_sha,
        "preregistration_commit": "45ae9990e39ea5c10a9a12d233929bba7e8ee919",
        "preregistration_sha256": "08a1aa2563e3dd06ee7722b8c9b395bcbc2ae7338ec40302303b2d01476d7563",
        "fold_manifest_sha256": "e91f96f05371e1e2071bc4a0750cfc969096cadadb9a9cdc08605ff188fcd286",
        "independent_test_partition_sha256": "354012941ba414b53112c66bde2f77c33a0ce7fa6d0ae0d625b70e2841de4b1c",
        "bank_b_contract_sha256": "7f8d27d7c99cec06eda0f8305ae4baff6e93216d7bedc827d8c37cab0ff9ca9b",
        "libero_source_commit": "2319dbd914673f6ef34a00584536212b10e10395",
        "libero_source_tree": "521638a78b1fe3a0a33066ef8e0e9d9f5b247e71",
        "formal_python_sha256": "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
        "formal_torch": "2.5.1+cu124",
        "overlay_manifest_sha256": "64dfffdaf464d1a37be19b038cca919a252dba573eb2d0f8aa442b91a4099459",
