        "code/stage25/kinetix_baseline.py": "42d5b1b1b99d51b0242e6a8479266bab4d008412c1c96cc74b459de36a120044",
        "code/stage25/kinetix_baseline_finalize.py": "9ed84e07754023299e921e4364cde70d8c5054e5ca6fe9cc268f7b9652f61e22",
        "scripts/run_stage25_kinetix_baseline.py": "272e512fa4aa5bc3b84c4eed60cd9312c019cd398456c7ca122570aed809ca1f",
        "scripts/finalize_stage25_kinetix_baseline.py": "cb8433b286c44cc92cc6d48669462e07993e0fc4ab2e69c11479a0536ff10c8f",
        "results/formal/r13p05-stage25-consensus-isolation/kinetix_checkpoint_manifest.json": "aec42b8c3aa9b8414ae235a6d572ef6cfaace4137c406d348b77e20622b827d9",
    }
    expected_evidence = {
        "kind": R13P05_STAGE25_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
