        "EXPECTED_CHECKPOINT_SHA=8a6d4878efe59220bb7723780ae33cf999232236ac85dcf36fc13f779c82c5da",
        "export CUDA_VISIBLE_DEVICES=0",
        "--where-loss-weight 0.2",
    )
    for fragment in required_payload_fragments:
        if payload_text.count(fragment) != 1:
            raise Refused(f"Wall-X E2E launcher binding drifted: {fragment}")


def validate_r10p25_step4_corrected_c4_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Validate the exact preregistered R10P25 Step4 two-card carrier."""

    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R10P25 Step4 evidence is missing")
    if evidence.get("kind") != R10P25_STEP4_CORRECTED_C4_EVIDENCE_KIND:
        raise Refused("R10P25 Step4 evidence kind is not authorized")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R10P25 Step4 requires the live-verified two-card alias")
    if resolved.get("network") != {}:
        raise Refused("R10P25 Step4 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10P25 Step4 worker must equal the verified 2xA800 preset")

    output_root = USER_ROOT / "logs" / "r10p25-step4-corrected-c4" / "pai"
    formal_root = USER_ROOT / "logs" / "r10p25-step4-corrected-c4" / "formal"
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != output_root:
        raise Refused("R10P25 Step4 PAI output root drifted")
    if artifact_dir != output_root / str(resolved.get("run_id")):
        raise Refused("R10P25 Step4 artifact directory drifted")
    if write_paths != [str(artifact_dir), str(formal_root)]:
        raise Refused("R10P25 Step4 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R10P25 Step4 requires resumable application output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R10P25 Step4 forbids recursive ownership repair")
    if runtime.get("pod_env") != {}:
        raise Refused("R10P25 Step4 public pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R10P25 Step4 preregistration disables service secrets")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R10P25 Step4 requires base64 payload transport")

    expected_launcher = ROOT / "launchers" / "r10p25_step4_corrected_c4_2xa800.sh"
    try:
        canonical_launcher = expected_launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R10P25 Step4 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != expected_launcher
        or expected_launcher.is_symlink()
        or not expected_launcher.is_file()
        or not os.access(expected_launcher, os.X_OK)
    ):
        raise Refused("R10P25 Step4 launcher is not canonical/executable")
    launcher_sha = sha256(expected_launcher)
    if runtime.get("command_file") != str(expected_launcher):
        raise Refused("R10P25 Step4 command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R10P25 Step4 frozen launcher payload drifted")

    expected_evidence = {
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "training_and_offline_simulator_evaluation",
        "task_id": "r10p25-step4-corrected-c4-20260814",
        "success_gate": (
            "all_preregistered_experiments_persisted_regardless_of_scientific_gate_outcomes"
        ),
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            formal_root / "state_world_models" / "TRAINING_FIRST_STEP.json"
        ),
        "completed_evidence_path": str(artifact_dir / "RUN_COMPLETE.json"),
        "contract_ready": True,
        "source_commit": "f5d1741593f6fb5d27487bff31fabc9dc545dd9d",
        "source_tree": "7eb90d8b671f113233143e0f123c33bebeb91f5c",
        "launcher_sha256": launcher_sha,
        "state_world_model_count": 6,
        "state_world_model_steps": 12000,
        "checkpoint_cadence_steps": 6000,
        "complete_state_resume": True,
        "candidate_bank_resampling": False,
        "planner_candidate_count": 32,
        "diagnostic_candidate_count": 32,
        "calibration_state_count": 40,
        "test_state_count": 120,
        "microprobe_state_count": 24,
        "bootstrap_repetitions": 10000,
        "scientific_gates_stop_remaining_experiments": False,
        "wandb_mode": "disabled_by_preregistration",
        "accepted": False,
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    for key, expected in expected_evidence.items():
        if evidence.get(key) != expected:
            raise Refused(f"R10P25 Step4 evidence.{key} drifted")

    expected_fault = {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }
    if fault != expected_fault:
        raise Refused("R10P25 Step4 fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-evaluation",
        "task": "r10p25-step4-corrected-c4-20260814",
        "model": "small-state-wm-plus-frozen-dinowm",
        "dataset": "pusht-official-frozen",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "step4-corrected-c4-offline-pilot",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R10P25 Step4 submission contract drifted")


def validate_r10p25_step4_renderer_repair_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Validate the hash-locked Step4 renderer-repair formal rerun."""

    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R10P25 Step4 renderer-repair evidence is missing")
    if evidence.get("kind") != R10P25_STEP4_RENDERER_REPAIR_EVIDENCE_KIND:
        raise Refused("R10P25 Step4 renderer-repair evidence kind is not authorized")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R10P25 Step4 renderer repair requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R10P25 Step4 renderer-repair network must be empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R10P25 Step4 renderer-repair worker preset drifted")

    output_root = USER_ROOT / "logs" / "r10p25-step4-renderer-repair-v1" / "pai"
    formal_root = USER_ROOT / "logs" / "r10p25-step4-renderer-repair-v1" / "formal"
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != output_root:
        raise Refused("R10P25 Step4 renderer-repair PAI output root drifted")
    if artifact_dir != output_root / str(resolved.get("run_id")):
        raise Refused("R10P25 Step4 renderer-repair artifact directory drifted")
