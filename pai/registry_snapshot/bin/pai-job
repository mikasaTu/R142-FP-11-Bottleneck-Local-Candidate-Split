    if write_paths != expected_write_paths:
        raise Refused("R13-P05 Stage 3A write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R13-P05 Stage 3A requires cell-level atomic resume mode")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R13-P05 Stage 3A forbids recursive ownership repair")


def validate_r13p05_stage25_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R13-P05 Stage 2.5 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R13-P05 Stage 2.5 submission/fault contract is missing")
    if evidence.get("kind") == R13P05_STAGE25_FULL_EVIDENCE_KIND:
        validate_r13p05_stage25_full_profile(
            resolved=resolved,
            runtime=runtime,
            payload=payload,
            write_paths=write_paths,
            artifact_dir=artifact_dir,
            output_mode=output_mode,
        )
        return
    if evidence.get("kind") != R13P05_STAGE25_EVIDENCE_KIND:
        raise Refused("R13-P05 Stage 2.5 evidence kind is not authorized")
    if resolved.get("resource_alias") != R13P05_STAGE25_RESOURCE_ALIAS:
        raise Refused("R13-P05 Stage 2.5 requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R13-P05 Stage 2.5 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
