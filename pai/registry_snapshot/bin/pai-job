        raise Refused("R21-P019 LIBERO Stage-D1 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R21-P019 LIBERO Stage-D1 launcher must be UTF-8") from exc
    for fragment in (
        "PROJECT_ROOT=/mnt/cpfs/zbl-cpfs-new/USERS/leon/code/r21-p019-stage-d1-crosshost-v3-20260817",
        "EXPECTED_RUN_ID=r21p019-staged1-20260817-v5",
