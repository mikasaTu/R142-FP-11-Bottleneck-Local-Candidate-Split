    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R23-P02 Stage-1B command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R23-P02 Stage-1B command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R23-P02 Stage-1B frozen payload hash drifted")
