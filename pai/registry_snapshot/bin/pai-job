def validate_wrc_openloop_bestof5_l1_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    """Validate the score-blind episode-10 open-loop action-L1 evaluation."""
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict) or not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("WRC open-loop L1 evidence/submission/fault contract is missing")

    run_id = str(resolved.get("run_id", ""))
    expected_run_id = "wrc-stage-success-q-openloop-bestof5-l1-ep10-20260820-v3"
    if run_id != expected_run_id:
        raise Refused("WRC open-loop L1 resolved run ID drifted")
    expected_output = (
        USER_ROOT / "logs" / "qpilots" / "wrc_stage_success_q_norm2gpu"
        / "openloop_bestof5_l1" / run_id
    )
    expected_registry_output = (
        USER_ROOT / "logs" / "pai_registry" / "wrc_stage_success_q_norm2gpu"
        / "openloop_bestof5_l1"
    )
    if Path(str(resolved.get("storage", {}).get("output_root", ""))) != expected_registry_output:
        raise Refused("WRC open-loop L1 registry output root drifted")
    if write_paths != [str(artifact_dir), str(expected_output)]:
        raise Refused("WRC open-loop L1 write paths drifted")
    if (
        output_mode != "new"
        or runtime.get("create_artifact_dir") is not False
        or runtime.get("recursive_repair") is not False
        or runtime.get("pod_env") != {}
        or runtime.get("secret_env_names") != []
    ):
        raise Refused("WRC open-loop L1 runtime contract drifted")

    entry_path = (
        USER_ROOT / "code" / "QPILOTS-wrc-stage-success-q-openloop-l1-entry-v3"
        / "wrc_stage_success_q" / "pai" / "run_registry_openloop_best_of_5_l1.sh"
    )
    entry_sha = "9a7f4e8e138a4a5a391d98ef2d32311fbbcf4644a59e53f9fa2764a7e1c8aad9"
    if runtime.get("command_file") != str(entry_path):
        raise Refused("WRC open-loop L1 command_file drifted")
    if runtime.get("payload_sha256") != entry_sha or sha256_bytes(payload) != entry_sha:
        raise Refused("WRC open-loop L1 frozen entry payload drifted")
    try:
        text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("WRC open-loop L1 entry must be UTF-8") from exc
    for fragment in (
        f"readonly EXPECTED_RUN_ID={expected_run_id}",
        "readonly CORE_COMMIT=6e03737c52c7085969406eb57c08749af2bd4214",
        "readonly PAYLOAD_SHA256=a032b9ac112aa73a7f27c064c16c3b0fc5e54d37a202cb8dd3a8359d082afb43",
        'exec "$ENTRY/wrc_stage_success_q/pai/run_openloop_best_of_5_l1.sh"',
    ):
        if text.count(fragment) != 1:
            raise Refused(f"WRC open-loop L1 entry binding drifted: {fragment}")

    matrix_path = Path(str(evidence.get("matrix_path", "")))
    observation_bank_path = Path(str(evidence.get("observation_bank_path", "")))
    pinned_files = (
        (
            matrix_path,
            "cfc136d0e803ad071aaf4c1d86102ad39cc65418dc851897282f2af296d32a1f",
            "matrix",
        ),
        (
            observation_bank_path,
            "d82add53f9aa602ebf457f10b63058a1c8b4926929b0069d58d7122c2a8debed",
            "observation bank",
        ),
    )
    for path, expected_sha, label in pinned_files:
        if path.is_symlink() or not path.is_file() or sha256(path) != expected_sha:
            raise Refused(f"WRC open-loop L1 pinned {label} drifted")
    matrix = load_json(matrix_path)
    runs = matrix.get("runs")
    if (
        not isinstance(runs, list)
        or len(runs) != 12
        or len({str(run.get("run_id", "")) for run in runs if isinstance(run, dict)}) != 12
        or any(not isinstance(run, dict) or not run.get("checkpoint_sha256") for run in runs)
    ):
        raise Refused("WRC open-loop L1 requires 12 pinned critic checkpoints")
    bank = load_json(observation_bank_path)
    if (
        bank.get("status") != "pass"
        or bank.get("protocol") != "frozen_openloop_observation_bank_v1"
        or bank.get("uid_gid") != "2254:2254"
        or bank.get("episodes") != 10
