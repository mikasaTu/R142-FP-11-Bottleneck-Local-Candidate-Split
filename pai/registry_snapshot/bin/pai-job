    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R10-P07 MIKASA Stage-2 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R10-P07 MIKASA Stage-2 submission/fault contract is missing")
    if evidence.get("kind") != R10P07_MIKASA_STAGE2_EVIDENCE_KIND:
        raise Refused("R10-P07 MIKASA Stage-2 evidence kind is not authorized")
    if resolved.get("resource_alias") != R10P07_MIKASA_STAGE2_RESOURCE_ALIAS:
        raise Refused("R10-P07 MIKASA Stage-2 requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R10-P07 MIKASA Stage-2 network must be source-derived empty")
