                "purpose": "formal-evaluation",
                "cleanup_required": False,
            },
        }
    )
    kind = evidence.get("kind")
    if kind not in contracts:
        raise Refused("R22-P21 v3 continuation evidence kind is not authorized")
    phase = contracts[str(kind)]

    resource_alias = resolved.get("resource_alias")
    if resource_alias not in R22P21_V3_RESOURCE_ALIASES:
        raise Refused("R22-P21 v3 continuation requires a verified dedicated alias")
    resource_pool = (
        "exp-robot"
        if resource_alias == R22P21_V3_ROBOT_RESOURCE_ALIAS
