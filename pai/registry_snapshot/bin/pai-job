    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P10 Phase-3A Step5 requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R22-P10 Phase-3A Step5 identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R22-P10 Phase-3A Step5 identity mechanism drifted")

    launcher_info = toolchain_config.get("r22p10_phase3a_step5_launcher")
    if not isinstance(launcher_info, dict) or set(launcher_info) != {"file", "sha256"}:
        raise Refused("R22-P10 Phase-3A Step5 pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P10 Phase-3A Step5 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R22-P10 Phase-3A Step5 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R22-P10 Phase-3A Step5 launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R22-P10 Phase-3A Step5 command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R22-P10 Phase-3A Step5 command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R22-P10 Phase-3A Step5 frozen payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P10 Phase-3A Step5 launcher must be UTF-8") from exc
    fragments = (
        "EXPECTED_SOURCE_COMMIT=ae2435abaf9759634f0813537f2546cf3cf4aa34",
        "EXPECTED_SOURCE_TREE=cd2fb185645ce9bc458e558279a12b9e51211aa2",
        "EXPECTED_SOURCE_LAUNCHER_SHA256=e2fd5057e413f80569ce5b8b7bccfd0708d865036e3119b62dc5f80c9bcd0478",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
        "phase3-effect-contrastive-token-blame",
    )
    for fragment in fragments:
        if payload_text.count(fragment) < 1:
            raise Refused(f"R22-P10 Phase-3A Step5 payload binding drifted: {fragment}")

    expected_evidence = {
        "kind": R22P10_PHASE3A_STEP5_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "complete_training_collection_and_rollout_evaluation",
        "task_id": "r22p10-phase3a-step5-20260816",
        "model_id": "six-under-3m-effect-verifiers-three-seed-five-fold",
        "success_gate": "all pilot_full_bank_d_continuation_statistics_and_mechanism_artifacts_persisted",
