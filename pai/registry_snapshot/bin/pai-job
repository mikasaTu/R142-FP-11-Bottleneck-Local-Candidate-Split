def validate_r23p02_stage5a_profile(
    *, resolved: Dict[str, Any], toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any], payload: bytes, write_paths: List[str],
    artifact_dir: Path, output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict) or evidence.get("kind") not in R23P02_STAGE5A_EVIDENCE_KINDS:
        raise Refused("R23-P02 Stage5A evidence kind is not authorized")
    if resolved.get("resource_alias") not in R23P02_STAGE5A_RESOURCE_ALIASES:
        raise Refused("R23-P02 Stage5A requires its verified two-GPU alias")
    expected_worker = {
        "count": 1,
        "image": "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-py311-cu121-ubuntu22.04",
        "gpu": 2, "cpu": 12, "memory": "200Gi", "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker or resolved.get("network") != {}:
        raise Refused("R23-P02 Stage5A worker/network contract drifted")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(str(storage.get("output_root", ""))) != R23P02_STAGE5A_OUTPUT_ROOT:
        raise Refused("R23-P02 Stage5A output root drifted")
    launcher = ROOT / "launchers/r23p02_stage5a_conditional_future_residual.sh"
    if launcher.is_symlink() or not launcher.is_file() or not os.access(launcher, os.X_OK):
        raise Refused("R23-P02 Stage5A launcher is not canonical/executable")
    launcher_sha = sha256(launcher)
    if runtime.get("command_file") != str(launcher):
        raise Refused("R23-P02 Stage5A command_file drifted")
    if runtime.get("command_file_sha256") != launcher_sha or runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R23-P02 Stage5A frozen launcher hash drifted")
    if runtime.get("pod_env") != {} or normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("R23-P02 Stage5A disables pod secrets and W&B")
    text = payload.decode("utf-8")
    for fragment in (
        f"EXPECTED_COMMIT={R23P02_STAGE5A_SOURCE_COMMIT}",
        f"EXPECTED_TREE={R23P02_STAGE5A_SOURCE_TREE}",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        "new_simulator_rollouts\": 0",
        'exec "$PROJECT_ROOT/run_stage5a.sh"',
    ):
        if text.count(fragment) != 1:
            raise Refused(f"R23-P02 Stage5A launcher binding drifted: {fragment}")
    if evidence.get("source_commit") != R23P02_STAGE5A_SOURCE_COMMIT or evidence.get("source_tree") != R23P02_STAGE5A_SOURCE_TREE:
        raise Refused("R23-P02 Stage5A source binding drifted")
    required = {
        "resource_contract": "dedicated_2gpu_v1",
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "training_seed_count": 3,
        "maximum_trainable_parameters": 2000000,
        "test_based_tuning": False,
        "new_simulator_rollouts": 0,
        "world_model_training": False,
        "pi05_used": False,
        "closed_loop_improvement_claimed": False,
        "novelty_modified": False,
        "accepted": False,
        "html_built": False,
        "wandb_mode": "disabled_local_cpfs_metrics_only",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    for key, expected in required.items():
        if evidence.get(key) != expected:
            raise Refused(f"R23-P02 Stage5A evidence.{key} drifted")
    phase_a = evidence["kind"] == "r23p02_stage5a_action_prior_crossfit"
    expected_run_prefix = "r23p02-stage5a-phasea-" if phase_a else "r23p02-stage5a-phaseb-"
    if not str(resolved.get("run_id", "")).startswith(expected_run_prefix):
        raise Refused("R23-P02 Stage5A phase/run namespace mismatch")
    expected_first = (
        R23P02_STAGE5A_FORMAL_ROOT / "results/stage5_conditional_future_residual/action_prior_checkpoints/primary/seed_25051/full/first_optimizer_step.json"
        if phase_a else
        R23P02_STAGE5A_FORMAL_ROOT / "results/stage5_conditional_future_residual/checkpoints/primary/M1_F1_future_only/seed_25051/first_optimizer_step.json"
    )
    expected_complete = (
        R23P02_STAGE5A_FORMAL_ROOT / "results/stage5_conditional_future_residual/action_prior_complete.json"
        if phase_a else
        R23P02_STAGE5A_FORMAL_ROOT / "results/stage5_conditional_future_residual/STAGE5A_COMPLETE.json"
    )
    if Path(str(evidence.get("first_work_evidence_path", ""))) != expected_first or Path(str(evidence.get("completed_evidence_path", ""))) != expected_complete:
        raise Refused("R23-P02 Stage5A evidence paths drifted")
    if write_paths != [str(artifact_dir), str(R23P02_STAGE5A_FORMAL_ROOT)]:
        raise Refused("R23-P02 Stage5A write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True or runtime.get("recursive_repair") is not False:
        raise Refused("R23-P02 Stage5A resume/ownership contract drifted")
    if fault != {"aimaster_args":"","maximum_platform_restarts":0,"expected_platform_restarts":0,"launcher_attempts":1,"retry_sleep_seconds":30,"pai_automatic_fault_tolerance":False}:
        raise Refused("R23-P02 Stage5A dedicated fault contract drifted")
    resource_pool = "exp-robot" if resolved.get("resource_alias", "").startswith("exp-robot-") else "exp-efficiency"
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training" if phase_a else "formal-training-evaluation",
        "task": "r23p02-stage5a-action-prior-crossfit" if phase_a else "r23p02-stage5a-conditional-future-residual",
        "model": "a1-action-prior" if phase_a else "cfrr-and-preregistered-controls",
        "dataset": "libero-stage4-frozen-cache",
        "hardware": "2xa800-dedicated", "resource_pool": resource_pool,
        "experiment_role": "stage5a-action-prior-oof-freeze" if phase_a else "stage5a-all-arms-mechanism-closure",
    }
    if submission != {"priority":9,"disable_ecs_stock_check":False,"job_reserved_policy":"","job_reserved_minutes":0,"job_max_running_time_minutes":0,"tags":expected_tags}:
        raise Refused("R23-P02 Stage5A submission contract drifted")


def validate_r23p02_libero_oracle_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R23-P02 LIBERO oracle evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R23-P02 LIBERO oracle submission/fault contract is missing")
    if evidence.get("kind") != R23P02_LIBERO_ORACLE_EVIDENCE_KIND:
        raise Refused("R23-P02 LIBERO oracle evidence kind is not authorized")
    if resolved.get("resource_alias") != R23P02_LIBERO_ORACLE_RESOURCE_ALIAS:
        raise Refused("R23-P02 LIBERO oracle requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R23-P02 LIBERO oracle network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R23-P02 LIBERO oracle worker must equal the verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R23P02_LIBERO_ORACLE_OUTPUT_ROOT:
        raise Refused("R23-P02 LIBERO oracle output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R23-P02 LIBERO oracle runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R23-P02 LIBERO oracle public pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused("R23-P02 LIBERO oracle requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R23-P02 LIBERO oracle W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R23-P02 LIBERO oracle requires base64 payload transport")

    launcher_info = toolchain_config.get("r23p02_libero_oracle_launcher")
    if not isinstance(launcher_info, dict) or set(launcher_info) != {
        "file",
        "sha256",
    }:
        raise Refused("R23-P02 LIBERO oracle pinned launcher is missing")
    launcher_path = ROOT / str(launcher_info.get("file", ""))
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R23-P02 LIBERO oracle launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R23-P02 LIBERO oracle launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != launcher_info.get("sha256"):
        raise Refused("R23-P02 LIBERO oracle launcher toolchain hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R23-P02 LIBERO oracle command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R23-P02 LIBERO oracle frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R23-P02 LIBERO oracle decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R23-P02 LIBERO oracle launcher must be UTF-8") from exc
    for fragment in (
        f"EXPECTED_SOURCE_COMMIT={R23P02_LIBERO_ORACLE_SOURCE_COMMIT}",
        f"EXPECTED_SOURCE_TREE={R23P02_LIBERO_ORACLE_SOURCE_TREE}",
        f"CHECKPOINT_ROOT={R23P02_LIBERO_ORACLE_CHECKPOINT_ROOT}",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
    ):
        if payload_text.count(fragment) != 1:
            raise Refused(f"R23-P02 LIBERO oracle payload binding drifted: {fragment}")

    expected_evidence = {
        "kind": R23P02_LIBERO_ORACLE_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "evaluation",
        "task_id": "r23p02-libero-oracle-core-signal-20260812",
        "model_id": "frozen-dinov2-vits14-gcbc-h12",
        "success_gate": "persisted_completed_evaluation_result",
        "validation_method": "static+local_cpu_simulator+local_single_gpu_dinov2_smoke",
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            artifact_dir / "shards/rank0/first_completed_rollout.json"
        ),
        "completed_evidence_path": str(artifact_dir / "EVALUATION_COMPLETE.json"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R23P02_LIBERO_ORACLE_SOURCE_COMMIT,
        "source_tree": R23P02_LIBERO_ORACLE_SOURCE_TREE,
        "launcher_sha256": launcher_sha,
        "run_formal_sha256": "b919968a3955d87eff0f53203b420c5efa79f3967b2c12734a0c29e6a9e719a9",
        "libero_config_sha256": "a9d48706574c6d5ea4f8c13e5ce21a3b3297afd8f40c4c0a2552ca603ec915f0",
        "python_sha256": "903441582909636b4316667ee22beb1e6e2726991584ea9265c765ac8388abd1",
