    if write_paths != [str(artifact_dir)]:
        raise Refused("DINO-WM PushT may write only its fresh artifact directory")
    if output_mode != "new":
        raise Refused("DINO-WM PushT formal evaluation must use output_mode=new")
    if runtime.get("create_artifact_dir") is not False:
        raise Refused("DINO-WM PushT new output forbids create_artifact_dir")
    if runtime.get("recursive_repair") is not False:
        raise Refused("DINO-WM PushT forbids recursive ownership repair")
    if resolved.get("controller_version") == CONTROLLER_VERSION:
        if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_GZIP_BASE64:
            raise Refused("DINO-WM PushT requires gzip_base64 payload transport")
    elif "payload_transport" in runtime:
        raise Refused("legacy DINO-WM manifests must use implicit base64 transport")
    if runtime.get("pod_env") != {} or runtime.get("secret_env_names") != []:
        raise Refused("DINO-WM PushT evaluation forbids public or secret job env")
    if "wandb_entity_contract" in runtime:
        raise Refused("DINO-WM PushT evaluation must not request W&B credentials")

    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("DINO-WM PushT dedicated fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-evaluation",
        "task": expected_task,
        "model": expected_model,
        "dataset": "pusht-noise-official-442f5dee",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "simulation-baseline-only",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("DINO-WM PushT exact submission contract drifted")


def validate_dinowm_wall_single_official_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("DINO-WM Wall-single evaluation evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("DINO-WM Wall-single submission/fault contract is missing")
    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if resolved.get("controller_version") == CONTROLLER_VERSION:
        expected_runtime_fields.add("payload_transport")
    if set(runtime) != expected_runtime_fields:
        raise Refused("DINO-WM Wall-single runtime fields drifted")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused(
            "DINO-WM Wall-single evaluation requires the verified 2-GPU alias"
        )
    if resolved.get("network") != {}:
        raise Refused("DINO-WM Wall-single network must be empty and source-derived")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused(
            "DINO-WM Wall-single worker must exactly equal the verified 2-GPU preset"
        )
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != DINO_WM_WALL_SINGLE_OUTPUT_ROOT:
        raise Refused(
            "DINO-WM Wall-single output_root drifted from the fixed production root"
        )

    tool_specs = {
        "launcher": (
            "dinowm_wall_single_official_eval_launcher",
            "launcher_sha256",
        ),
        "cuda_entry_wrapper": (
            "dinowm_wall_single_official_cuda_entry_wrapper",
            "cuda_entry_wrapper_sha256",
        ),
        "artifact_validator": (
            "dinowm_wall_single_official_artifact_validator",
            "artifact_validator_sha256",
        ),
    }
    observed_tools: Dict[str, Tuple[Path, str]] = {}
    for role, (toolchain_key, evidence_field) in tool_specs.items():
        info = toolchain_config.get(toolchain_key)
        if not isinstance(info, dict) or set(info) != {"file", "sha256"}:
            raise Refused(f"DINO-WM toolchain entry {toolchain_key} drifted")
        relative = Path(str(info.get("file", "")))
        if relative.is_absolute() or ".." in relative.parts:
            raise Refused(f"DINO-WM toolchain path {toolchain_key} is unsafe")
        path = ROOT / relative
        try:
            canonical = path.resolve(strict=True)
        except OSError as exc:
            raise Refused(f"DINO-WM pinned tool is missing: {path}: {exc}") from exc
        if canonical != path or path.is_symlink() or not path.is_file():
            raise Refused(f"DINO-WM pinned tool is not canonical: {path}")
        observed_hash = sha256(path)
        if observed_hash != info.get("sha256"):
            raise Refused(f"DINO-WM pinned tool hash drifted: {role}")
        if evidence.get(evidence_field) != observed_hash:
            raise Refused(f"DINO-WM evidence does not bind the {role} hash")
        observed_tools[role] = (path, observed_hash)

    launcher_path, launcher_sha = observed_tools["launcher"]
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("DINO-WM command_file is not the pinned launcher")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("DINO-WM frozen payload is not the pinned launcher")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("DINO-WM decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("DINO-WM launcher payload must be UTF-8") from exc
    for role, variable in (
        ("cuda_entry_wrapper", "EXPECTED_ENTRY_SHA256"),
        ("artifact_validator", "EXPECTED_VALIDATOR_SHA256"),
    ):
        expected_line = f"{variable}={observed_tools[role][1]}"
        if payload_text.count(expected_line) != 1:
            raise Refused(f"DINO-WM launcher does not bind exact {role} hash")

    if payload_text.count("--config-name plan_wall.yaml") != 1:
        raise Refused("DINO-WM Wall-single launcher must select plan_wall.yaml once")
    if "planner.max_iter" in payload_text:
        raise Refused("DINO-WM Wall-single launcher must not override planner.max_iter")
    if "planner.sub_planner" in payload_text:
        raise Refused("DINO-WM Wall-single launcher must not override CEM defaults")

    expected_task = "dinowm-wall-single-official-dual-seed-eval-20260806"
    expected_model = "dinowm-wall-single-official-latest-8441971"
    expected_evidence = {
        "kind": DINO_WM_WALL_SINGLE_OFFICIAL_EVAL_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "evaluation",
        "task_id": expected_task,
        "model_id": expected_model,
        "success_gate": "persisted_completed_evaluation_result",
        "validation_method": "static+dev14_zero_gpu_contract",
        "validation_status": "passed_dev14_zero_gpu_preflight",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            artifact_dir / "replicas" / "seed99" / "output" / "logs.json"
        ),
        "completed_evidence_path": str(
            artifact_dir / "EVALUATION_COMPLETE.json"
        ),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": "0a9492fa12044b852ae9e001cc74604b79c8bb0c",
        "source_tree": "79f5c852d721ae99bfaec95c069acbf6bf87d51e",
        "frozen_source_tar_sha256": (
            "706fd4c82facb059ec97009a19efe6ab6bc396fb358b07ef9c358dd3464b856a"
        ),
        "frozen_source_manifest_sha256": (
            "238ba4ed559251dccd4791faad25b7ba38ccde9af13987442af26936494b90ac"
        ),
        "frozen_source_file_count": 190,
        "checkpoint_sha256": (
            "8441971becdae934fe08de5b163398390a32f6fe1fb0a8df113290e2468e142b"
        ),
        "checkpoint_hydra_sha256": (
            "4ed3109219ed6820ce51fd19e4c97199552b3443ed58c502fddd6441784967e1"
        ),
        "dataset_archive_sha256": (
            "2b4ae4ed0ad03b337efac637f17752e7e7e27f864fec39dc25b51fef490c980d"
        ),
        "dataset_tree_manifest_sha256": (
            "2ce5a30563cad3a34b67ede6970fc7bc91c3d7921e56a475b4cff2b8dabaed86"
        ),
        "dataset_tree_file_count": 5779,
        "mujoco_tree_manifest_sha256": (
            "136c5687c2ab7b061986f16e1b33d9267df8ab03578bc23dd96bc3426caea4c9"
        ),
        "mujoco_tree_file_count": 52,
        "dinov2_source_commit": (
            "85a24602099d397264d5b30461ad7f3bfd726ca1"
        ),
        "dinov2_source_tree": (
            "d6c719f8fd5c50fd369d381a8710311f6f9082ae"
        ),
        "dinov2_source_tar_sha256": (
            "2f85e336d274855aa93392ff40e6b6b22a21e1ad424c6eadcd983bc4b5d35bc4"
        ),
        "dinov2_source_manifest_sha256": (
            "38af1b644fb6863961298ef09a43e696486c3cf0f093ab346e38773619ab8c27"
        ),
        "dinov2_source_file_count": 162,
        "dinov2_weight_sha256": (
            "b938bf1bc15cd2ec0feacfe3a1bb553fe8ea9ca46a7e1d8d00217f29aef60cd9"
        ),
        "dinov2_weight_size_bytes": 88283115,
        "dinov2_hub_contract": (
            "exact_run_local_cache_guarded_single_load_zero_download"
        ),
        "outputs_archive_sha256": (
            "425b0d8c2a4194d3ec996b553575f69409aa5714176b063d8401789db9179482"
        ),
        "conda_lock_sha256": (
            "a3d0bbfc4836c25c27199364b296f101bb61030346e81be11e47d478f161ffff"
        ),
        "pip_lock_sha256": (
            "f3da7d690202ff708733571f7221409a819a1e114800bd4370e730c7fb6b2d18"
        ),
        "python_binary_sha256": (
            "1d46c5d35a90da9185f97d9b36c28e59b87b052af08378eb3581abd37d4b530c"
        ),
        "launcher_sha256": observed_tools["launcher"][1],
        "cuda_entry_wrapper_sha256": observed_tools["cuda_entry_wrapper"][1],
        "artifact_validator_sha256": observed_tools["artifact_validator"][1],
        "official_config_name": "plan_wall.yaml",
        "model_asset_selector": "wall_single",
        "seeds": [99, 100],
        "n_evals_per_seed": 50,
        "total_evaluation_instances": 100,
        "planner": "mpc_cem",
        "released_defaults_contract": (
            DINO_WM_WALL_SINGLE_RELEASED_DEFAULTS_CONTRACT
        ),
        "gpu_execution_binding_contract": (
            DINO_WM_WALL_SINGLE_GPU_EXECUTION_BINDING_CONTRACT
        ),
        "cem_num_samples": 300,
        "cem_topk": 30,
        "cem_opt_steps": 10,
        "execution_mode": (
            "sequential_to_preserve_the_official_50_env_memory_contract"
        ),
        "gpu_assignments": {"seed99": 0, "seed100": 1},
        "wandb_mode": "disabled_no_service_run_disabled_adapter_v1",
        "paper_replication_claim": False,
        "accepted": False,
        "experiment_role": DINO_WM_WALL_SINGLE_EXPERIMENT_ROLE,
        "evidence_boundary": DINO_WM_WALL_SINGLE_EVIDENCE_BOUNDARY,
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("DINO-WM Wall-single exact evidence contract drifted")

    if write_paths != [str(artifact_dir)]:
        raise Refused(
            "DINO-WM Wall-single may write only its fresh artifact directory"
        )
    if output_mode != "new":
        raise Refused("DINO-WM Wall-single formal evaluation must use output_mode=new")
    if runtime.get("create_artifact_dir") is not False:
        raise Refused("DINO-WM Wall-single new output forbids create_artifact_dir")
    if runtime.get("recursive_repair") is not False:
        raise Refused("DINO-WM Wall-single forbids recursive ownership repair")
    if resolved.get("controller_version") == CONTROLLER_VERSION:
        if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_GZIP_BASE64:
            raise Refused("DINO-WM Wall-single requires gzip_base64 payload transport")
    elif "payload_transport" in runtime:
        raise Refused("legacy DINO-WM manifests must use implicit base64 transport")
    if runtime.get("pod_env") != {} or runtime.get("secret_env_names") != []:
        raise Refused("DINO-WM Wall-single evaluation forbids public or secret job env")
    if "wandb_entity_contract" in runtime:
        raise Refused("DINO-WM Wall-single evaluation must not request W&B credentials")

    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
