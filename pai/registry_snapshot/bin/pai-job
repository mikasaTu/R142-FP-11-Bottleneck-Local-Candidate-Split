        R22P21_SELECTOR_V2_LONO_REPAIR_OUTPUT_ROOT
    ):
        raise Refused("R22-P21 selector-v2 LONO repair registry output root drifted")
    expected_runtime_fields = {
        "canary_nonce", "command", "command_file", "command_file_sha256",
        "create_artifact_dir", "gid", "identity_mechanism", "output_mode",
        "payload_base64", "payload_sha256", "payload_transport", "pod_env",
        "recursive_repair", "secret_env_names", "uid", "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R22-P21 selector-v2 LONO repair runtime fields drifted")
    if runtime.get("pod_env") != {
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics"
    }:
        raise Refused("R22-P21 selector-v2 LONO repair pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY", "WANDB_ENTITY"
    ]:
        raise Refused("R22-P21 selector-v2 LONO repair requires the exact W&B secrets")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R22-P21 selector-v2 LONO repair W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P21 selector-v2 LONO repair requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R22-P21 selector-v2 LONO repair identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R22-P21 selector-v2 LONO repair identity mechanism drifted")

    launcher = R22P21_SELECTOR_V2_LONO_REPAIR_LAUNCHER
    try:
        canonical_launcher = launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P21 selector-v2 LONO repair launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher
        or launcher.is_symlink()
        or not launcher.is_file()
        or not os.access(launcher, os.X_OK)
        or sha256(launcher) != R22P21_SELECTOR_V2_LONO_REPAIR_LAUNCHER_SHA256
    ):
        raise Refused("R22-P21 selector-v2 LONO repair launcher contract drifted")
    if runtime.get("command_file") != str(launcher):
        raise Refused("R22-P21 selector-v2 LONO repair command_file is not pinned")
    if runtime.get("command_file_sha256") != R22P21_SELECTOR_V2_LONO_REPAIR_LAUNCHER_SHA256:
        raise Refused("R22-P21 selector-v2 LONO repair command_file hash drifted")
    if (
        runtime.get("payload_sha256") != R22P21_SELECTOR_V2_LONO_REPAIR_LAUNCHER_SHA256
        or sha256_bytes(payload) != R22P21_SELECTOR_V2_LONO_REPAIR_LAUNCHER_SHA256
    ):
        raise Refused("R22-P21 selector-v2 LONO repair payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P21 selector-v2 LONO repair launcher must be UTF-8") from exc
    fragments = (
        "PREREGISTRATION_COMMIT=f2e0b59",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
        "TINY_SOURCE_ROOT=/mnt/cpfs/zbl-cpfs-new/USERS/leon/code/",
        "run_seed 22021 0",
        "run_seed 22022 1",
        "run_seed 22023 0",
        "r22p21.selector_v2_lono_repair",
        "LONO_PARAPHRASE_CORRECTION_COMPLETE.json",
    )
    for fragment in fragments:
        if payload_text.count(fragment) < 1:
            raise Refused(
                f"R22-P21 selector-v2 LONO repair payload binding drifted: {fragment}"
            )

    expected_evidence = {
        "kind": R22P21_SELECTOR_V2_LONO_REPAIR_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "targeted_paraphrase_lono_correction",
        "task_id": "r22p21-selector-v2-lono-repair-20260814",
        "model_id": "tinylangbc-three-policy-seeds-three-selector-seeds",
        "success_gate": "persisted_corrected_three_seed_episode_clustered_summary",
        "validation_method": "static+targeted_regression+payload_syntax_no_pai_probe",
        "validation_status": "passed_no_pai_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "FIRST_REAL_WORK.json"),
        "completed_evidence_path": str(
            artifact_dir / "LONO_PARAPHRASE_CORRECTION_COMPLETE.json"
        ),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R22P21_SELECTOR_V2_LONO_REPAIR_SOURCE_COMMIT,
        "source_tree": R22P21_SELECTOR_V2_LONO_REPAIR_SOURCE_TREE,
        "launcher_sha256": R22P21_SELECTOR_V2_LONO_REPAIR_LAUNCHER_SHA256,
        "preregistration_commit": "f2e0b59",
        "preregistration_sha256": (
            "ff5398b418db4600e15dc1ce3144360234f51538a859707f03ceb662ae703b48"
        ),
        "tiny_resolved_config_sha256": (
            "75a19dcdab1ca2589428c30b6e9d61139b500c7ad55626f2850aa79329ce12a4"
        ),
        "source_tiny_commit": R22P21_SELECTOR_V2_TINY_SOURCE_COMMIT,
        "formal_torch": "2.5.1+cu124",
        "policy_seeds": [22021, 22022, 22023],
        "selector_seeds": [31001, 31002, 31003],
        "maximum_concurrent_gpus": 2,
        "gpus_per_process": 1,
        "exact_change_scope": (
            "map_registered_paraphrase_to_stored_N-language_before_exclusion"
        ),
        "invalid_old_family_retained_for_diagnostic_only": True,
        "scientific_gate_short_circuit": False,
        "application_resume_scope": (
            "selector_epoch10_checkpoints_plus_seed_complete_markers"
        ),
        "wandb_mode": "online_exact_entity_one_run_per_policy_seed_resume_same_lineage",
        "wandb_project": "r22p21-selector-v2",
        "wandb_entity": "chen_jian-cj-workspace",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "cleanup_required": True,
    }
    if evidence != expected_evidence:
        differing = sorted(
            key for key in set(evidence) | set(expected_evidence)
            if evidence.get(key) != expected_evidence.get(key)
        )
        raise Refused(f"R22-P21 selector-v2 LONO repair evidence drifted: {differing}")
    if write_paths != [
        str(artifact_dir), str(R22P21_SELECTOR_V2_LONO_REPAIR_WORK_ROOT)
    ]:
        raise Refused("R22-P21 selector-v2 LONO repair write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R22-P21 selector-v2 LONO repair requires application resume")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P21 selector-v2 LONO repair forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "", "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0, "launcher_attempts": 1,
        "retry_sleep_seconds": 30, "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R22-P21 selector-v2 LONO repair fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-evaluation",
        "task": "r22p21-selector-v2-lono-repair-20260814",
        "model": "state-conditioned-mediator-selector",
        "dataset": "r22p21-libero-synthetic-12000",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "selector-v2-targeted-lono-correction",
    }
    if submission != {
        "priority": 9, "disable_ecs_stock_check": False,
        "job_reserved_policy": "", "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0, "tags": expected_tags,
    }:
        raise Refused("R22-P21 selector-v2 LONO repair submission contract drifted")
    if provenance.get("contract_source_job_id") != resolved["resource"].get(
        "contract_source_job_id"
    ) or provenance.get("resource_source_job_id") != resolved["resource"].get("source_job_id"):
        raise Refused("R22-P21 selector-v2 LONO repair live source bindings drifted")


def validate_r22p10_phase3a_step5_profile(
    *,
    resolved: Dict[str, Any],
