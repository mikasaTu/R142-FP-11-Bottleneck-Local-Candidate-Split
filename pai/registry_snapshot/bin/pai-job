    artifact_dir: Path,
    output_mode: Any,
) -> None:
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R22-P10 LIBERO Phase-2 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R22-P10 LIBERO Phase-2 submission/fault contract is missing")
    if evidence.get("kind") != R22P10_LIBERO_PHASE2_GATE_EVIDENCE_KIND:
        raise Refused("R22-P10 LIBERO Phase-2 evidence kind is not authorized")
    if resolved.get("resource_alias") != R22P10_LIBERO_PHASE1_RESOURCE_ALIAS:
        raise Refused("R22-P10 LIBERO Phase-2 requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P10 LIBERO Phase-2 network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
