        "dataset": "mikasa-r2a-immutable-preflight",
        "hardware": "2xa800-dedicated-two-validators",
        "resource_pool": "exp-efficiency",
        "experiment_role": "stage2-r2a-preflight-evidence-repair",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
