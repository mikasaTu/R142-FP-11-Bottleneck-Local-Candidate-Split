def validate_r16p15_stage1c_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P15 Stage 1C evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R16-P15 Stage 1C submission/fault contract is missing")
    if evidence.get("kind") != R16P15_STAGE1C_EVIDENCE_KIND:
        raise Refused("R16-P15 Stage 1C evidence kind is not authorized")
    if resolved.get("resource_alias") != R16P15_STAGE1C_RESOURCE_ALIAS:
        raise Refused("R16-P15 Stage 1C requires its verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P15 Stage 1C network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R16-P15 Stage 1C worker must equal the verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R16P15_STAGE1C_OUTPUT_ROOT:
        raise Refused("R16-P15 Stage 1C output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R16-P15 Stage 1C runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R16-P15 Stage 1C public pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused("R16-P15 Stage 1C requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R16-P15 Stage 1C W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R16-P15 Stage 1C requires base64 payload transport")

    launcher_path = R16P15_STAGE1C_LAUNCHER
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R16-P15 Stage 1C launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R16-P15 Stage 1C launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != R16P15_STAGE1C_LAUNCHER_SHA256:
        raise Refused("R16-P15 Stage 1C launcher hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R16-P15 Stage 1C command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R16-P15 Stage 1C command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R16-P15 Stage 1C frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R16-P15 Stage 1C decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R16-P15 Stage 1C launcher must be UTF-8") from exc
    required_payload_fragments = (
        f"EXPECTED_SOURCE_COMMIT={R16P15_STAGE1C_SOURCE_COMMIT}",
        f"EXPECTED_SOURCE_TREE={R16P15_STAGE1C_SOURCE_TREE}",
        f"APPLICATION_RUN_ID={R16P15_STAGE1C_APPLICATION_RUN_ID}",
        f"EXPECTED_STAGE_CONFIG_SHA={R16P15_STAGE1C_CONFIG_SHA256}",
        f"EXPECTED_SMOKE_SHA={R16P15_STAGE1C_SMOKE_SHA256}",
        "EXPECTED_RUNNER_SHA=f266d44d81a34d2543b31fcaa138af20b1fcf27ab89cb0c5be4205a2b424bfb2",
        "EXPECTED_PYTHON_SHA=89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
    )
    for fragment in required_payload_fragments:
        if payload_text.count(fragment) != 1:
            raise Refused(f"R16-P15 Stage 1C payload binding drifted: {fragment}")

    expected_evidence = {
        "kind": R16P15_STAGE1C_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "training_and_rollout_evaluation",
        "task_id": "r16p15-task64-stage1c-2b-20260814",
        "model_id": "pi05-task64-c1-c2-c3-critic-zoo-authority",
        "success_gate": "persisted_substrate_regression_then_terminal_scientific_decision",
        "validation_method": "static_plus_real_dev14_openpi_libero_a800_smoke",
        "validation_status": "passed_no_pai_gpu_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(
            R16P15_STAGE1C_SCIENCE_ROOT / "substrate_regression.json"
        ),
        "completed_evidence_path": str(
            artifact_dir / "R16P15_STAGE1C_COMPLETE.json"
        ),
        "scientific_completed_evidence_path": str(
            R16P15_STAGE1C_SCIENCE_ROOT / "EXPERIMENT_COMPLETE.json"
        ),
        "report_path": str(R16P15_STAGE1C_SCIENCE_ROOT / "report.md"),
        "decision_path": str(R16P15_STAGE1C_SCIENCE_ROOT / "decision.json"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R16P15_STAGE1C_SOURCE_COMMIT,
        "source_tree": R16P15_STAGE1C_SOURCE_TREE,
        "openpi_commit": "54cbaee6ae0c010a1ed431871cdaa8f4684ac709",
        "libero_commit": "f78abd68ee283de9f9be3c8f7e2a9ad60246e95c",
        "stage_config_sha256": R16P15_STAGE1C_CONFIG_SHA256,
        "launcher_sha256": launcher_sha,
        "dev14_smoke_sha256": R16P15_STAGE1C_SMOKE_SHA256,
        "application_run_id": R16P15_STAGE1C_APPLICATION_RUN_ID,
        "science_artifact_dir": str(R16P15_STAGE1C_SCIENCE_ROOT),
        "checkpoint_lineage": str(R16P15_STAGE1C_CHECKPOINT_ROOT),
        "cache_root": str(R16P15_STAGE1C_CACHE_ROOT),
        "checkpoint_updates": [2000, 5000, 10000],
        "full_state_resume": True,
        "critic_updates_per_family_seed": 10000,
        "critic_families_trained": 8,
        "critic_seeds": 3,
        "batch_size_per_gpu": 64,
        "global_batch_per_independent_critic": 64,
        "maximum_gpus": 2,
        "candidate_count": 16,
        "natural_candidate_count": 8,
        "sealed_states": list(range(30, 50)),
        "allowed_decisions": [
            "BLOCKED_SUBSTRATE",
            "BLOCKED_SUPERVISION",
            "REVISE_CRITIC_V2",
            "INSUFFICIENT_AUTHORITY_EVENTS",
            "REJECT_AUTHORITY_MECHANISM",
            "REJECT_CLOSED_LOOP_EFFECT",
            "PROCEED_TO_FINAL_MULTITASK",
        ],
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "experiment_scope": (
            "bounded_task64_stage1c_2b_not_final_heldout_or_multitask_claim"
        ),
    }
    if evidence != expected_evidence:
        raise Refused("R16-P15 Stage 1C exact evidence contract drifted")

    if write_paths != [
        str(artifact_dir),
        str(R16P15_STAGE1C_SCIENCE_ROOT),
        str(R16P15_STAGE1C_CHECKPOINT_ROOT),
        str(R16P15_STAGE1C_CACHE_ROOT),
        str(R16P15_STAGE1C_LIBERO_CONFIG_ROOT),
    ]:
        raise Refused("R16-P15 Stage 1C write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R16-P15 Stage 1C requires resumable application output")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R16-P15 Stage 1C forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R16-P15 Stage 1C fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-evaluation",
        "task": "r16p15-task64-stage1c-2b-20260814",
        "model": "pi05-critic-zoo-authority",
        "dataset": "libero90-task64-frozen-splits",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "stage1c-2b-action-sufficiency-authority",
    }
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R16-P15 Stage 1C submission contract drifted")


def validate_r16p18_maniskill_stage25_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    if not isinstance(evidence, dict):
        raise Refused("R16-P18 Stage-2.5 evidence is missing")
    if not isinstance(submission, dict) or not isinstance(fault, dict):
        raise Refused("R16-P18 Stage-2.5 submission/fault contract is missing")
    if evidence.get("kind") != R16P18_MANISKILL_STAGE25_EVIDENCE_KIND:
        raise Refused("R16-P18 Stage-2.5 evidence kind is not authorized")
    if resolved.get("resource_alias") != "exp-efficiency-a800-2gpu":
        raise Refused("R16-P18 Stage-2.5 requires the verified 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R16-P18 Stage-2.5 network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R16-P18 Stage-2.5 worker must equal the verified preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(
        str(storage.get("output_root", ""))
    ) != R16P18_MANISKILL_STAGE25_OUTPUT_ROOT:
        raise Refused("R16-P18 Stage-2.5 output root drifted")

    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R16-P18 Stage-2.5 runtime fields drifted")
    if runtime.get("pod_env") != {}:
        raise Refused("R16-P18 Stage-2.5 public pod environment drifted")
    if runtime.get("secret_env_names") != []:
        raise Refused("R16-P18 Stage-2.5 forbids secret/W&B injection")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R16-P18 Stage-2.5 requires base64 payload transport")

    launcher_path = R16P18_MANISKILL_STAGE25_LAUNCHER
    try:
        canonical_launcher = launcher_path.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R16-P18 Stage-2.5 launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher_path
        or launcher_path.is_symlink()
        or not launcher_path.is_file()
        or not os.access(launcher_path, os.X_OK)
    ):
        raise Refused("R16-P18 Stage-2.5 launcher is not canonical/executable")
    launcher_sha = sha256(launcher_path)
    if launcher_sha != R16P18_MANISKILL_STAGE25_LAUNCHER_SHA256:
        raise Refused("R16-P18 Stage-2.5 launcher hash drifted")
    if runtime.get("command_file") != str(launcher_path):
        raise Refused("R16-P18 Stage-2.5 command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R16-P18 Stage-2.5 command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha:
        raise Refused("R16-P18 Stage-2.5 frozen payload hash drifted")
    if sha256_bytes(payload) != launcher_sha:
        raise Refused("R16-P18 Stage-2.5 decoded payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R16-P18 Stage-2.5 launcher must be UTF-8") from exc
    required_fragments = (
        f'"{R16P18_MANISKILL_STAGE25_SOURCE_COMMIT}"',
        f'"{R16P18_MANISKILL_STAGE25_SOURCE_TREE}"',
        'test "${gpu_count}" = "2"',
        "sha256sum -c manifests/SCIENTIFIC_SHA256SUMS",
        '--gpu-count "${gpu_count}"',
        "smoke_action_atlas_cuda.py",
        '"status"] == "CUDA_ACTION_ATLAS_SMOKE_PASS"',
        '"candidate_validity"] >= 0.90',
        "WANDB_MODE=disabled",
        "WANDB_DISABLED=true",
    )
    for fragment in required_fragments:
        if payload_text.count(fragment) != 1:
            raise Refused(
                f"R16-P18 Stage-2.5 payload binding drifted: {fragment}"
            )
    for forbidden in (
        "/mnt/cpfs/zbl-cpfs/",
        "/mnt/nas/",
        "WANDB_API_KEY",
        "--track",
        "__REPLACE_",
        "TO_BE_FILLED",
    ):
