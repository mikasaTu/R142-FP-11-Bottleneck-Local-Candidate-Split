        "launcher_sha256": launcher_sha,
        "formal_script_sha256": (
            "aa18cf0a57cfcdb6e3b8e9201577b94195b2315beff25441d48df72af82cba22"
        ),
        "preregistration_sha256": (
            "b8285a6956648b3342d33b9a4e4dab2c259ba7847755b3effb2a16797b5bafce"
        ),
