        "finalize-test-manifest",
        "train-shard",
    ):
        if payload_text.count(fragment) < 1:
            raise Refused(f"R22-P10 LIBERO Phase-2 payload binding drifted: {fragment}")
    if payload_text.index("finalize-test-manifest") > payload_text.index("train-shard"):
        raise Refused("R22-P10 LIBERO Phase-2 training precedes manifest freeze")

    expected_evidence = {
        "kind": R22P10_LIBERO_PHASE2_GATE_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "independent_manifest_collection_then_training_and_validation",
        "task_id": "r22p10-libero-phase2-learned-token-verifier-20260814",
        "model_id": "small-action-conditioned-verifier-three-seed",
        "success_gate": "persisted_preregistered_scientific_gate_result",
        "validation_method": "static+21_unit_integration_tests+real_libero_single_gpu_dev_smoke",
        "validation_status": "passed_no_pai_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "FIRST_TRAINING_METRIC.json"),
        "completed_evidence_path": str(artifact_dir / "PHASE2_GATE_COMPLETE.json"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": "4503a5058453c6aea2cf0d44d99b370bac1b648e",
        "source_tree": "8c6f0ce4714c3e1591912bba1aad7dc0a9e5e38f",
        "launcher_sha256": launcher_sha,
        "preregistration_commit": "02fd266",
        "libero_source_commit": "2319dbd914673f6ef34a00584536212b10e10395",
        "libero_source_tree": "521638a78b1fe3a0a33066ef8e0e9d9f5b247e71",
        "formal_python_sha256": "89b2f5166fb529c259aedd43e5f718c60e35d58e630cb40ae6accb48fc4f961a",
        "formal_torch": "2.5.1+cu124",
        "overlay_manifest_sha256": "64dfffdaf464d1a37be19b038cca919a252dba573eb2d0f8aa442b91a4099459",
        "overlay_file_count": 1688,
        "checkpoint_root": str(R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT),
        "train_failure_anchors": 150,
        "validation_failure_anchors": 30,
        "clean_training_anchors": 30,
        "independent_test_manifest_rows": 330,
        "model_seeds": [20260821, 20260822, 20260823],
        "neural_model_kinds": [
            "full",
            "state_only",
            "action_only",
            "action_shuffled",
            "token_position_only",
        ],
        "complete_state_resume": True,
        "application_resume_scope": (
            "per-model epoch-complete training_state.pt and task collection progress"
        ),
        "superseded_job_ids": ["dlc1r8mx3ek5w24l", "dlc1f166tm9aha19"],
        "superseded_job_terminal_status": "Failed",
        "superseded_target_count": 2,
        "resumed_from_job_id": "dlc1f166tm9aha19",
        "resumed_collection_snapshots": 330,
        "cleanup_required": False,
        "maximum_concurrent_gpus": 2,
        "test_repair_outcomes_before_gate": False,
        "wandb_mode": "online_exact_entity_one_run_per_model_seed_resume_same_lineage",
        "wandb_project": "r22p10-blame-token-phase2",
        "wandb_entity": "chen_jian-cj-workspace",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
    }
    if evidence != expected_evidence:
        raise Refused("R22-P10 LIBERO Phase-2 exact evidence contract drifted")
    if write_paths != [str(artifact_dir), str(R22P10_LIBERO_PHASE2_WORK_ROOT)]:
        raise Refused("R22-P10 LIBERO Phase-2 write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R22-P10 LIBERO Phase-2 replacement requires application resume")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P10 LIBERO Phase-2 forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R22-P10 LIBERO Phase-2 fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-evaluation",
        "task": "r22p10-libero-phase2-learned-token-verifier-20260814",
        "model": "small-action-conditioned-verifier-three-seed",
        "dataset": "libero-goal-three-task-phase1b-l1-locked",
