def validate_vlajepa_legacy_pick_between_tables_eval_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
    recursive_repair: Any,
    provenance: Dict[str, Any],
) -> None:
    evidence = resolved.get("evidence")
    if not isinstance(evidence, dict) or evidence.get("kind") != (
        VLAJEPA_LEGACY_PICK_BETWEEN_TABLES_EVAL_EVIDENCE_KIND
    ):
        raise Refused("legacy PickBetweenTables V-JEPA2.0 evidence contract is missing")

    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("legacy PickBetweenTables entrypoint must be UTF-8") from exc
    for marker in ("__REPLACE_", "__REQUIRES_", "REPLACE_ME"):
        if marker in payload_text:
            raise Refused(
                f"legacy PickBetweenTables entrypoint has unresolved marker: {marker}"
            )
    if re.search(r"(?:^|[;&|\s])exit\s+42(?:$|[;&|\s])", payload_text):
        raise Refused("legacy PickBetweenTables entrypoint must not reuse canary exit 42")

    launcher_info = toolchain_config.get(
        "vlajepa_legacy_pick_between_tables_vjepa20_eval_entry"
    )
    if not isinstance(launcher_info, dict):
        raise Refused("toolchain has no pinned legacy PickBetweenTables entrypoint")
    canonical_registry = USER_ROOT / "code" / "pai-job-registry"
    expected_entrypoint = canonical_registry / str(launcher_info.get("file", ""))
    if runtime.get("command_file") != str(expected_entrypoint):
        raise Refused("legacy PickBetweenTables command_file is not pinned")
    if runtime.get("payload_sha256") != launcher_info.get("sha256"):
        raise Refused("legacy PickBetweenTables payload hash is not pinned")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("legacy PickBetweenTables requires base64 payload transport")

    underlying_file = "vlajepa_legacy_baseline_step40000_eval.sh"
    underlying_sha = "b0c44591e2cc259a3f69cc4f676c8604ba782b32f0dc17e54374cff7fa2c35b9"
    for snippet in (
        underlying_file,
        f"EXPECTED_SHA256={underlying_sha}",
        'exec bash "$LAUNCHER" "$@"',
    ):
        if snippet not in payload_text:
            raise Refused(
                f"legacy PickBetweenTables entrypoint lacks contract text: {snippet}"
            )

    if output_mode != "resume":
        raise Refused("legacy PickBetweenTables requires output_mode=resume")
    if recursive_repair is not False:
        raise Refused("legacy PickBetweenTables forbids recursive ownership repair")
    if runtime.get("create_artifact_dir") is not True:
        raise Refused("legacy PickBetweenTables requires a registry artifact dir")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != []:
        raise Refused("legacy PickBetweenTables evaluation must not inject secrets")
    if runtime.get("wandb_entity_contract") is not None:
        raise Refused("legacy PickBetweenTables evaluation does not use W&B")
    expected_root_symlinks = [
        {
            "link": "/bdb1f316aa0188ec",
            "target": "/tmp/bdb1f316aa0188ec",
        }
    ]
    if normalize_root_symlinks(runtime.get("root_symlinks")) != expected_root_symlinks:
        raise Refused("legacy PickBetweenTables HSSD root symlink contract drifted")

    run_id = str(resolved.get("run_id", ""))
    if not re.fullmatch(
        r"vlajepa-legacy-pick-between-tables-vjepa20-eval-[a-z0-9-]+", run_id
    ):
        raise Refused("legacy PickBetweenTables run_id binding drifted")

    training_run_id = "simple_g1_locomotion_pick_v4"
    checkpoint = (
        CKPT_ROOT
        / "legacy_checkpoint_full"
        / "vlajepa"
        / training_run_id
        / "checkpoints"
        / "steps_40000_pytorch_model.pt"
    )
    deployment_contract = (
        canonical_registry
        / "contracts"
        / "vlajepa_legacy_pick_between_tables_vjepa20_step40000.json"
    )
    eval_root = CKPT_ROOT / "torch" / "vlajepa_legacy_baseline_eval" / "pick_between_tables"
    registry_output_root = (
        USER_ROOT / "logs" / "pai" / "vlajepa_legacy_baseline_eval" / "pick_between_tables"
    )
    if artifact_dir.parent != registry_output_root:
        raise Refused("legacy PickBetweenTables registry artifact root drifted")
    if write_paths != [str(artifact_dir), str(eval_root)]:
        raise Refused("legacy PickBetweenTables write paths drifted")

    run_prefix_glob = (
        "simple_g1_locomotion_pick_v4_step40000_q99_h7_1gpu4090_"
        "eval_level0-2_10rollouts_v2_*"
    )
    exact_evidence = {
        "kind": VLAJEPA_LEGACY_PICK_BETWEEN_TABLES_EVAL_EVIDENCE_KIND,
        "contract_ready": True,
        "task_id": "G1WholebodyLocomotionPickBetweenTablesTeleop-v0",
        "task_uid": "g1_wholebody_locomotion_pick_between_tables_teleop",
        "task_family": "legacy_pick_between_tables",
        "training_run_id": training_run_id,
        "checkpoint_step": 40000,
        "checkpoint_path": str(checkpoint),
        "checkpoint_sha256": "14f22354ff922dd112f05082a005cb3e2a60c17ad303c21debb4531295f8763e",
        "deployment_contract_path": str(deployment_contract),
