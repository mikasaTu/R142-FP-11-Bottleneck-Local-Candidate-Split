        "priority": 9, "disable_ecs_stock_check": False,
        "job_reserved_policy": "", "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0, "tags": expected_tags,
    }:
        raise Refused("R22-P21 selector-v2 SmolVLA submission contract drifted")
    if provenance.get("contract_source_job_id") != resolved["resource"].get(
        "contract_source_job_id"
    ) or provenance.get("resource_source_job_id") != resolved["resource"].get("source_job_id"):
        raise Refused("R22-P21 selector-v2 SmolVLA live source bindings drifted")


def validate_r22p21_selector_v2_act_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    provenance = resolved.get("provenance")
    if not all(
        isinstance(value, dict)
        for value in (evidence, submission, fault, provenance)
    ):
        raise Refused("R22-P21 selector-v2 ACT contract sections are missing")
    kind = evidence.get("kind")
    if kind not in {
        R22P21_SELECTOR_V2_ACT_TRAIN_EVIDENCE_KIND,
        R22P21_SELECTOR_V2_ACT_EVAL_EVIDENCE_KIND,
    }:
        raise Refused("R22-P21 selector-v2 ACT evidence kind is not authorized")
    is_train = kind == R22P21_SELECTOR_V2_ACT_TRAIN_EVIDENCE_KIND
    expected_alias = (
        R22P21_SELECTOR_V2_TINY_RESOURCE_ALIAS
        if is_train
        else R22P21_SELECTOR_V2_ACT_EVAL_RESOURCE_ALIAS
    )
    if resolved.get("resource_alias") != expected_alias:
        raise Refused("R22-P21 selector-v2 ACT requires the verified dedicated alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P21 selector-v2 ACT network must be source-derived empty")
    expected_worker = {
        "count": 1 if is_train else 2,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2 if is_train else 1,
        "cpu": 12 if is_train else 6,
        "memory": "200Gi" if is_train else "100Gi",
        "shared_memory": "200Gi" if is_train else "100Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R22-P21 selector-v2 ACT worker drifted")
    launcher = (
        R22P21_SELECTOR_V2_ACT_TRAIN_LAUNCHER
        if is_train
        else R22P21_SELECTOR_V2_ACT_EVAL_LAUNCHER
    )
    launcher_sha = (
        R22P21_SELECTOR_V2_ACT_TRAIN_LAUNCHER_SHA256
        if is_train
        else R22P21_SELECTOR_V2_ACT_EVAL_LAUNCHER_SHA256
    )
    output_root = (
        R22P21_SELECTOR_V2_ACT_TRAIN_OUTPUT_ROOT
        if is_train
        else R22P21_SELECTOR_V2_ACT_EVAL_OUTPUT_ROOT
    )
    source_commit = (
        R22P21_SELECTOR_V2_ACT_TRAIN_SOURCE_COMMIT
        if is_train
        else R22P21_SELECTOR_V2_ACT_EVAL_SOURCE_COMMIT
    )
    source_tree = (
        R22P21_SELECTOR_V2_ACT_TRAIN_SOURCE_TREE
        if is_train
        else R22P21_SELECTOR_V2_ACT_EVAL_SOURCE_TREE
    )
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(str(storage.get("output_root", ""))) != output_root:
        raise Refused("R22-P21 selector-v2 ACT registry output root drifted")
    expected_runtime_fields = {
        "canary_nonce",
        "command",
        "command_file",
        "command_file_sha256",
        "create_artifact_dir",
        "gid",
        "identity_mechanism",
        "output_mode",
        "payload_base64",
        "payload_sha256",
        "payload_transport",
        "pod_env",
        "recursive_repair",
        "secret_env_names",
        "uid",
        "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R22-P21 selector-v2 ACT runtime fields drifted")
    if runtime.get("pod_env") != {
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics"
    }:
        raise Refused("R22-P21 selector-v2 ACT pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY",
        "WANDB_ENTITY",
    ]:
        raise Refused("R22-P21 selector-v2 ACT requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R22-P21 selector-v2 ACT W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P21 selector-v2 ACT requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R22-P21 selector-v2 ACT identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R22-P21 selector-v2 ACT identity mechanism drifted")
    try:
        canonical_launcher = launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P21 selector-v2 ACT launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher
        or launcher.is_symlink()
        or not launcher.is_file()
        or not os.access(launcher, os.X_OK)
        or sha256(launcher) != launcher_sha
    ):
        raise Refused("R22-P21 selector-v2 ACT launcher contract drifted")
    if runtime.get("command_file") != str(launcher):
        raise Refused("R22-P21 selector-v2 ACT command_file is not pinned")
    if runtime.get("command_file_sha256") != launcher_sha:
        raise Refused("R22-P21 selector-v2 ACT command_file hash drifted")
    if runtime.get("payload_sha256") != launcher_sha or sha256_bytes(payload) != launcher_sha:
        raise Refused("R22-P21 selector-v2 ACT payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P21 selector-v2 ACT launcher must be UTF-8") from exc
    common_fragments = (
        "PREREGISTRATION_COMMIT=f2e0b59",
        (
            'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2'
            if is_train
            else 'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 1'
        ),
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
        "/mnt/cpfs/zbl-cpfs-new/USERS/leon/envs/libero_sft/bin/python",
        "41001",
        "41002",
        "41003",
    )
    specific_fragments = (
        (
            "r22p21.selector_v2_act",
            "train_seed 41001 0 &",
            "train_seed 41002 1 &",
            "train_seed 41003 0",
            "f37072fd47e89c5e827621c5baffa7500819f7896bbacec160b1a16c560e07ec",
            "ACT_TRAIN_PHASE_COMPLETE.json",
        )
        if is_train
        else (
            "r22p21.selector_v2_act_pipeline",
            "r22p21-selector-v2-act-temporal-repair-20260815",
            "R22P21_SELECTOR_COMPATIBLE_STAGE_COMMITS=d47339c77082f3d6f804e77d3d89b766bc3a5b80,7a8bf26a119482d72cd173d541a015771f7a906e",
            "WORKER_RANK=${RANK:?RANK is required for the two-worker PAI job}",
            'test "${WORLD_SIZE:-}" = 2',
            "CUDA_VISIBLE_DEVICES=0",
            "MUJOCO_EGL_DEVICE_ID=0 EGL_DEVICE_ID=0",
            'seed_cache="$CACHE_ROOT/seed-${1}"',
            "--device cuda:0",
            "run_seed 41001",
            "run_seed 41002",
            "run_seed 41003",
            "ACT_EVAL_WORKER_1_COMPLETE.json",
            "total_rows == 5760",
            "summarize_selector_v2_act.py",
            "--bootstrap-replicates 5000 --permutations 10000",
            "ACT_EVAL_PHASE_COMPLETE.json",
        )
    )
    for fragment in (*common_fragments, *specific_fragments):
        if fragment not in payload_text:
            raise Refused(
                f"R22-P21 selector-v2 ACT payload binding drifted: {fragment}"
            )
    common_evidence = {
        "kind": kind,
        "resource_contract": (
            "dedicated_2gpu_v1" if is_train else "dedicated_2x1gpu_v1"
        ),
        "pai_probe_created": False,
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": source_commit,
        "source_tree": source_tree,
        "launcher_sha256": launcher_sha,
        "preregistration_commit": "f2e0b59",
        "preregistration_sha256": (
            "ff5398b418db4600e15dc1ce3144360234f51538a859707f03ceb662ae703b48"
        ),
        "act_config_file_sha256": (
            "8b0d3379d01df817c9c794b5d7c7b6a6b56699826b62a808aa08ae6c8ad65e6b"
            if is_train
            else "4a4b731a97f00c96809f701390cf35c8b13f901c438e4085bc6ac7bccbc8c460"
        ),
        "act_config_resolved_sha256": (
            "6d854e52fd39a8825164974f1078f99001d2364bb81031ab4ca50c96af454501"
            if is_train
            else "6e3539ce388a32db18f06c50ee0d1f37db90bff40aabf40f46f39db3511f349b"
        ),
        "policy_config_sha256": (
            "294f0b6da1cb4b0eb55b6c81882b7951b030e892a44431527d5b07d1a016429b"
        ),
        "pretrained_visual_weights_sha256": (
            "f37072fd47e89c5e827621c5baffa7500819f7896bbacec160b1a16c560e07ec"
        ),
        "model_seeds": [41001, 41002, 41003],
        "maximum_concurrent_gpus": 2,
        "gpus_per_process": 1,
        "history_frames": 4,
        "bottleneck_dim": 128,
        "complete_all_phases_despite_gate_failure": True,
        "scientific_gate_short_circuit": False,
        "wandb_entity": "chen_jian-cj-workspace",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "cleanup_required": False,
    }
    if is_train:
        expected_evidence = {
            **common_evidence,
            "workload_type": "act_smoke_contract_then_three_seed_finetune",
            "task_id": "r22p21-selector-v2-act-train-20260814",
            "model_id": "language-conditioned-act-fallback-three-seeds",
            "success_gate": "smoke_history_bottleneck_action_then_three_complete_checkpoints",
            "validation_method": "static+unit+one_gpu_dev_optimizer_smoke_no_pai_probe",
            "validation_status": "passed_no_pai_probe",
            "first_work_evidence_path": str(artifact_dir / "FIRST_REAL_WORK.json"),
            "completed_evidence_path": str(
                artifact_dir / "ACT_TRAIN_PHASE_COMPLETE.json"
            ),
            "formal_torch": "2.5.1+cu124",
            "application_resume_scope": "complete_model_optimizer_scheduler_rng_global_step",
            "wandb_mode": "online_exact_entity_one_run_per_model_seed_resume_same_lineage",
            "wandb_project": "r22p21-selector-v2-act-fallback",
        }
        expected_write_paths = [
            str(artifact_dir),
            "/mnt/cpfs/zbl-cpfs-new/CKPT/leon/torch/r22p21_selector_v2/act-fallback-smoke-v1",
            "/mnt/cpfs/zbl-cpfs-new/CKPT/leon/torch/r22p21_selector_v2/act-fallback-formal-v1",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/logs/r22p21_selector_v2/act-train-v1",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/cache/r22p21_selector_v2/act-v1",
        ]
        expected_tags = {
            "managed_by": "pai-job-registry",
            "purpose": "formal-training-evaluation",
            "task": "r22p21-selector-v2-act-train-20260814",
            "model": "language-conditioned-act-fallback",
            "dataset": "r22p21-libero-hdf5-12000",
            "hardware": "2xa800-dedicated",
            "resource_pool": "exp-efficiency",
            "experiment_role": "selector-v2-competent-host-fallback-training",
        }
    else:
        expected_evidence = {
            **common_evidence,
            "workload_type": "act_teacher_selector_operator_physical_closed_loop",
            "task_id": "r22p21-selector-v2-act-eval-20260814",
            "model_id": "three-act-host-seeds-three-selector-seeds",
            "success_gate": "all_stages_and_exact_5760_closed_loop_rows_complete",
            "validation_method": "static+unit+real_simulator_8branch_clock_native_action_clock_rollout_history_clock_and_paired_history_clock_smokes_no_pai_probe",
            "validation_status": "passed_no_pai_probe",
            "first_work_evidence_path": str(artifact_dir / "FIRST_REAL_WORK.json"),
            "completed_evidence_path": str(
                artifact_dir / "ACT_EVAL_PHASE_COMPLETE.json"
            ),
            "formal_torch": "2.5.1+cu124",
            "selector_seeds": [31001, 31002, 31003],
            "closed_loop_rows": 5760,
            "paired_history_sample_stride": 4,
            "paired_states_on_policy_sample_clock": True,
            "application_resume_scope": "stage_markers_selector_epochs_pair_rows_closed_loop_episode_sets",
            "compatible_preclosed_loop_stage_source_commits": [
                "d47339c77082f3d6f804e77d3d89b766bc3a5b80",
                "7a8bf26a119482d72cd173d541a015771f7a906e",
            ],
            "runtime_repair": "restore_per_branch_episode_clock_execute_native_20hz_action_targets_once_retain_rollout_and_paired_probe_histories_at_frozen_four_simulator_step_training_stride_isolate_gpu_runtime_namespaces_route_rendering_through_verified_egl0",
            "execution_topology": "two_worker_pods_one_a800_and_one_egl0_renderer_per_pod_rank0_seeds_41001_41003_rank1_seed_41002",
            "wandb_mode": "credentials_present_no_training_run_created_by_eval_payload",
        }
        expected_write_paths = [
            str(artifact_dir),
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/logs/r22p21_selector_v2/formal-act-v2-history-paired",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/logs/r22p21_selector_v2/act-eval-v2-history-paired",
            "/mnt/cpfs/zbl-cpfs-new/USERS/leon/cache/r22p21_selector_v2/act-eval-v2-history-paired",
        ]
        expected_tags = {
            "managed_by": "pai-job-registry",
            "purpose": "formal-training-evaluation",
            "task": "r22p21-selector-v2-act-eval-20260814",
            "model": "act-state-conditioned-mediator-selector",
            "dataset": "r22p21-libero-hdf5-12000",
            "hardware": "2x1xa800-dedicated-workers",
            "resource_pool": "exp-efficiency",
            "experiment_role": "selector-v2-fallback-operator-closed-loop-validation",
        }
    if evidence != expected_evidence:
        differing = sorted(
            key
            for key in set(evidence) | set(expected_evidence)
            if evidence.get(key) != expected_evidence.get(key)
        )
        raise Refused(f"R22-P21 selector-v2 ACT evidence drifted: {differing}")
    if write_paths != expected_write_paths:
        raise Refused("R22-P21 selector-v2 ACT write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R22-P21 selector-v2 ACT requires application resume")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P21 selector-v2 ACT forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "",
        "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0,
        "launcher_attempts": 1,
        "retry_sleep_seconds": 30,
        "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R22-P21 selector-v2 ACT fault-tolerance contract drifted")
    if submission != {
        "priority": 9,
        "disable_ecs_stock_check": False,
        "job_reserved_policy": "",
        "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0,
        "tags": expected_tags,
    }:
        raise Refused("R22-P21 selector-v2 ACT submission contract drifted")
    if provenance.get("contract_source_job_id") != resolved["resource"].get(
        "contract_source_job_id"
    ) or provenance.get("resource_source_job_id") != resolved["resource"].get(
        "source_job_id"
    ):
        raise Refused("R22-P21 selector-v2 ACT live source bindings drifted")


def validate_r22p21_selector_v2_tiny_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    provenance = resolved.get("provenance")
    if not all(isinstance(value, dict) for value in (evidence, submission, fault, provenance)):
        raise Refused("R22-P21 selector-v2 Tiny contract sections are missing")
    if evidence.get("kind") != R22P21_SELECTOR_V2_TINY_EVIDENCE_KIND:
        raise Refused("R22-P21 selector-v2 Tiny evidence kind is not authorized")
    if resolved.get("resource_alias") != R22P21_SELECTOR_V2_TINY_RESOURCE_ALIAS:
        raise Refused("R22-P21 selector-v2 Tiny requires the verified dedicated 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P21 selector-v2 Tiny network must be source-derived empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
        "gpu": 2,
        "cpu": 12,
        "memory": "200Gi",
        "shared_memory": "200Gi",
    }
    if resolved.get("worker") != expected_worker:
        raise Refused("R22-P21 selector-v2 Tiny worker drifted from the live 2-GPU preset")
    storage = resolved.get("storage")
    if not isinstance(storage, dict) or Path(str(storage.get("output_root", ""))) != (
        R22P21_SELECTOR_V2_TINY_OUTPUT_ROOT
    ):
        raise Refused("R22-P21 selector-v2 Tiny registry output root drifted")
    expected_runtime_fields = {
        "canary_nonce", "command", "command_file", "command_file_sha256",
        "create_artifact_dir", "gid", "identity_mechanism", "output_mode",
        "payload_base64", "payload_sha256", "payload_transport", "pod_env",
        "recursive_repair", "secret_env_names", "uid", "wandb_entity_contract",
        "write_paths",
    }
    if set(runtime) != expected_runtime_fields:
        raise Refused("R22-P21 selector-v2 Tiny runtime fields drifted")
    expected_pod_env = {
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics",
    }
    if runtime.get("pod_env") != expected_pod_env:
        raise Refused("R22-P21 selector-v2 Tiny public pod environment drifted")
    if normalize_secret_env_names(runtime.get("secret_env_names")) != [
        "WANDB_API_KEY", "WANDB_ENTITY"
    ]:
        raise Refused("R22-P21 selector-v2 Tiny requires the exact W&B secret pair")
    if runtime.get("wandb_entity_contract") != expected_wandb_entity_contract():
        raise Refused("R22-P21 selector-v2 Tiny W&B entity contract drifted")
    if runtime.get("payload_transport") != PAYLOAD_TRANSPORT_BASE64:
        raise Refused("R22-P21 selector-v2 Tiny requires base64 payload transport")
    if runtime.get("uid") != 2254 or runtime.get("gid") != 2254:
        raise Refused("R22-P21 selector-v2 Tiny identity must be 2254:2254")
    if runtime.get("identity_mechanism") != "controller_inline_bootstrap_then_setpriv":
        raise Refused("R22-P21 selector-v2 Tiny identity mechanism drifted")

    launcher = R22P21_SELECTOR_V2_TINY_LAUNCHER
    try:
        canonical_launcher = launcher.resolve(strict=True)
    except OSError as exc:
        raise Refused(f"R22-P21 selector-v2 Tiny launcher is missing: {exc}") from exc
    if (
        canonical_launcher != launcher
        or launcher.is_symlink()
        or not launcher.is_file()
        or not os.access(launcher, os.X_OK)
        or sha256(launcher) != R22P21_SELECTOR_V2_TINY_LAUNCHER_SHA256
    ):
        raise Refused("R22-P21 selector-v2 Tiny launcher hash or file contract drifted")
    if runtime.get("command_file") != str(launcher):
        raise Refused("R22-P21 selector-v2 Tiny command_file is not pinned")
    if runtime.get("command_file_sha256") != R22P21_SELECTOR_V2_TINY_LAUNCHER_SHA256:
        raise Refused("R22-P21 selector-v2 Tiny command_file hash drifted")
    if (
        runtime.get("payload_sha256") != R22P21_SELECTOR_V2_TINY_LAUNCHER_SHA256
        or sha256_bytes(payload) != R22P21_SELECTOR_V2_TINY_LAUNCHER_SHA256
    ):
        raise Refused("R22-P21 selector-v2 Tiny payload hash drifted")
    try:
        payload_text = payload.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Refused("R22-P21 selector-v2 Tiny launcher must be UTF-8") from exc
    fragments = (
        "PREREGISTRATION_COMMIT=f2e0b59",
        'test "${PAI_CANARY_EXPECTED_GPUS:-}" = 2',
        'test "${WANDB_ENTITY:-}" = chen_jian-cj-workspace',
        "run_seed 22021 0",
        "run_seed 22022 1",
        "run_seed 22023 0",
        "--through physical",
        "r22p21.selector_v2_finalize",
        "TINY_PHASE_COMPLETE.json",
    )
    for fragment in fragments:
        if payload_text.count(fragment) < 1:
            raise Refused(f"R22-P21 selector-v2 Tiny payload binding drifted: {fragment}")

    expected_evidence = {
        "kind": R22P21_SELECTOR_V2_TINY_EVIDENCE_KIND,
        "resource_contract": "dedicated_2gpu_v1",
        "workload_type": "full_tiny_selector_operator_physical_validation",
        "task_id": "r22p21-selector-v2-tiny-20260814",
        "model_id": "tinylangbc-three-policy-seeds-three-selector-seeds",
        "success_gate": "persisted_all_phases_complete_without_gate_short_circuit",
        "validation_method": "static+unit+stratified_gpu_smoke_no_pai_probe",
        "validation_status": "passed_no_pai_probe",
        "pai_probe_created": False,
        "first_work_evidence_path": str(artifact_dir / "FIRST_REAL_WORK.json"),
        "completed_evidence_path": str(artifact_dir / "TINY_PHASE_COMPLETE.json"),
        "contract_ready": True,
        "mount_contract": "exact_five_new_root_sources_from_live_readback",
        "source_commit": R22P21_SELECTOR_V2_TINY_SOURCE_COMMIT,
        "source_tree": R22P21_SELECTOR_V2_TINY_SOURCE_TREE,
        "launcher_sha256": R22P21_SELECTOR_V2_TINY_LAUNCHER_SHA256,
        "preregistration_commit": "f2e0b59",
        "preregistration_sha256": "ff5398b418db4600e15dc1ce3144360234f51538a859707f03ceb662ae703b48",
        "resolved_config_sha256": "d96c532fb9cc9c064f28d2a17b496f1f28563a79c557c3726c84c2da2b84d732",
        "formal_torch": "2.5.1+cu124",
        "policy_seeds": [22021, 22022, 22023],
        "selector_seeds": [31001, 31002, 31003],
        "maximum_concurrent_gpus": 2,
        "gpus_per_process": 1,
        "complete_all_phases_despite_gate_failure": True,
        "application_resume_scope": "stage_markers_plus_selector_epoch10_checkpoints",
        "scientific_gate_short_circuit": False,
        "wandb_mode": "online_exact_entity_one_run_per_policy_seed_resume_same_lineage",
        "wandb_project": "r22p21-selector-v2",
        "wandb_entity": "chen_jian-cj-workspace",
        "expected_first_work_uid": 2254,
        "expected_first_work_gid": 2254,
        "superseded_job_ids": ["dlc1lba80a8tw4lj"],
        "superseded_job_terminal_status": "Failed",
        "superseded_target_count": 1,
        "resumed_from_job_id": "dlc1lba80a8tw4lj",
        "resumed_completed_policy_seeds": [22021],
        "cleanup_required": True,
    }
    if evidence != expected_evidence:
        differing = sorted(
            key for key in set(evidence) | set(expected_evidence)
            if evidence.get(key) != expected_evidence.get(key)
        )
        raise Refused(f"R22-P21 selector-v2 Tiny evidence drifted: {differing}")
    if write_paths != [str(artifact_dir), str(R22P21_SELECTOR_V2_TINY_WORK_ROOT)]:
        raise Refused("R22-P21 selector-v2 Tiny write paths drifted")
    if output_mode != "resume" or runtime.get("create_artifact_dir") is not True:
        raise Refused("R22-P21 selector-v2 Tiny requires application resume")
    if runtime.get("recursive_repair") is not False:
        raise Refused("R22-P21 selector-v2 Tiny forbids recursive ownership repair")
    if fault != {
        "aimaster_args": "", "maximum_platform_restarts": 0,
        "expected_platform_restarts": 0, "launcher_attempts": 1,
        "retry_sleep_seconds": 30, "pai_automatic_fault_tolerance": False,
    }:
        raise Refused("R22-P21 selector-v2 Tiny fault-tolerance contract drifted")
    expected_tags = {
        "managed_by": "pai-job-registry",
        "purpose": "formal-training-evaluation",
        "task": "r22p21-selector-v2-tiny-20260814",
        "model": "state-conditioned-mediator-selector",
        "dataset": "r22p21-libero-synthetic-12000",
        "hardware": "2xa800-dedicated",
        "resource_pool": "exp-efficiency",
        "experiment_role": "selector-v2-full-small-policy",
    }
    if submission != {
        "priority": 9, "disable_ecs_stock_check": False,
        "job_reserved_policy": "", "job_reserved_minutes": 0,
        "job_max_running_time_minutes": 0, "tags": expected_tags,
    }:
        raise Refused("R22-P21 selector-v2 Tiny submission contract drifted")
    if provenance.get("contract_source_job_id") != resolved["resource"].get(
        "contract_source_job_id"
    ) or provenance.get("resource_source_job_id") != resolved["resource"].get("source_job_id"):
        raise Refused("R22-P21 selector-v2 Tiny live source bindings drifted")


def validate_r22p21_selector_v2_lono_repair_profile(
    *,
    resolved: Dict[str, Any],
    toolchain_config: Dict[str, Any],
    runtime: Dict[str, Any],
    payload: bytes,
    write_paths: List[str],
    artifact_dir: Path,
    output_mode: Any,
) -> None:
    del toolchain_config
    evidence = resolved.get("evidence")
    submission = resolved.get("submission")
    fault = resolved.get("fault_tolerance")
    provenance = resolved.get("provenance")
    if not all(isinstance(value, dict) for value in (evidence, submission, fault, provenance)):
        raise Refused("R22-P21 selector-v2 LONO repair contract sections are missing")
    if evidence.get("kind") != R22P21_SELECTOR_V2_LONO_REPAIR_EVIDENCE_KIND:
        raise Refused("R22-P21 selector-v2 LONO repair evidence kind is not authorized")
    if resolved.get("resource_alias") != R22P21_SELECTOR_V2_TINY_RESOURCE_ALIAS:
        raise Refused("R22-P21 selector-v2 LONO repair requires the dedicated 2-GPU alias")
    if resolved.get("network") != {}:
        raise Refused("R22-P21 selector-v2 LONO repair network must remain empty")
    expected_worker = {
        "count": 1,
        "image": (
            "dsw-registry-vpc.cn-wulanchabu.cr.aliyuncs.com/pai/"
            "modelscope:1.29.0-pytorch2.3.1tensorflow2.16.1-gpu-"
            "py311-cu121-ubuntu22.04"
        ),
