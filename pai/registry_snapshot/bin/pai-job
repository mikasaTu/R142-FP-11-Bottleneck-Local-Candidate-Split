        "checkpoint_root": str(R22P10_LIBERO_PHASE1_CHECKPOINT_ROOT),
        "repository_tests_passed": 38,
        "real_candidate_rows_roundtrip_verified": 5490,
        "upstream_fold_trajectories": 120,
        "upstream_final_models": 21,
        "upstream_stage_a_sha256": "3205345af762f00b3a8ba7a29f0517acb9a7debc8e445018895606690ac16cc5",
